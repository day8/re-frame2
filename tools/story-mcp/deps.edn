;; day8/re-frame2-story-mcp — MCP (Model Context Protocol) agent surface
;; for re-frame2-story.
;;
;; Per tools/story/spec/006-MCP-Surface.md the agent surface ships as a separate
;; artefact from `day8/re-frame2-story` so the MCP server can be loaded
;; without dragging the entire Story UI / authoring macro substrate into
;; the classpath, and so consumers of Story-the-tool need not pull in
;; stdio / JSON-RPC dependencies they don't use.
;;
;; ## Bundle isolation
;;
;; Per `tools/README.md` the dependency arrow flows tool → implementation
;; (and never the reverse). This artefact depends on `tools/story/`
;; (`:local/root "../story"`) which in turn depends on `implementation/`.
;; Nothing under `implementation/` may `:require` anything from this
;; artefact; nothing in production CLJS bundles may either.
;;
;; ## JVM-only
;;
;; Story-MCP is JVM-side: its job is to terminate the agent host's stdio
;; channel and expose `tools/story/`'s public surface over JSON-RPC. Tool
;; handlers call Story in this JVM; there is no JVM-to-browser or nREPL
;; bridge in this artefact. Consequently CLJS-only registries and panel
;; state are unavailable to the stdio server and degrade explicitly to a
;; machine-readable capability-unavailable error — never a false-empty
;; success, which would read as "the provider looked and found nothing".
;;
;; ## Release
;;
;; Ships on Story's `story-v*` tag alongside `day8/re-frame2-story`
;; and `day8/re-frame2-mcp-base` — one glob for the shipping pair so the
;; three cannot skew. Story and mcp-base deploy AHEAD of it
;; on that tag; the release workflow swaps `:local/root` →
;; `:mvn/version` before invoking clein, identical to the adapter jars.
;;
;; Structural dedup arrives with mcp-base (the codec lives in
;; `re-frame.mcp-base.dedup`), so every runtime coordinate of this
;; artefact is one a pom can express. A `:git/url` runtime coordinate
;; would be dropped silently by `clein pom`, and a jar cut from this
;; deps.edn would publish a pom missing it, with no yank to undo that.
{:paths ["src"]
 :deps  {;; Story is the agent surface's read substrate. Every MCP
         ;; tool routes through `re-frame.story`'s public query API
         ;; (`handlers`, `handler-meta`, `run-variant`, `variant->edn`,
         ;; `snapshot-identity`, …) — see spec/002-Tool-Registry.md.
         day8/re-frame2-story {:local/root "../story"}

         ;; Shared MCP primitives across the pair (re-frame2-pair-mcp,
         ;; story-mcp): wire vocabulary, the Spec 009
         ;; default-suppress filter, the path-keyed diff-encode, and
         ;; the overflow-marker shape.
         day8/re-frame2-mcp-base {:local/root "../mcp-base"}

         ;; JSON wire format. Cheshire is the project's JSON
         ;; library (implementation/http uses it via requiring-resolve);
         ;; we declare it as a direct runtime dep here because every
         ;; JSON-RPC frame round-trips through it.
         cheshire/cheshire    {:mvn/version "5.12.0"}}

 :aliases
 {:test {:extra-paths ["test"
                       ;; The login_form Story testbed, for
                       ;; `re-frame.story-mcp.login-form-testbed-test` only:
                       ;; it pins that story-mcp holds the
                       ;; tutorial's flagship subject on the JVM. Test-only;
                       ;; the published jar carries no testbed.
                       "../story/testbeds"]
         :extra-deps  {day8/re-frame2-schemas {:local/root "../../implementation/schemas"}
                       ;; Silent-on-success test reporter.
                       day8/re-frame2-test-quiet {:local/root "../../implementation/test-quiet"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "re-frame.test-quiet.runner"]}

  ;; Descriptor-manifest generator + drift-check. Reads the
  ;; live tool registry and emits / --check's the committed
  ;; tool-descriptors.edn via the shared
  ;; `re-frame.mcp-base.descriptor-manifest` serialiser. Needs schemas on
  ;; the classpath for the same reason :test does — the registry's tool
  ;; namespaces transitively require `re-frame.schemas`.
  :gen {:extra-deps {day8/re-frame2-schemas {:local/root "../../implementation/schemas"}}
        :main-opts  ["-m" "re-frame.story-mcp.descriptor-manifest-gen"]}

  ;; Clojars deploy. Mirrors tools/story/deps.edn — the release workflow
  ;; rewrites :local/root → :mvn/version before invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-story-mcp
   :main     re-frame.story-mcp.server
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
