  {:name "list-assertions" :description "List the assertion vocabulary: `:canonical`, the documented `:rf.assert/*` declarations with each one's payload and semantics (never paginated), and `:registered`, every assertion id the plan compiler accepts (paginated with `:limit` and `:cursor`). The DOM, visual and a11y ids need a browser runner, so a headless run reports them `:cannot-run`, never a pass. Example: {} -> {:canonical [{:id :rf.assert/path-equals :payload \"[path expected]\" :semantics \"(= (get-in @app-db path) expected)\"} ...] :registered [:rf.assert/a11y :rf.assert/caused ...]}." :input-keys ["cursor" "limit" "max-tokens"] :gated-input-keys [] :required [] :output? true :annotations ["idempotentHint" "openWorldHint" "readOnlyHint"] :typicalTokens 500}
