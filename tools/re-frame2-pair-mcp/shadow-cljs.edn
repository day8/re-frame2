;; Classpath and source paths come from deps.edn. The server build is the
;; shipped Node script; server-test and descriptor-gen are build-time only.
{:deps true
 :builds {:server      {:target :node-script
                        :output-to "out/server.js"
                        :main re-frame2-pair-mcp.server/main
                        ;; Production omits the development-only Malli
                        ;; validation walk over diff-encoded patches.
                        :compiler-options
                        {:optimizations  :simple
                         :closure-defines
                         {re-frame.mcp-base.diff-encode/validate-patches? false}}}
          :server-test {:target :node-test
                        :output-to "out/server-test.js"
                        :ns-regexp "-test$"
                        :autorun true
                        :main re-frame.test-quiet.shadow-node/main}
          ;; The registry is CLJS-only, so descriptor drift checks compile
          ;; this unshipped Node helper before reading the catalogue.
          :descriptor-gen {:target :node-script
                           :output-to "out/descriptor-gen.js"
                           :main re-frame2-pair-mcp.descriptor-manifest-gen/-main}}}
