;; shadow-cljs resolves this npm artefact's CLJS classpath from deps.edn.
;; `npm test` is the canonical test command; `:test` exposes the same
;; node-test build to Clojure CLI and editor tooling.
{:paths ["src" "test"]
 :deps  {org.clojure/clojure       {:mvn/version "1.12.0"}
         org.clojure/clojurescript {:mvn/version "1.12.145"}
         applied-science/js-interop {:mvn/version "0.4.2"}
         thheller/shadow-cljs      {:mvn/version "3.4.10"}

         ;; Wire vocabulary and boundary primitives shared with story-mcp.
         day8/re-frame2-mcp-base  {:local/root "../mcp-base"}

         ;; The server uses the pure source-coordinate URI helper; consumer
         ;; runtime code is supplied by the Pair preload, not this bundle.
         day8/re-frame2           {:local/root "../../implementation/core"}

         ;; Pair and Story pin the same CLJC dedup implementation so their
         ;; wire encodings cannot drift.
         day8/de-dupe              {:git/url "https://github.com/day8/de-dupe.git"
                                    :git/tag "v0.3.0"
                                    :git/sha "367de784faf13c710a895bed867f36a36e594a2a"}
         ;; Test reporter required by the server-test entry point only.
         day8/re-frame2-test-quiet {:local/root "../../implementation/test-quiet"}}

 :aliases
 {:test {:extra-paths ["test"]
         :main-opts   ["-m" "shadow.cljs.devtools.cli" "compile" "server-test"]}}}
