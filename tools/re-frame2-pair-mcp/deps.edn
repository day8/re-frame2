;; shadow-cljs resolves this npm artefact's CLJS classpath from deps.edn.
;; `npm test` is the canonical -- and only -- test command here; see the
;; :aliases comment for why `clojure -M:test` deliberately refuses.
{:paths ["src" "test"]
 :deps  {org.clojure/clojure       {:mvn/version "1.12.0"}
         org.clojure/clojurescript {:mvn/version "1.12.145"}
         applied-science/js-interop {:mvn/version "0.4.2"}
         thheller/shadow-cljs      {:mvn/version "3.4.10"}

         ;; Wire vocabulary and boundary primitives shared with story-mcp.
         day8/re-frame2-mcp-base  {:local/root "../mcp-base"}

         ;; The server uses the pure source-coordinate URI helper; consumer
         ;; runtime code is supplied by the Pair preload, not this bundle.
         day8/re-frame2           {:local/root "../../implementation/core"}

         ;; Pair and Story share ONE dedup implementation so their wire
         ;; encodings cannot drift — it lives in mcp-base above
         ;; (`re-frame.mcp-base.dedup`), vendored there from
         ;; `day8/de-dupe` rather than pinned as a git coordinate
         ;; `clein pom` cannot express.

         ;; Test reporter required by the server-test entry point only.
         day8/re-frame2-test-quiet {:local/root "../../implementation/test-quiet"}}

 :aliases
 ;; `npm test` is the ONLY verdict for this artefact: it compiles the
 ;; `:server-test` build AND runs `node out/server-test.js`, and the npm
 ;; script's exit status is Node's. Every test here is CLJS on that build
 ;; (`shadow-cljs.edn`); there is no JVM suite and so no JVM lane.
 ;;
 ;; A compile is NOT a verdict here, so this alias does not run
 ;; `["-m" "shadow.cljs.devtools.cli" "compile" "server-test"]`: that
 ;; would FAIL OPEN. The `:server-test` build sets `:autorun true`, so the
 ;; compile runs the suite and prints its failures -- then exits 0 anyway,
 ;; because the COMPILE succeeded, which is the whole of what a compile
 ;; exit code claims. Over one build, `shadow-cljs compile server-test`
 ;; prints a failing tally and exits 0 while `node out/server-test.js`
 ;; prints the identical tally and exits 1 -- the two runs disagree on
 ;; nothing except the exit code. Every other artefact's `:test` alias IS
 ;; a verdict, so a compile alias here would read as one and hand back a
 ;; clean pass over real failures.
 ;;
 ;; An ABSENT alias is no better: `clojure -M:test` against a missing
 ;; alias drops into a REPL and exits 0 on EOF -- silent, no test output,
 ;; a false green in a script just the same. So `:test` exists and fails
 ;; CLOSED, naming the command that is a verdict. It needs no
 ;; `:extra-paths`: top-level `:paths` already carries `test`, and
 ;; shadow-cljs reads `:deps true`, which applies no aliases at all.
 {:test {:main-opts
         ["-e"
          "(binding [*out* *err*] (println \"tools/re-frame2-pair-mcp has no JVM test lane. `shadow-cljs compile server-test` is NOT a verdict: its :autorun prints failures and the compile still exits 0. Run `npm test` -- it also runs `node out/server-test.js`, and THAT exit code is the verdict.\")) (System/exit 2)"]}}}
