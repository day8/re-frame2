;; day8/re-frame2-machines-viz — the substrate-agnostic MachineChart
;; component + read-only viewer surfaces. Scaffolded per
;; tools/machines-viz/spec/000-Vision.md; src landing per rf2-o9arp
;; (the rf2-0yil0 audit cluster's first bead, which extracts the
;; chart implementation out of Xray and into its own jar).
;;
;; ## Bundle isolation
;;
;; Per tools/README.md the machines-viz artefact is bundle-isolated
;; from production code: nothing under implementation/ may :require
;; anything from this jar. The chart consumes the framework's
;; public surfaces (`rf/machine-meta`, the runtime-db `[:rf.runtime/machines :snapshots]` slot,
;; the trace bus) but adds no new framework primitives.
;;
;; ## Lockstep version with implementation/core
;;
;; Same posture as tools/xray/deps.edn — :local/root during
;; development; the release workflow rewrites :local/root →
;; :mvn/version pinned to the same VERSION file the core artefact
;; reads so machines-viz's published version equals the framework's
;; published version at every release.
{:paths ["src"]
 :deps  {;; rf2-o9arp — the chart code is pure-data hiccup + a thin
         ;; ELK adapter. The only framework surface it touches is
         ;; the public registrar API for `rf/machine-meta` (a future
         ;; capability bead wires the live snapshot read through
         ;; `re-frame.core`). For Phase-1 src-landing we ship with
         ;; the framework core as the sole transitive dep — Xray
         ;; brings its own substrate adapter on the consumer side.
         day8/re-frame2 {:local/root "../../implementation/core"}

         ;; rf2-sqhqu — the Mermaid emitter
         ;; (`day8.re-frame2-machines-viz.mermaid`) now lives in THIS
         ;; tool jar, so machines-viz no longer depends on the runtime
         ;; `machines` artefact (the runtime artefact is now
         ;; pure-engine). `export`'s `chart-as-mermaid` delegates to the
         ;; local emitter; the chart consumes only the framework's
         ;; public `rf/machine-meta` surface from `core` above.

         ;; rf2-8d7w1 — share-URL encoding is EDN → transit-write →
         ;; base64url (Principles §EDN-first on the wire; Lock #3).
         ;; transit-cljs is a genuine RUNTIME dep of the share encode/decode
         ;; path (`share.cljs` calls `transit/writer`/`write`/`reader`/`read`),
         ;; so it sits in the main :deps, not the :test alias. It is
         ;; "dev-only" ONLY because the WHOLE machines-viz jar is dev-only:
         ;; bundle isolation holds (nothing under implementation/ may
         ;; :require this jar), so a consumer's production bundle never
         ;; pulls transit through machines-viz — NOT because the dep is
         ;; test-scoped (moving it to :test would break share.cljs at
         ;; runtime — rf2-agu25 / rf2-60whl).
         com.cognitect/transit-cljs {:mvn/version "0.8.280"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {;; rf2-try1x — silent-on-success reporter.
                       day8/re-frame2-test-quiet
                       {:local/root "../../implementation/test-quiet"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; rf2-ir5nah — TEST-ONLY engine dep for the
                       ;; engine-grammar PARITY tests
                       ;; (engine_grammar_parity_test.cljc). machines-viz
                       ;; hand-MIRRORS the engine's machine-grammar walk +
                       ;; target resolution (Mike-ruled rf2-ir5nah opt (b):
                       ;; the mirror is by-design — bundle-isolation +
                       ;; JVM-portability make a shared :require infeasible);
                       ;; the parity tests feed representative machine-defs
                       ;; through BOTH the viz copy and the engine fn and
                       ;; assert equal output, so a silent drift becomes a
                       ;; RED gate. This dep lives ONLY on the :test alias —
                       ;; the shipped jar (:clein/build :src-dirs ["src"])
                       ;; never carries it, so bundle isolation (which gates
                       ;; the production BUNDLE, not the test classpath)
                       ;; holds: nothing under implementation/ requires this
                       ;; jar, and this jar's src never requires the engine.
                       day8/re-frame2-machines
                       {:local/root "../../implementation/machines"}}
         :main-opts   ["-m" "re-frame.test-quiet.runner"]}

  ;; Clojars deploy. Mirrors tools/xray/deps.edn — the release
  ;; workflow rewrites :local/root → :mvn/version before invoking
  ;; clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-machines-viz
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
