;; {{name}} — re-frame2 application (Reagent substrate, with SSR).
;;
;; Generated by day8/re-frame2-template (deps-new), :include-ssr? true.
;;
;; Six re-frame2 coords:
;;   - day8/re-frame2          — core runtime (registry, dispatch,
;;                                subscriptions, frames, machines, ...).
;;   - day8/re-frame2-reagent  — the Reagent substrate adapter.
;;   - day8/re-frame2-schemas  — `reg-app-schema` + Malli adapter (so
;;                                the whole-app-db schema validates, not
;;                                soft-passes).
;;   - day8/re-frame2-xray     — in-app devtools panel.
;;   - day8/re-frame2-ssr      — pure hiccup -> HTML emitter, the
;;                                framework-owned `:rf/hydrate` event, the
;;                                `:rf.server/*` response-effect family, and
;;                                the render-hash hooks (Spec 011).
;;   - day8/re-frame2-ssr-ring — the Ring host adapter: `ssr-handler`
;;                                wires the SSR runtime's per-request
;;                                lifecycle to a Ring-shaped server.
;;
;; All six re-frame2 coords ride the same version (schemas + xray + ssr +
;; ssr-ring lockstep with core). Bump them together when you upgrade
;; re-frame2.
;;
;; `ring/ring-jetty-adapter` is the dev/test host — any Ring-shaped server
;; (HttpKit / Pedestal / Reitit-ring) consumes the same `ssr-handler`; see
;; server.clj §Beyond Jetty.
;;
;; The app's registration root is `core.cljc` (shared JVM + CLJS), so the
;; `:server` alias below runs the JVM render path and `shadow-cljs watch
;; app` compiles the CLJS hydration path — one file, two runs.
{:paths ["src"]

 :deps  {org.clojure/clojure       {:mvn/version "1.12.0"}
         org.clojure/clojurescript {:mvn/version "1.12.145"}

         day8/re-frame2            {:mvn/version "{{rf2-version}}"}
         day8/re-frame2-reagent    {:mvn/version "{{rf2-version}}"}
         ;; Schema attachment — `reg-app-schema` + Malli adapter. The
         ;; starter app's whole-app-db schema (see core.cljc's CounterDb)
         ;; needs this artefact for validation to actually fire; without it
         ;; CLJS soft-passes per Spec 010 §Recommended soft-pass.
         day8/re-frame2-schemas    {:mvn/version "{{rf2-version}}"}
         ;; In-app devtools panel — auto-opens into the app-provided
         ;; [data-rf-xray-host] right-side layout host. Wired via
         ;; :devtools/preloads in shadow-cljs.edn. Lockstep with the core
         ;; coord — Xray publishes at the same version.
         day8/re-frame2-xray      {:mvn/version "{{rf2-version}}"}
         ;; SSR runtime + Ring host adapter (Spec 011). The render path
         ;; lives on the JVM (see the :server alias); the `:rf/hydrate`
         ;; event auto-registers on the client at ns-load.
         day8/re-frame2-ssr       {:mvn/version "{{rf2-version}}"}
         day8/re-frame2-ssr-ring  {:mvn/version "{{rf2-version}}"}

         reagent/reagent           {:mvn/version "2.0.1"}
         ;; Dev/test SSR host. Swap for your production host (HttpKit,
         ;; Pedestal, Reitit-ring) — all consume the same Ring-shaped
         ;; `ssr-handler`. Pinned lockstep with the re-frame2 ssr-ring
         ;; test host.
         ring/ring-jetty-adapter   {:mvn/version "1.12.1"}}

 :aliases
 {;; `clojure -X:server` boots the SSR/Jetty host (see server.clj). Reads
  ;; :port + :static-root from :exec-args; override on the CLI, e.g.
  ;; `clojure -X:server :port 9000`.
  :server
  {:exec-fn   {{namespace}}.server/-main
   :exec-args {:port 8030 :static-root "resources/public/js"}}

  ;; `clojure -M:shadow` runs shadow-cljs in JVM mode via the alias.
  ;; You can also use `npx shadow-cljs ...` (shadow's own node-side CLI).
  ;; Both work; the npm-side route is the canonical workflow.
  :shadow
  {:extra-paths ["test" "dev"]
   :extra-deps  {thheller/shadow-cljs        {:mvn/version "{{shadow-version}}"}
                 org.clojure/tools.namespace {:mvn/version "1.5.0"}}
   :main-opts   ["-m" "shadow.cljs.devtools.cli"]}

  ;; cljfmt — `clojure -M:cljfmt check` / `fix`. Config in
  ;; .cljfmt.edn. Pinned to the current cljfmt CLI line.
  :cljfmt
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
   :main-opts  ["-m" "cljfmt.main"]}

  ;; clj-kondo — `clojure -M:clj-kondo --lint src test`. Runs the linter
  ;; via the JVM dep so no native `clj-kondo` binary install is needed
  ;; (parity with the :cljfmt alias above). lefthook + CI invoke this
  ;; alias. If you prefer the faster native binary, install it per
  ;; https://github.com/clj-kondo/clj-kondo/blob/master/doc/install.md
  ;; and point lefthook.yml's clj-kondo hook at the bare `clj-kondo`.
  :clj-kondo
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.04.15"}}
   :main-opts  ["-m" "clj-kondo.main"]}}}
