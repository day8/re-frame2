;; {{name}} — re-frame2 application (Reagent substrate, with Story).
;;
;; Generated by day8/re-frame2-template (deps-new).
;;
;; Six re-frame2 coords:
;;   - day8/re-frame2          — core runtime (registry, dispatch,
;;                                subscriptions, frames, machines, ...).
;;   - day8/re-frame2-reagent  — the Reagent substrate adapter.
;;   - day8/re-frame2-schemas  — `reg-app-schema` + Malli adapter (so
;;                                schema.cljs validates, not soft-passes).
;;   - day8/re-frame2-machines — the state-machine artefact Story's
;;                                loader lifecycle runs on; it is also
;;                                the resolution pin the two tool coords
;;                                below need (see the note beside it).
;;   - day8/re-frame2-xray     — in-app devtools panel.
;;   - day8/re-frame2-story    — Storybook-class component playground,
;;                                scaffolded via `:include-story? true`.
;;                                Hash-route `#/stories` mounts the shell;
;;                                `#/` mounts the live app. See the
;;                                stories.cljs file next to events.cljs.
;;
;; The four FRAMEWORK coords ride one version; bump them together when
;; you upgrade re-frame2. Xray and Story are TOOLS, and the tools ship on
;; their own tags, so they ride git coords instead — see the notes above
;; them.
{:paths ["src"]

 :deps  {org.clojure/clojure       {:mvn/version "1.12.0"}
         org.clojure/clojurescript {:mvn/version "1.12.145"}

         day8/re-frame2            {:mvn/version "{{rf2-version}}"}
         day8/re-frame2-reagent    {:mvn/version "{{rf2-version}}"}
         ;; Schema attachment — `reg-app-schema` + Malli adapter. The
         ;; starter app's whole-app-db schema (see schema.cljs) needs
         ;; this artefact for validation to actually fire; without it
         ;; the `reg-app-schema` call throws :rf.error/schemas-artefact-missing
         ;; at boot — a hard requirement for schema registration, not a soft-pass.
         day8/re-frame2-schemas    {:mvn/version "{{rf2-version}}"}
         ;; Xray (the in-app devtools panel, auto-opening into the
         ;; app-provided [data-rf-xray-host] layout host) and Story (the
         ;; component playground behind `#/stories`).
         ;;
         ;; GIT coords, deliberately. re-frame2's tools ship on their own
         ;; tags — Xray on `xray-v*`, Story on `story-v*` — and the
         ;; framework's `v*` tag publishes no tools at all, so there is
         ;; nothing on Clojars for an :mvn/version to name. Both resolve
         ;; from the monorepo at one reviewed commit, which also keeps
         ;; them in lockstep with each other. Move them to
         ;; {:mvn/version "…"} once the tool releases land.
         day8/re-frame2-xray       {:git/url   "https://github.com/day8/re-frame2.git"
                                    :git/sha   "{{rf2-tools-sha}}"
                                    :deps/root "tools/xray"}
         day8/re-frame2-story      {:git/url   "https://github.com/day8/re-frame2.git"
                                    :git/sha   "{{rf2-tools-sha}}"
                                    :deps/root "tools/story"}
         ;; Resolution pin, and the price of the two git coords above.
         ;; tools.deps gives each git coordinate its OWN checkout of the
         ;; monorepo, so Xray's and Story's in-repo `:local/root` deps
         ;; arrive as two different paths for the same library and
         ;; dependency resolution fails ("No known ancestor relationship
         ;; between local versions for day8/re-frame2-machines"). A
         ;; top-level coordinate wins over both, which settles it. Every
         ;; other shared library is already pinned above; machines is the
         ;; only one left, and it is genuinely on this app's classpath —
         ;; Story runs its loader lifecycle as a re-frame2 state machine.
         ;; Retire this line when the tools coords go to :mvn/version.
         day8/re-frame2-machines   {:mvn/version "{{rf2-version}}"}

         reagent/reagent           {:mvn/version "2.0.1"}}

 :aliases
 {;; shadow-cljs's JVM side. shadow-cljs.edn's `{:deps {:aliases [:shadow]}}`
  ;; points here, so `npx shadow-cljs watch app` (and every package.json
  ;; script) builds its classpath from this deps.edn plus this alias.
  ;;
  ;; Deps only, deliberately NO :main-opts: `npx shadow-cljs` already
  ;; appends `-m shadow.cljs.devtools.cli` when it shells out to clojure,
  ;; and clojure prepends an alias's :main-opts to the command line — so
  ;; an :main-opts here becomes a second `-m` and every npx / npm-script
  ;; command dies on shadow's arg parser with `Unknown option: "-m"`.
  ;; Pure-JVM route (no node wrapper):
  ;;   clojure -M:shadow -m shadow.cljs.devtools.cli watch app
  :shadow
  {:extra-paths ["test" "dev"]
   :extra-deps  {thheller/shadow-cljs        {:mvn/version "{{shadow-version}}"}
                 org.clojure/tools.namespace {:mvn/version "1.5.0"}}}

  ;; cljfmt — `clojure -M:cljfmt check` / `fix`. Config in
  ;; .cljfmt.edn. Pinned to the current cljfmt CLI line.
  :cljfmt
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
   :main-opts  ["-m" "cljfmt.main"]}

  ;; clj-kondo — `clojure -M:clj-kondo --lint src test`. Runs the linter
  ;; via the JVM dep so no native `clj-kondo` binary install is needed
  ;; (parity with the :cljfmt alias above). lefthook + CI invoke this
  ;; alias. If you prefer the faster native binary, install it per
  ;; https://github.com/clj-kondo/clj-kondo/blob/master/doc/install.md
  ;; and point lefthook.yml's clj-kondo hook at the bare `clj-kondo`.
  :clj-kondo
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.04.15"}}
   :main-opts  ["-m" "clj-kondo.main"]}}}
