;; {{name}} — shadow-cljs build config.
;;
;; Two builds:
;;   :app  — watch / release. Compiles to resources/public/js/main.js and
;;           boots {{namespace}}.core/init. shadow calls :init-fn ONCE, at
;;           bundle load; after a hot reload it calls the build's
;;           ^:dev/after-load hooks instead, so core.cljs carries one
;;           (`mount!`) that re-renders the edited views. `watch` and
;;           `compile` boot {{namespace}}.stories/init instead (:dev), which
;;           adds Story on #/stories; a release carries no Story.
;;   :test — the node-side test runner. Picks up every *_test.cljs under
;;           test/ and runs it with cljs.test.
{:deps {:aliases [:shadow :dev]}

 :dev-http {8280 "resources/public"}

 :builds
 {:app  {:target     :browser
         :output-dir "resources/public/js"
         :asset-path "/js"
         :modules    {:main {:init-fn {{namespace}}.core/init}}
         :dev        {:modules {:main {:init-fn {{namespace}}.stories/init}}}}

  :test {:target    :node-test
         :output-to "out/node-test.js"
         :ns-regexp "-test$"}}}
