;; {{name}} — shadow-cljs build config ({{substrate-label}} substrate).
;;
;; Shared by the adapter substrates (Reagent / UIx): the same two
;; builds — the React substrate is chosen in deps.edn + core.cljs, not
;; here.
;;
;; Two builds:
;;   :app  — watch / release. Compiles to resources/public/js/main.js.
;;           Boot entry point: {{namespace}}.core/init.
;;   :test — node-side test runner. Picks up any *_test.cljs file under
;;           test/ and runs it via cljs.test.
{:deps   {:aliases [:shadow]}
 :source-paths ["src" "test" "dev"]

 :dev-http {8280 "resources/public"}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   ;; shadow's :browser target re-runs the module :init-fn after each
   ;; hot reload by default — no :after-load hook needed.
   :modules    {:main {:init-fn {{namespace}}.core/init}}{{xray-preload}}}

  :test
  {:target    :node-test
   :output-to "out/node-test.js"
   :ns-regexp "-test$"}}}
