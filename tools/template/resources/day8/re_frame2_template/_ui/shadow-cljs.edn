;; {{name}} — shadow-cljs build config ({{substrate-label}} substrate —
;; EXPERIMENTAL).
;;
;; Two builds:
;;   :app  — watch / release. Compiles to resources/public/js/main.js.
;;           Boot entry point: {{namespace}}.core/init.
;;   :test — node-side test runner. Picks up any *_test.cljs file under
;;           test/ and runs it via cljs.test.
;;
;; Supported shadow-cljs versions: 3.4.0 through 3.4.11 — the re-frame.ui
;; build hook is tested across that range (see
;; docs/core/how-to/install-re-frame-ui.md §Supported Shadow versions).
;; package.json + the deps.edn :shadow alias pin {{shadow-version}}, a
;; concrete version within the range; the two halves must match.
{:deps   {:aliases [:shadow]}
 :source-paths ["src" "test" "dev"]

 :dev-http {8280 "resources/public"}

 ;; The ONE load-bearing re-frame.ui setting — the whole install contract
 ;; (docs/core/how-to/install-re-frame-ui.md). The build hook harvests
 ;; re-frame.ui's whole-build registries (view digests, root/plan indexes,
 ;; Root Descriptors, custom-element declarations) from cache-durable
 ;; per-namespace analyzer data at build time. Omit it and the build ships
 ;; no registries, so the app throws on namespace load. Because the
 ;; registries no longer depend on macro-expansion side effects, a warm
 ;; daemon start REUSES Shadow's disk cache — there is no :cache-blockers
 ;; line and none is needed.
 :build-defaults {:build-hooks [(re-frame.ui.compiler.build-hook/hook)]}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   ;; shadow's :browser target re-runs the module :init-fn after each
   ;; hot reload by default — no :after-load hook needed. `ui/mount` is
   ;; idempotent per root, so the re-run re-renders into the same root.
   :modules    {:main {:init-fn {{namespace}}.core/init}}}

  :test
  {:target    :node-test
   :output-to "out/node-test.js"
   :ns-regexp "-test$"}}}
