 ;; Fire the registrations once at namespace load.
 (register-all!)
+
+;; J1 retain (rf2-a1v8a measurement, uncommitted): the save dialog's snippet,
+;; alias translated story -> rf.story, plus a hand-typed pin of the welcome picture.
+(rf.story/reg-variant :story.login-form/welcome-back
+  {:extends :story.login-form/idle
+   :args {:heading "Welcome back"}
+   :sub-overrides {[:login/state] :authenticated
+                   [:login/email] "ada@example.com"
+                   [:rf.machine/has-tag? :login/flow :auth/authenticated] true}})
+
+;; J1 strengthen (rf2-a1v8a measurement, uncommitted): the upgrade dialog's scaffold,
+;; alias translated, :setup filled from the authenticated variant's events, fx stub copied.
+(rf.story/reg-variant :story.login-form/welcome-back-upgraded
+  {:extends :story.login-form/idle
+   :args {:heading "Welcome back"}
+   :decorators [[rf.story/force-fx-stub-id :rf.http/managed {}]]
+   ;; real events — proves handlers + app-db
+   :setup [[:dispatch [:login/flow [:login/submit {:email "ada@example.com" :password "correct-horse"}]]]
+           [:dispatch [:login/flow [:login/success {:value {:user {:email "ada@example.com"} :token "story-token"}}]]]]})
+
+;; J1 behaviour check (rf2-a1v8a measurement, uncommitted): the add-expectations
+;; dialog's form, alias translated story -> rf.story, id kept as generated.
+(rf.story/reg-variant :story.login-form/expects-427199
+  {:extends :story.login-form/welcome-back-upgraded
+   :assertions [[:rf.assert/sub-equals [:login/email] "ada@example.com"]]
+   :script [[:assert [:rf.assert/sub-equals [:login/email] "ada@example.com"]]]
+   :tags #{:test}})
