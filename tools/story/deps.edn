;; day8/re-frame2-story — Storybook-class component playground for
;; re-frame2 (rf2-u6fb parent epic; Stage 1 spec rf2-2hir).
;;
;; Per tools/README.md the artefact is a downstream consumer of
;; implementation/core/ (and the implementation/adapters/reagent/ shell
;; substrate) — Story does not register new framework primitives; every
;; surface it exposes is built on the spec/007 contract over the spec/002
;; frame primitive and the spec/009 instrumentation API.
;;
;; The MCP agent surface ships as a separate artefact under tools/story-mcp/
;; (day8/re-frame2-story-mcp). This artefact carries no stdio / JSON-RPC
;; dependency.
;;
;; Stage 2 (rf2-* TBD by Stage 1 bead-filing) lands src/ and test/ trees.
;; Until then this deps.edn is the contract; sources arrive with Stage 2.
{:paths ["src"]
 :deps  {day8/re-frame2          {:local/root "../../implementation/core"}
         day8/re-frame2-reagent  {:local/root "../../implementation/adapters/reagent"}

         ;; Reagent is Story's UI-shell substrate at v1 (see IMPL-SPEC §8).
         ;; Reagent ships in implementation/core's :deps; this entry is
         ;; explicit because Story's UI shell directly :require's reagent.
         ;; If implementation/core's coupling to Reagent ever loosens, this
         ;; dep stays.
         reagent/reagent         {:mvn/version "2.0.1"}

         ;; Stage 3 (rf2-von3) — the loader four-phase lifecycle is
         ;; implemented as a state machine via `re-frame.machines` per
         ;; IMPL-SPEC §5.4 and the standing 'no new registries' rule
         ;; (AGENTS.md `downstream-EPs-consume-foundation`). Story's
         ;; runtime registers `:rf.story.lifecycle/machine` at boot;
         ;; per-variant snapshots live at `[:rf.runtime/machines
         ;; :snapshots :rf.story.lifecycle/machine]` inside each variant frame's
         ;; runtime-db partition (EP-0001 rf2-vzld77). Without machines on the
         ;; classpath the lifecycle cannot run, so the dep is mandatory at
         ;; Stage 3+.
         day8/re-frame2-machines {:local/root "../../implementation/machines"}

         ;; rf2-5x1wt.14 — the managed-HTTP artefact. Story's first-class
         ;; `:network` world slot lowers to the managed-request stub
         ;; machinery in `re-frame.http.test-support/install-managed-
         ;; request-stubs!` (Spec 014 §Testing). Installing the stub fx
         ;; for a `:network` variant frame is a RUNTIME concern, so the
         ;; dep belongs in the main `:deps` (not the `:test` alias). The
         ;; managed-HTTP fx surface (`:rf.http/managed`) ships in this same
         ;; artefact under `re-frame.http.managed`.
         day8/re-frame2-http     {:local/root "../../implementation/http"}

         ;; rf2-rfid2x — the invariant-sentinel fixture
         ;; (`re-frame.story.invariants`, in src/) attaches to the assembled
         ;; `:epoch` stream via the epoch HOME verb
         ;; `re-frame.epoch/register-epoch-listener!` (per the Tool-Pair
         ;; §"Facade vs home-namespace verb — the DCE tier rule": canonical
         ;; devtools attach via the home verbs, never the `re-frame.core`
         ;; facade). The home verb is a HARD compile dep on the epoch artefact,
         ;; so it belongs in the RUNTIME `:deps` (not the `:test` alias): a
         ;; consumer of `with-invariants` needs the epoch stream the sentinel
         ;; checks after every committed epoch. This replaces the prior
         ;; facade-via-late-bind form whose silent no-op-when-absent was a
         ;; false-green footgun for an invariant sentinel. (The run-artifact
         ;; replay path in `re-frame.story.artifact` still reads the late-bound
         ;; `rf/epoch-history` facade — it degrades to an empty tape and does
         ;; not need a hard dep.)
         day8/re-frame2-epoch    {:local/root "../../implementation/epoch"}

         ;; Malli drives Story's three-level args / argtypes auto-derivation
         ;; from Spec 010 schemas (see IMPL-SPEC §4 + §5.2). Malli is
         ;; already a transitive dep via implementation/core; the version
         ;; pin matches implementation/shadow-cljs.edn's :dependencies
         ;; entry so the top-level CLJS test build (`npm run test:cljs`)
         ;; resolves a single Malli on the classpath.
         metosin/malli           {:mvn/version "0.20.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {;; rf2-try1x — silent-on-success reporter.
                       day8/re-frame2-test-quiet {:local/root "../../implementation/test-quiet"}
                       ;; rf2-5x1wt.5/.6 + rf2-5x1wt.7 + rf2-rfid2x — the live
                       ;; epoch surface is needed on the JVM classpath by two
                       ;; consumers. As of rf2-rfid2x the epoch artefact is a
                       ;; RUNTIME `:deps` entry (above) because the
                       ;; invariant-sentinel fixture (`re-frame.story.invariants`)
                       ;; now registers via the HARD-dep home verb
                       ;; `re-frame.epoch/register-epoch-listener!`; the run-artifact
                       ;; replay path (`re-frame.story.artifact`) still reads the
                       ;; late-bound `rf/epoch-history` facade (empty-tape when
                       ;; absent). The runtime dep already satisfies both under
                       ;; `clojure -M:test`, so no separate `:test`-alias epoch
                       ;; entry is required.
                       ;; rf2-6nk6d — test.check is here on the :test alias ONLY
                       ;; (NOT a Story runtime dep). It exercises the OPTIONAL
                       ;; `re-frame.story.generate.test-check` adapter, which
                       ;; late-binds test.check via `requiring-resolve` so the
                       ;; published Story jar never depends on it. The
                       ;; dependency-free splitmix64 `gen-fn` path remains the
                       ;; default; this dep only lets the adapter's tests prove
                       ;; the test.check draw → gen-fn → seed-bearing-artifact
                       ;; path end to end.
                       org.clojure/test.check    {:mvn/version "1.1.1"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "re-frame.test-quiet.runner"]}

  ;; Clojars deploy. Mirrors implementation/adapters/reagent/deps.edn —
  ;; the release workflow rewrites :local/root → :mvn/version before
  ;; invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-story
   :main     re-frame.story
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
