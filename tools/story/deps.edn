;; day8/re-frame2-story — Storybook-class component playground for
;; re-frame2.
;;
;; Per tools/README.md the artefact is a downstream consumer of
;; implementation/core/ (and the implementation/adapters/reagent/ shell
;; substrate) — Story does not register new framework primitives; every
;; surface it exposes is built on the spec/007 contract over the spec/002
;; frame primitive and the spec/009 instrumentation API.
;;
;; The MCP agent surface ships as a separate artefact under tools/story-mcp/
;; (day8/re-frame2-story-mcp). This artefact carries no stdio / JSON-RPC
;; dependency.
;;
{:paths ["src"]
 :deps  {day8/re-frame2          {:local/root "../../implementation/core"}
         day8/re-frame2-reagent  {:local/root "../../implementation/adapters/reagent"}

         ;; Reagent is Story's UI-shell substrate at v1 (see IMPL-SPEC §8).
         ;; Reagent ships in implementation/core's :deps; this entry is
         ;; explicit because Story's UI shell directly :require's reagent.
         ;; If implementation/core's coupling to Reagent ever loosens, this
         ;; dep stays.
         reagent/reagent         {:mvn/version "2.0.1"}

         ;; The loader lifecycle is implemented as a state machine via
         ;; `re-frame.machines`; Story consumes the framework artefact
         ;; instead of maintaining a parallel lifecycle registry. Story's
         ;; runtime registers `:rf.story.lifecycle/machine` at boot;
         ;; per-variant snapshots live at `[:rf.runtime/machines
         ;; :snapshots :rf.story.lifecycle/machine]` inside each variant frame's
         ;; runtime-db partition. Without machines on the classpath the
         ;; lifecycle cannot run, so this is a runtime dependency.
         day8/re-frame2-machines {:local/root "../../implementation/machines"}

         ;; Story's first-class `:network` world slot lowers to the
         ;; managed-request stub
         ;; machinery in `re-frame.http.test-support/install-managed-
         ;; request-stubs!` (Spec 014 §Testing). Installing the stub fx
         ;; for a `:network` variant frame is a RUNTIME concern, so the
         ;; dep belongs in the main `:deps` (not the `:test` alias). The
         ;; managed-HTTP fx surface (`:rf.http/managed`) ships in this same
         ;; artefact under `re-frame.http.managed`.
         day8/re-frame2-http     {:local/root "../../implementation/http"}

         ;; Xray is Story's diagnostic engine, not an optional plugin.
         ;; The shipped shell unconditionally composes it: the RHS
         ;; inspector mounts Xray's own panels through
         ;; `day8.re-frame2-xray.panels/mount-<panel>!`, the popout
         ;; escape hatch calls `day8.re-frame2-xray.mount/popout!`, and
         ;; the evidence spine routes focus commands through
         ;; `day8.re-frame2-xray.core/focus!`. Those are hard
         ;; compile-time `:require`s in `re-frame.story.ui.xray-embed`,
         ;; `re-frame.story.xray-preset`, and
         ;; `re-frame.story.ui.evidence-spine` — so Xray belongs in the
         ;; package graph, declared and lockstep-versioned like every
         ;; other Story dep. The repository-wide Shadow build previously
         ;; masked the omission by carrying `../tools/xray/src` on its
         ;; global :source-paths; a consumer whose only tool dep was
         ;; `day8/re-frame2-story` could not compile the shell at all
         ;; (rf2-r8trk).
         ;;
         ;; Direction: Story → Xray only. Xray never requires Story, so
         ;; there is no cycle. Both are dev-only tools artefacts and
         ;; neither reaches a production bundle, so bundle-isolation is
         ;; unaffected (that gate forbids `implementation/` → `tools/`,
         ;; not `tools/story` → `tools/xray`).
         day8/re-frame2-xray     {:local/root "../xray"}

         ;; Malli drives Story's three-level args / argtypes auto-derivation
         ;; from Spec 010 schemas (see IMPL-SPEC §4 + §5.2). Malli is
         ;; already a transitive dep via implementation/core; the version
         ;; pin matches implementation/shadow-cljs.edn's :dependencies
         ;; entry so the top-level CLJS test build (`npm run test:cljs`)
         ;; resolves a single Malli on the classpath.
         metosin/malli           {:mvn/version "0.20.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {day8/re-frame2-test-quiet {:local/root "../../implementation/test-quiet"}
                       ;; NO SUBSTRATE-DONOR COORDINATE — deliberately.
                       ;;
                       ;; NO re-frame.ui (rf2-2og6s). Story used to carry
                       ;; `day8/re-frame2-ui` here to compile four test-only
                       ;; consumers of the compiled-view tool tier: the
                       ;; `re-frame.story.view-tool` shaper over the five frozen
                       ;; `re-frame.ui.tool` projections, its CLJS and JVM
                       ;; suites, and the realworld-ui substrate-consumer suite.
                       ;; re-frame.ui is retired (rf2-0yp7w), so all four are
                       ;; gone and nothing on this classpath names the substrate.
                       ;;
                       ;; They were RETIRED rather than re-pointed at
                       ;; `re-frame.hicasso.tool`, and the reason is question
                       ;; shape rather than effort — the same refusal
                       ;; `rf2-jkdy` reached for Xray's Views panel and
                       ;; `rf2-l86mm` re-confirmed. The donor tier answers
                       ;; `view-manifest` / `view-dependencies` /
                       ;; `view-event-sites` about a view named by its id;
                       ;; Hicasso mints no boundary identity at all (a boundary
                       ;; is keyed by its READ SET, `:view` and `:source`
                       ;; projected `unknown` under an `:opaque` naming
                       ;; projection), so those three reads have no counterpart
                       ;; and `mounted-views` cannot be keyed on a view. The JVM
                       ;; structural tree (`re-frame.ui.test/render`,
                       ;; `:rf.ui/tree-version`) has no counterpart either:
                       ;; `re-frame.hicasso.tool` is `.cljs`-only and Hicasso
                       ;; ships no headless render. Do not re-add a substrate
                       ;; coordinate to revive them; the compatibility claim
                       ;; they proved retired with the surface it was about.
                       ;;
                       ;; NO FREEHAND COORDINATE — deliberately (rf2-5gka).
                       ;; Story used to carry `day8/re-frame2-freehand` here to
                       ;; compile the presence-rung HOST BRIDGE
                       ;; (`re-frame.story.play.presence-host`) and its two
                       ;; Freehand-only witness suites. Freehand is retired
                       ;; (rf2-0yp7w), so the bridge and those suites are gone
                       ;; and nothing on this classpath names the substrate.
                       ;;
                       ;; The presence RUNG itself stays and is
                       ;; substrate-neutral: `re-frame.story.play.presence`
                       ;; requires only `re-frame.story.late-bind`, and a host
                       ;; registers its own advance through the public
                       ;; `install-presence-flush!`. With no host installed a
                       ;; `[:flush-presence]` step FAILS CLOSED (`:cannot-run`)
                       ;; rather than passing falsely — which is why the rung
                       ;; needs no substrate dep to be tested. Do not re-add a
                       ;; substrate coordinate to arm it; install the verb from
                       ;; the host side of the seam.
                       ;; Two test-only consumers need the live epoch surface
                       ;; on the JVM classpath:
                       ;;   • the invariant-sentinel fixture
                       ;;     (`re-frame.story.invariants`) registers a live epoch
                       ;;     listener via `(rf/register-listener! :epoch …)`;
                       ;;   • the run-artifact replay path (`re-frame.story.artifact`)
                       ;;     captures a live epoch tape via `rf/epoch-history`.
                       ;; Both degrade to a no-op / empty tape unless the epoch
                       ;; artefact is on the classpath. The top-level CLJS build
                       ;; already carries `epoch/src` (shadow-cljs.edn); this gives
                       ;; the JVM `clojure -M:test` gate the same live surface so
                       ;; both the sentinel's fresh/destroyed-frame coverage and the
                       ;; replay tests exercise the real listener/capture path.
                       ;; Test-only — the published Story jar carries no epoch dep
                       ;; (both sources read the late-bound facade), mirroring how
                       ;; implementation/core/deps.edn pulls epoch on :test only.
                       day8/re-frame2-epoch      {:local/root "../../implementation/epoch"}
                       ;; test.check is present on the :test alias only. It
                       ;; exercises the optional
                       ;; `re-frame.story.generate.test-check` adapter, which
                       ;; late-binds test.check via `requiring-resolve` so the
                       ;; published Story jar never depends on it. The
                       ;; dependency-free splitmix64 `gen-fn` path remains the
                       ;; default; this dep only lets the adapter's tests prove
                       ;; the test.check draw → gen-fn → seed-bearing-artifact
                       ;; path end to end.
                       org.clojure/test.check    {:mvn/version "1.1.1"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "re-frame.test-quiet.runner"]}

  ;; Clojars deploy. Mirrors implementation/adapters/reagent/deps.edn —
  ;; the release workflow rewrites :local/root → :mvn/version before
  ;; invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-story
   :main     re-frame.story
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
