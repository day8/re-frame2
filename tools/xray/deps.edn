;; day8/re-frame2-xray — Xray, the re-frame2 devtools panel.
;;
;; Xray is a downstream, dev-only consumer of core, feature artefacts,
;; and the substrate adapter API. It does not define framework
;; primitives, and implementation/ must never depend on it.
;;
;; ## Pin lockstep with implementation/core
;;
;; Xray rides the core artefact at :local/root during development;
;; the release workflow rewrites :local/root → :mvn/version pinned to
;; the repository VERSION. Published Xray and framework artefacts
;; therefore use the same version.
;;
;; ## MCP surface
;;
;; AI agent access to Xray state flows via `tools/re-frame2-pair-mcp/`
;; and `day8.re-frame2-xray.runtime`. Xray has no MCP-server dependency.
{:paths ["src"]
 :deps  {day8/re-frame2 {:local/root "../../implementation/core"}

         ;; Time travel reads epoch history and registers an epoch
         ;; listener, so epoch is part of Xray's compile-time contract.
         day8/re-frame2-epoch {:local/root "../../implementation/epoch"}

         ;; The Routes lens compiles and ranks candidates through
         ;; `re-frame.routing.match`, including when the host registry is empty.
         day8/re-frame2-routing {:local/root "../../implementation/routing"}

         ;; The Static Flows catalogue and Epoch source links use the
         ;; flows artefact's public introspection functions.
         day8/re-frame2-flows {:local/root "../../implementation/flows"}

         ;; The Static Schemas catalogue reads the schema registry directly.
         day8/re-frame2-schemas {:local/root "../../implementation/schemas"}

         ;; The Derivation Graph composes the resource and cache algebra
         ;; projections. The Resources panel separately reads runtime data.
         day8/re-frame2-resources {:local/root "../../implementation/resources"}

         ;; The Derivation Graph consumes machine algebra and selector
         ;; projections; the Machine Inspector reads the runtime slice.
         day8/re-frame2-machines {:local/root "../../implementation/machines"}

         ;; The Views panel's Mounted Views + Declared View Sites sections
         ;; read the Freehand TOOL-TIER door (`re-frame.freehand.tool` —
         ;; rf2-7gth0). The dependency points THIS way only: Freehand never
         ;; depends on Xray, and production applications never pull Xray
         ;; (bundle-isolation contract), so the freehand artefact reaches
         ;; production apps solely on its own terms. The door is a reader —
         ;; there is no registry to claim and no ownership to hold — and it
         ;; nil-gates on `interop/debug-enabled?`, so a host that is not
         ;; running Freehand simply projects zero rows.
         day8/re-frame2-freehand {:local/root "../../implementation/freehand"}

         ;; The Hicasso tab reads the Hicasso TOOL-TIER door
         ;; (`re-frame.hicasso.tool` — rf2-hic-023) for its four views.
         ;; Identical posture to the Freehand coordinate above: the
         ;; dependency points THIS way only, the door is a pure reader with
         ;; no registry to claim and no ownership to hold, and it nil-gates
         ;; on `interop/debug-enabled?` — so a host not running Hicasso, and
         ;; a production build, both project the honest no-evidence state.
         ;;
         ;; NOT PUBLISHABLE YET, and the release preflight will say so.
         ;; `implementation/hicasso/deps.edn` carries no `:clein/build`
         ;; (rf2-hic-008 owns release wiring), so this is the SECOND in-repo
         ;; coordinate `.github/scripts/preflight-xray-package.sh` refuses to
         ;; find in a published pom. That refusal is correct and is not a
         ;; mechanical fix; publishing Xray needs Hicasso to acquire a
         ;; coordinate first.
         day8/re-frame2-hicasso {:local/root "../../implementation/hicasso"}

         ;; Machine charts are owned by machines-viz and embedded here;
         ;; Xray does not maintain a second chart implementation.
         day8/re-frame2-machines-viz {:local/root "../machines-viz"}

         ;; Reagent Slim supplies the default transitive adapter. Xray
         ;; renders through `re-frame.substrate.adapter`, so the adapter
         ;; installed by the host still governs the runtime path.
         day8/reagent-slim {:local/root "../../implementation/adapters/reagent-slim"}

         ;; Xray's own views require stock Reagent directly — e.g.
         ;; `day8.re-frame2-xray.views.resizable-table` requires
         ;; `reagent.core` for its component-local Ratom state — so Xray
         ;; declares the stock `reagent/reagent` dep itself. It previously
         ;; inherited Reagent transitively from core, but core is now
         ;; Reagent-free (re-frame.views late-binds via the
         ;; `:adapter/current-component` hook), so every artefact that
         ;; requires reagent.* must declare it. This is dev-only (Xray is a
         ;; devtools panel excluded from production bundles) and independent
         ;; of the reagent-slim adapter above, which carries no stock Reagent.
         reagent/reagent {:mvn/version "2.0.1"}

         ;; Editscript is the shared pure-data diff representation for
         ;; the tree inspector, flat diff view, and runtime accessor.
         juji/editscript {:mvn/version "0.6.5"}

         ;; Handler source is formatted before Xray tokenises and renders
         ;; it. The dependency remains confined to the dev-only artefact.
         zprint/zprint {:mvn/version "1.3.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {day8/re-frame2-test-quiet {:local/root "../../implementation/test-quiet"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "re-frame.test-quiet.runner"]}

  ;; Clojars deploy. Mirrors implementation/adapters/reagent/deps.edn
  ;; — the release workflow rewrites :local/root → :mvn/version before
  ;; invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-xray
   :main     day8.re-frame2-xray.preload
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
