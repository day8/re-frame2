;; day8/re-frame2-xray — Xray, the re-frame2 devtools panel.
;;
;; Xray is a downstream, dev-only consumer of core, feature artefacts,
;; and the substrate adapter API. It does not define framework
;; primitives, and implementation/ must never depend on it.
;;
;; ## Pin lockstep with implementation/core
;;
;; Xray rides the core artefact at :local/root during development;
;; the release workflow rewrites :local/root → :mvn/version pinned to
;; the repository VERSION. Published Xray and framework artefacts
;; therefore use the same version.
;;
;; ## No agent surface
;;
;; Xray is the HUMAN panel. Programmer/AI inspection of a running app is
;; `re-frame2-pair.runtime` plus `tools/re-frame2-pair-mcp/`, which read
;; the framework's instrumentation directly — Xray carries no agent
;; runtime, no discovery sentinel, and no MCP-server dependency.
{:paths ["src"]
 :deps  {day8/re-frame2 {:local/root "../../implementation/core"}

         ;; Time travel reads epoch history and registers an epoch
         ;; listener, so epoch is part of Xray's compile-time contract.
         day8/re-frame2-epoch {:local/root "../../implementation/epoch"}

         ;; The Routes lens compiles and ranks candidates through
         ;; `re-frame.routing.match`, including when the host registry is empty.
         day8/re-frame2-routing {:local/root "../../implementation/routing"}

         ;; The Static Flows catalogue and Epoch source links use the
         ;; flows artefact's public introspection functions.
         day8/re-frame2-flows {:local/root "../../implementation/flows"}

         ;; The Static Schemas catalogue reads the schema registry directly.
         day8/re-frame2-schemas {:local/root "../../implementation/schemas"}

         ;; The Derivation Graph composes the resource and cache algebra
         ;; projections. The Resources panel separately reads runtime data.
         day8/re-frame2-resources {:local/root "../../implementation/resources"}

         ;; The Derivation Graph consumes machine algebra and selector
         ;; projections; the Machine Inspector reads the runtime slice.
         day8/re-frame2-machines {:local/root "../../implementation/machines"}

         ;; The Fresco tab reads the Fresco TOOL-TIER door
         ;; (`re-frame.fresco.tool` — rf2-hic-023) for the four evidence
         ;; envelopes its six views project.
         ;; The dependency points THIS way only: Fresco never depends on
         ;; Xray, and production applications never pull Xray
         ;; (bundle-isolation contract), so the fresco artefact reaches
         ;; production apps solely on its own terms. The door is a pure
         ;; reader — there is no registry to claim and no ownership to hold —
         ;; and it nil-gates on `interop/debug-enabled?`, so a host not
         ;; running Fresco, and a production build, both project the honest
         ;; no-evidence state.
         ;;
         ;; THE ONE VIEW-SUBSTRATE COORDINATE Xray carries, since rf2-l86mm
         ;; retired the Views panel's Mounted Views + Declared View Sites
         ;; sections and dropped `day8/re-frame2-freehand` with them. That
         ;; coordinate sat at top-level `:deps` only because
         ;; `day8.re-frame2-xray.mounted-views` was in `src`.
         ;;
         ;; NOT PUBLISHABLE YET, and the release preflight will say so.
         ;; `implementation/fresco/deps.edn` carries no `:clein/build`
         ;; (rf2-hic-008 owns release wiring), so this is the ONE in-repo
         ;; coordinate `.github/scripts/preflight-xray-package.sh` refuses to
         ;; find in a published pom. That refusal is correct and is not a
         ;; mechanical fix; publishing Xray needs Fresco to acquire a
         ;; coordinate first.
         day8/re-frame2-fresco {:local/root "../../implementation/fresco"}

         ;; Machine charts are owned by machines-viz and embedded here;
         ;; Xray does not maintain a second chart implementation.
         day8/re-frame2-machines-viz {:local/root "../machines-viz"}

         ;; Reagent Slim supplies the default transitive adapter. Xray
         ;; renders through `re-frame.substrate.adapter`, so the adapter
         ;; installed by the host still governs the runtime path.
         day8/reagent-slim {:local/root "../../implementation/adapters/reagent-slim"}

         ;; Xray declares stock Reagent itself; core is Reagent-free
         ;; (re-frame.views late-binds via `:adapter/current-component`), so
         ;; every artefact that requires reagent.* must declare it.
         ;;
         ;; SINCE rf2-7ds8 `src` HAS EXACTLY ONE PRODUCTION REQUIRE, in
         ;; `day8.re-frame2-xray.substrate`, and it is the FALLBACK arm of
         ;; the hiccup->React-element crossing — taken only when no
         ;; ratom-family adapter answers `:adapter/as-element`, which is a
         ;; REAL case rather than a defensive flourish: Xray can own its own
         ;; React root, and the acceptance harness mounts the Static surface
         ;; through Fresco's root with UIx installed. Before that bead, nine
         ;; sites across six view sources named `reagent.core/as-element`
         ;; statically, so under the reagent-slim adapter the islands were
         ;; rendered by the wrong ratom build and Xray came up BLANK.
         ;;
         ;; RETIRING THAT ONE REQUIRE WOULD BUY NO BUNDLE BYTES — measured
         ;; under rf2-99qn, and said here because the previous wording
         ;; invited exactly that wasted errand. `day8/re-frame2-machines-viz`
         ;; above requires `reagent.core` in its chart tree and calls
         ;; `reagent.core/as-element` at ten sites of its own, and the edge
         ;; `preload -> registry -> panels.machine-inspector ->
         ;; panels.machine-canvas -> machines-viz.chart` is live, so stock
         ;; Reagent lands in every Xray-carrying build whether this door
         ;; requires it or not. THAT — not the nine retired crossings — is
         ;; why a reagent-slim page carrying Xray ships both ratom runtimes,
         ;; and the work to change it is in the machines-viz chart tree, not
         ;; here.
         ;;
         ;; This is dev-only (Xray is a devtools panel excluded from
         ;; production bundles) and independent of the reagent-slim adapter
         ;; above, which carries no stock Reagent.
         ;; Test code still requires reagent.* freely.
         reagent/reagent {:mvn/version "2.0.1"}

         ;; Editscript is the shared pure-data diff representation for
         ;; the tree inspector, flat diff view, and runtime accessor.
         juji/editscript {:mvn/version "0.6.5"}

         ;; Handler source is formatted before Xray tokenises and renders
         ;; it. The dependency remains confined to the dev-only artefact.
         zprint/zprint {:mvn/version "1.3.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {day8/re-frame2-test-quiet {:local/root "../../implementation/test-quiet"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "re-frame.test-quiet.runner"]}

  ;; Clojars deploy. Mirrors implementation/adapters/reagent/deps.edn
  ;; — the release workflow rewrites :local/root → :mvn/version before
  ;; invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-xray
   :main     day8.re-frame2-xray.preload
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
