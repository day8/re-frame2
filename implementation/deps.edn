;; Top-level coordinator.
;;
;; The published artefacts are
;;   - core/          (day8/re-frame2)
;;   - reagent/       (day8/re-frame2-reagent)
;;   - reagent-slim/  (day8/reagent-slim)
;;   - uix/           (day8/re-frame2-uix)
;;   - schemas/       (day8/re-frame2-schemas)
;;   - machines/ (day8/re-frame2-machines)
;;   - routing/  (day8/re-frame2-routing)
;;   - flows/    (day8/re-frame2-flows)
;;   - http/     (day8/re-frame2-http)
;;   - ssr/      (day8/re-frame2-ssr)
;;   - ssr-ring/ (day8/re-frame2-ssr-ring)
;;   - resources/ (day8/re-frame2-resources)
;;   - epoch/    (day8/re-frame2-epoch)
;;   - fresco/  (day8/re-frame2-fresco)
;; each with its own deps.edn in that directory. The substrate adapters
;; live under implementation/adapters/; per-feature artefacts sit flat
;; under implementation/.
;;
;; This top-level deps.edn is *not* itself a published artefact — it is
;; the coordinator that pulls every artefact onto a single classpath via
;; :local/root for the clojure-tools-driven steps: the REPL :test alias
;; and the :splint alias below. The shadow-cljs builds do not read it;
;; implementation/shadow-cljs.edn enumerates its own :source-paths and
;; :dependencies. Per-artefact JVM tests run via the per-artefact
;; deps.edn directly.
{:paths []
 :deps  {day8/re-frame2          {:local/root "core"}
         day8/re-frame2-reagent  {:local/root "adapters/reagent"}
         day8/reagent-slim        {:local/root "adapters/reagent-slim"}
         day8/re-frame2-uix      {:local/root "adapters/uix"}
         day8/re-frame2-schemas  {:local/root "schemas"}
         day8/re-frame2-machines {:local/root "machines"}
         day8/re-frame2-routing  {:local/root "routing"}
         day8/re-frame2-flows    {:local/root "flows"}
         day8/re-frame2-http     {:local/root "http"}
         day8/re-frame2-ssr      {:local/root "ssr"}
         day8/re-frame2-ssr-ring {:local/root "ssr-ring"}
         day8/re-frame2-epoch    {:local/root "epoch"}
         ;; The optional Resources artefact (Spec 016, EP-0003).
         ;; Managed resource queries: reg-resource, the :rf.resource/*
         ;; events + passive subs, work ledger, invalidation/GC, and
         ;; hydration.
         day8/re-frame2-resources {:local/root "resources"}
         ;; Fresco, re-frame2's own native view substrate. It is a
         ;; published artefact — its `:clein/build` alias carries the
         ;; coordinate and it is enrolled in
         ;; .github/scripts/verify-version-lockstep.sh and release.yml's
         ;; deploy DAG — so `fresco/src` belongs on this aggregate
         ;; classpath beside the `fresco/test` the `:test` alias carries.
         day8/re-frame2-fresco  {:local/root "fresco"}}

 :aliases
 {;; Combined CLJS-test path: convenient for ad-hoc REPL work that wants
  ;; every artefact and the example sources on the classpath. Production
  ;; CI runs each artefact's :test alias separately.
  :test
  {:extra-paths ["core/test"
                 "adapters/reagent/test"
                 "adapters/reagent-slim/test"
                 "adapters/uix/test"
                 ;; The test-react adapter test tree (REPL parity; the
                 ;; canonical JVM gate is the artefact's own :test alias,
                 ;; run per-artefact by scripts/test-jvm-implementation.sh).
                 "adapters/test-react/src"
                 "adapters/test-react/test"
                 "schemas/test"
                 "machines/test"
                 "routing/test"
                 "flows/test"
                 "http/test"
                 "ssr/test"
                 "ssr-ring/test"
                 "epoch/test"
                 ;; Resources artefact test tree.
                 "resources/test"
                 ;; The Fresco artefact test tree — package tests only; the
                 ;; benchmark harness is its own project under bench/fresco/,
                 ;; off this classpath. This alias is REPL convenience;
                 ;; production CI runs each artefact's own :test alias
                 ;; separately.
                 ;;
                 ;; `test_kit/src` is the supported L0–L2 testing surface.
                 ;; It sits deliberately OUTSIDE the artefact's `:paths`, so
                 ;; the `:local/root` dep above does not carry it; Fresco's
                 ;; own `:test` alias names it as an `:extra-path` and this
                 ;; aggregate does the same to match it.
                 "fresco/test"
                 "fresco/test_kit/src"
                 ;; examples are organised by concept; each bucket is a
                 ;; classpath root so JVM tests can `require` the example
                 ;; source namespaces like `ssr.core` (under
                 ;; examples/capabilities/ssr/ssr/) and `realworld-http.*`
                 ;; (under examples/real-apps/realworld_http/). The example
                 ;; tree is test-free: every example's headless test
                 ;; fixtures live in the framework test tree
                 ;; (re-frame.examples-test for the JVM-driven ssr /
                 ;; ssr_streaming / state_machine_walkthrough; the reagent
                 ;; adapter-test bridges for the CLJS ones).
                 "../examples/core"
                 "../examples/capabilities/machines"
                 "../examples/capabilities/routing"
                 "../examples/capabilities/resources"
                 "../examples/capabilities/ssr"
                 "../examples/patterns"
                 "../examples/real-apps"
                 "../examples/substrates"]
   ;; The test-quiet artefact owns the single Cognitect test-runner
   ;; coordinate (implementation/test-quiet/deps.edn :deps); this alias
   ;; resolves it TRANSITIVELY via the test-quiet local-root dep, and its
   ;; `re-frame.test-quiet.runner` entry-point wraps the runner.
   :extra-deps  {;; Silent-on-success reporter. Also the sole source of the
                 ;; cognitect test-runner coordinate on this alias's
                 ;; classpath (transitive).
                 day8/re-frame2-test-quiet {:local/root "test-quiet"}}
   :main-opts   ["-m" "re-frame.test-quiet.runner"]}

  ;; Splint — the dual-linter posture: clj-kondo catches bugs
  ;; (unresolved symbols, arity mismatch); Splint catches style smells
  ;; inspired by the Clojure Style Guide. CI invokes the alias from `.github/workflows/lint.yml`;
  ;; locally run `clojure -M:splint <paths>` from this directory.
  ;;
  ;; Splint is JVM-only and operates on text, so it does not need any
  ;; of the per-artefact classpaths — pinning the dep on the top-level
  ;; coordinator keeps the version in one place. Pre-1.0 we exact-pin
  ;; per the lockstep convention.
  ;;
  ;; The entry-point is `re-frame.splint-main` (under
  ;; `scripts/splint/`), a thin cross-platform shim around Splint's own
  ;; `-main`. Splint v1.24.0 builds its default-config + version
  ;; resource paths with `(str (io/file ...))`, which on Windows joins
  ;; with `\` — and `io/resource` only accepts `/`-separated keys, so
  ;; Splint dies with `Cannot open <nil> as a Reader.` on Windows dev
  ;; machines. The shim re-binds those two vars to forward-slash
  ;; lookups before delegating; on Linux/macOS it is a no-op
  ;; normalisation. Remove once Splint ships an upstream fix.
  :splint
  {:replace-deps {io.github.noahtheduke/splint {:mvn/version "1.24.0"}}
   :extra-paths  ["scripts/splint"]
   :main-opts    ["-m" "re-frame.splint-main"]}}}
