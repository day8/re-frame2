;; clj-kondo export for day8/re-frame2-hicasso (rf2-hic-022; reduced to
;; macro-shape analysis under rf2-r3r00).
;;
;; A consumer picks this up with clj-kondo's ordinary dependency import —
;; nothing here is re-frame2-specific plumbing:
;;
;;   clj-kondo --lint "$(clojure -Spath)" --dependencies --copy-configs
;;
;; which copies this directory to `.clj-kondo/day8/re-frame2-hicasso/` and
;; adds it to the consumer's `:config-paths`. See README.md beside this file.
;;
;; The hooks give `defview`, `event` and `defhost` their `defn`, `fn` and
;; `def` shapes, so kondo's ordinary analysis applies: names resolve,
;; destructured props are neither unresolved nor unused, arities are checked.
;; No custom findings ship — behavior is the runtime's law, refused loudly at
;; its execution boundary, not re-derived in a lint layer.
{;; `re-frame.hicasso.native` is two React hooks, `use-sub` and
 ;; `use-frame` — ordinary functions, so they need neither a `:lint-as`
 ;; nor a hook (rf2-6c12m.3).
 :hooks
 {:analyze-call
  {re-frame.hicasso/defview hooks.re-frame.hicasso/defview
   re-frame.hicasso/event   hooks.re-frame.hicasso/event
   re-frame.hicasso/defhost hooks.re-frame.hicasso/defhost}}}
