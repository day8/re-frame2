;; Optional debug-time epoch history and time-travel support. This artefact
;; depends on core, while core reaches it only through `re-frame.late-bind`.
;; Requiring `re-frame.epoch` publishes that hook contract; the publication
;; map in that namespace is the authoritative hook inventory.
;;
;; Keeping epoch separate excludes its ring buffers, capture path, restore
;; validation, and projection machinery from applications that do not opt in.
;; Its runtime paths are also gated by `interop/debug-enabled?`, allowing
;; advanced production builds with `goog.DEBUG=false` to eliminate them.
;;
;; Consumers add `day8/re-frame2-epoch` beside `day8/re-frame2` and require
;; `re-frame.epoch` before using the core facade's epoch functions.
{:paths ["src"]
 :deps  {day8/re-frame2 {:local/root "../core"}}

 :aliases
 {:test {:extra-paths ["test"]
         ;; Restore precondition and integration tests exercise registrations
         ;; published by these optional artefacts. They remain test-only so
         ;; production epoch does not acquire those dependencies.
         :extra-deps  {day8/re-frame2-schemas    {:local/root "../schemas"}
                       day8/re-frame2-flows      {:local/root "../flows"}
                       day8/re-frame2-routing    {:local/root "../routing"}
                       day8/re-frame2-machines   {:local/root "../machines"}
                       ;; Publishes the resource egress hooks used by projection
                       ;; integration tests; production lookup is nil-safe.
                       day8/re-frame2-resources  {:local/root "../resources"}
                       ;; The MCP egress conformance fixture drives a
                       ;; REAL `[:rf.resource/ensure …]` cascade so the resource
                       ;; trace family reaches the gate. `ensure` lowers through
                       ;; the managed-HTTP transport, which throws
                       ;; `:rf.error/http-artefact-missing` unless
                       ;; `re-frame.http.managed` has published its late-bind
                       ;; hook, so the fixture needs the artefact on the TEST
                       ;; classpath (the fx itself is overridden with a no-op —
                       ;; nothing fetches). Mirrors the resources artefact's own
                       ;; test-only http dep; production epoch stays http-free.
                       day8/re-frame2-http       {:local/root "../http"}
                       day8/re-frame2-test-quiet {:local/root "../test-quiet"}}
         ;; `-e :prod-gate` excludes the ONE namespace that is a
         ;; statement about the JVM it runs in rather than about epoch:
         ;; `re-frame.epoch-prod-gate-lane-pin-test` asserts unconditionally
         ;; that `-Dre-frame.debug=false` is on this JVM's command line. It
         ;; belongs to the `:prod-gate` lane below and is red anywhere else BY
         ;; DESIGN — a pin softened to "check the property if it is set" would
         ;; pass vacuously in exactly the case it exists to catch. Every other
         ;; test in this artefact runs here exactly once.
         :main-opts   ["-m" "re-frame.test-quiet.runner" "-e" ":prod-gate"]}

  ;; The PRODUCTION-GATE lane, as a MODIFIER composed onto `:test`:
  ;; `clojure -M:test:prod-gate`. `:extra-paths` / `:extra-deps` merge in from
  ;; `:test` (so the classpath cannot drift between the two lanes), while
  ;; `:jvm-opts` and `:main-opts` come from here — `:main-opts` is last-wins in
  ;; tools.deps, which is what lets this alias drop `-e :prod-gate` and pick the
  ;; pin up.
  ;;
  ;; WHY THE FLAG LIVES IN `:jvm-opts` AND NOT ON A CALLER'S COMMAND LINE.
  ;; `spec/Security.md` documents `-Dre-frame.debug=false` as the JVM/SSR
  ;; production setting, and `re-frame.interop/debug-enabled?` reads it ONCE at
  ;; namespace-load time. Unless a lane sets it, no suite executes epoch's
  ;; production posture. Putting the property
  ;; in the alias makes it part of the LANE's definition rather than something a
  ;; job has to remember, and `re-frame.epoch-prod-gate-lane-pin-test` fails the
  ;; run if it ever stops arriving.
  ;;
  ;; WHAT `with-redefs` CAN AND CANNOT REACH — the precise gap, because the
  ;; imprecise version of this sentence is itself a hazard. Epoch reads the gate
  ;; only as `(when interop/debug-enabled? …)` INSIDE fn bodies, and that is a
  ;; runtime Var deref, so `epoch_jvm_prod_gate_test.clj`'s twelve `with-redefs`
  ;; deftests do genuinely exercise epoch's own gated branches. What a rebind
  ;; cannot reach is everything decided while the framework LOADED — top-level
  ;; registrations, `defonce` initialisation, and any interceptor composed once
  ;; at load — because by the time a `with-redefs` body runs, those decisions are
  ;; already made under the dev default. What that costs: a load-time decision
  ;; can fail every `dispatch-sync` under the documented gate while every
  ;; `with-redefs` deftest stays green. This lane closes that half.
  ;;
  ;; `-e :requires-debug` is core's DEV-ONLY DECLARATION, the same tag rather
  ;; than a second one invented beside it. One deftest in
  ;; `epoch_jvm_prod_gate_test.clj` asserts epoch's DEV parity — that the ring
  ;; fills — and
  ;; under a real load-time gate the ring is empty, so it must fail. Tagging is
  ;; right rather than a `(when interop/debug-enabled? …)` posture arm: an arm
  ;; would leave a deftest with no assertion at all, reporting GREEN for a run
  ;; that executed nothing, which is the false green this lane exists to close.
  ;; The tag is VAR-level, so a new deftest added to that namespace is UNTAGGED
  ;; and joins this lane by default.
  ;;
  ;; NOT THE WHOLE SUITE. The runnable roster lives in
  ;; `scripts/test-epoch-prod-gate.sh` as an EXCLUSION list. Do not invoke this
  ;; alias bare; run the script.
  :prod-gate
  {:jvm-opts  ["-Dre-frame.debug=false"]
   :main-opts ["-m" "re-frame.test-quiet.runner" "-e" ":requires-debug"]}

  ;; The release workflow replaces the core `:local/root` with its Maven
  ;; coordinate before Clein builds the published POM and jar.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-epoch
   :main     re-frame.epoch
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
