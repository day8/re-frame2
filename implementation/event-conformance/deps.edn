;; Cross-artefact conformance for the public event model. The suites exercise
;; one-form event registration, recordable coeffects, image-scoped dispatch,
;; reply delivery, and the always-on event/error channels against core's public
;; facade and runtime seams.
;;
;; This is a test-only artefact: it has no `src` and publishes no bundle. Core is
;; therefore a `:test` dependency, while `:extra-paths ["test"]` keeps the JVM
;; runner scoped to this tier. The same `.cljc` namespaces also run in the CLJS
;; node-test build configured by `implementation/shadow-cljs.edn`.
{:paths []
 :deps  {}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps  {day8/re-frame2 {:local/root "../core"}
                 day8/re-frame2-test-quiet {:local/root "../test-quiet"}
                 io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "re-frame.test-quiet.runner"]}}}
