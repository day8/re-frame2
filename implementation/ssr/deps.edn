;; Per Spec 011 the server-side rendering and hydration surface — the
;; pure hiccup → HTML emitter (`render-to-string`), the structural
;; render-tree hash (`render-tree-hash`), the `:rf/hydrate` event with
;; `:replace-frame-state` semantics, the `:rf.server/set-status` /
;; `:rf.server/set-header` / `:rf.server/append-header` /
;; `:rf.server/set-cookie` / `:rf.server/delete-cookie` /
;; `:rf.server/redirect` server-only fx family, the per-request HTTP
;; response accumulator (a framework-private side-channel atom keyed on
;; frame-id), the
;; `reg-error-projector` surface plus its built-in
;; `:rf.ssr/default-error-projector`, and the runtime's SSR error path
;; — ships as a separate Maven artefact so apps that don't render server-
;; side don't drag the namespace, the HTML emitter, the FNV-1a hash
;; machinery, the response-accumulator bookkeeping, the projector
;; registry kind, or any of the `:rf.ssr/*` / `:rf.server/*` trace
;; strings onto the classpath.
;;
;; (The `data-rf2-source-coord` / `data-rf-view` view annotations are NOT
;; part of this artefact — they are stamped at the core `reg-view`
;; registration boundary and merely serialised by the SSR emitter.)
;;
;; Consumers add this artefact alongside the core artefact:
;;
;;   {:deps {day8/re-frame2     {:mvn/version "..."}
;;           day8/re-frame2-ssr {:mvn/version "..."}}}
;;
;; And require `re-frame.ssr` in any namespace that calls
;; `rf/render-to-string`, `rf/render-tree-hash`, `rf/reg-error-projector`,
;; `rf/project-error`, dispatches `:rf/hydrate`, or relies on the
;; `:rf.server/*` fxs / the per-request response accumulator (read via
;; `re-frame.ssr/get-response`) — loading the namespace registers the
;; seven `:rf.server/*` fxs, the `:rf/hydrate` handler, and publishes the
;; late-bind hooks (`:ssr/render-tree-hash`) and the plain-atom adapter's
;; `:render-to-string` slot.
;;
;; Per Spec 006 §Adapter shipping convention, this artefact depends on
;; core; core never depends on this artefact. The cross-references
;; from core to ssr (`re-frame.core`'s `render-to-string` /
;; `render-tree-hash` / `reg-error-projector` / `project-error`
;; re-exports) flow through `re-frame.late-bind` exactly as the
;; schemas / machines / routing / flows / http hooks already do.
{:paths ["src"]
 :deps  {day8/re-frame2 {:local/root "../core"}}

 :aliases
 {:test {:extra-paths ["test"]
         ;; The ssr JVM tests' reset-runtime fixture touches
         ;; `re-frame.flows/flows` and `re-frame.schemas/schemas-by-frame`
         ;; AND reloads `re-frame.routing` / `re-frame.machines` so
         ;; their ns-load-time registrations resurrect after
         ;; `(registrar/clear-all!)`. The ssr_end_to_end test also
         ;; exercises the routing path (`:rf.error/no-such-route` →
         ;; default projector → 404). Pull schemas / flows / routing /
         ;; machines in as test-only deps so the fixture loads cleanly.
         ;; Mirrors the pattern in core/deps.edn, routing/deps.edn,
         ;; flows/deps.edn, and http/deps.edn. None of these is required
         ;; for production ssr builds.
         :extra-deps  {day8/re-frame2-schemas    {:local/root "../schemas"}
                       day8/re-frame2-flows      {:local/root "../flows"}
                       day8/re-frame2-routing    {:local/root "../routing"}
                       day8/re-frame2-machines   {:local/root "../machines"}
                       ;; TEST-ONLY (rf2-2mq2f): the Root Manifest v1
                       ;; subset-property suite drives the SHIPPED S1
                       ;; descriptor emitter
                       ;; (`re-frame.ui.compiler.root/root-descriptor`)
                       ;; rather than a hand-transcribed fixture, so
                       ;; "a manifest is a strict superset of a
                       ;; descriptor" is proven against the real
                       ;; compiler output. Production `re-frame.ssr`
                       ;; never `:require`s `re-frame.ui` — the manifest
                       ;; is pure data, and ui depends on core exactly
                       ;; as ssr does (no cycle). The CLJS half needs no
                       ;; wiring: `ui/src` is already on the shared
                       ;; :node-test source paths.
                       day8/re-frame2-ui         {:local/root "../ui"}
                       ;; Silent-on-success reporter.
                       day8/re-frame2-test-quiet {:local/root "../test-quiet"}}
         ;; The default PR/local gate excludes the heavy
         ;; `^:slow` / `^:stress` namespaces (here: the 2000-request
         ;; `ssr_teardown_load_test`). `re-frame.test-quiet.runner` passes
         ;; `-e` through verbatim to cognitect-test-runner, whose
         ;; `var-filter` drops any var whose metadata carries an excluded
         ;; keyword. Coverage is NOT lost: the `:slow-test` alias below
         ;; runs the excluded tests, and the nightly `expensive-tests.yml`
         ;; job + `scripts/test-rigorous-local.sh` invoke it.
         ;;
         ;; `-e :prod-gate` excludes the ONE namespace that is a statement
         ;; about the JVM it runs in rather than about SSR:
         ;; `re-frame.ssr-prod-gate-lane-pin-test` asserts unconditionally
         ;; that `-Dre-frame.debug=false` is on this JVM's command line. It
         ;; belongs to the `:prod-gate` lane below and is red anywhere else
         ;; BY DESIGN — a pin softened to "check the property if it is set"
         ;; would pass vacuously in exactly the case it exists to catch
         ;; (rf2-hnrwo). So `:test` + `:slow-test` + `:prod-gate` are the
         ;; three-way partition; every test still runs exactly once across
         ;; them.
         :main-opts   ["-m" "re-frame.test-quiet.runner"
                       "-e" ":slow" "-e" ":stress" "-e" ":prod-gate"]}

  ;; rf2-hnrwo — the PRODUCTION-GATE lane, as a MODIFIER composed onto
  ;; `:test`: `clojure -M:test:prod-gate`. `:extra-paths` / `:extra-deps`
  ;; merge in from `:test` (so the classpath cannot drift between the two
  ;; lanes), while `:jvm-opts` and `:main-opts` come from here —
  ;; `:main-opts` is last-wins in tools.deps, which is what lets this alias
  ;; drop `-e :prod-gate` and pick the pin up.
  ;;
  ;; WHY THE FLAG LIVES IN `:jvm-opts` AND NOT ON A COMMAND LINE. SECURITY.md
  ;; documents `-Dre-frame.debug=false` as the JVM/SSR production setting, and
  ;; `re-frame.interop/debug-enabled?` reads it ONCE at namespace-load time.
  ;; SSR is the artefact where that matters most literally — it is the one
  ;; that RUNS on a JVM in production — and yet nothing in CI had ever set the
  ;; property here, so the documented server posture was executed by no suite
  ;; anywhere. That is the hole rf2-9c2jf came through in core: every suite
  ;; calling itself a "production gate" test rebinds the Var with
  ;; `with-redefs` AFTER the framework has loaded, and a load-time gate is
  ;; invisible to that. Putting the property in the alias makes it part of the
  ;; LANE's definition rather than something a job has to remember, and
  ;; `re-frame.ssr-prod-gate-lane-pin-test` fails the run if it ever stops
  ;; arriving.
  ;;
  ;; WHY SSR SPECIFICALLY. rf2-u2x6w established that sub-classification — a
  ;; PRIVACY invariant — genuinely egresses in production through
  ;; `re-frame.ssr.payload-policy/project-routing-egress`, which decides what
  ;; leaves the server inside a hydration payload. That egress ran under no
  ;; gate at all until this lane existed.
  ;;
  ;; NOT THE WHOLE SUITE, YET. Under the real gate a documented slice of this
  ;; artefact's test namespaces is red, essentially all of it asserting dev
  ;; instrumentation (`:rf.ssr/*` traces, the `:errors` sink, source coords,
  ;; `data-rf2-source-coord` attributes) inline with semantics. Those are
  ;; legitimate dev-posture tests, not defects. The runnable roster lives in
  ;; `scripts/test-ssr-prod-gate.sh`, which appends `-n` selectors for every
  ;; namespace MINUS a documented known-red list, so a NEW namespace joins the
  ;; lane by default. Do not invoke this alias bare; run the script.
  :prod-gate
  {:jvm-opts  ["-Dre-frame.debug=false"]
   :main-opts ["-m" "re-frame.test-quiet.runner" "-e" ":slow" "-e" ":stress"]}

  ;; Nightly/rigorous slow-test gate. Includes only the
  ;; `^:slow` / `^:stress` tests (the `-i` union the default `:test`
  ;; alias excludes), so the default `:test` run plus this `:slow-test`
  ;; run together cover every test exactly once. Invoked by the nightly
  ;; `.github/workflows/expensive-tests.yml` job and the local
  ;; `scripts/test-rigorous-local.sh` sweep.
  :slow-test
  {:extra-paths ["test"]
   :extra-deps  {day8/re-frame2-schemas    {:local/root "../schemas"}
                 day8/re-frame2-flows      {:local/root "../flows"}
                 day8/re-frame2-routing    {:local/root "../routing"}
                 day8/re-frame2-machines   {:local/root "../machines"}
                 ;; TEST-ONLY (rf2-2mq2f): the Root Manifest v1
                 ;; subset-property suite (`emit_ui_tree_cljs_test`)
                 ;; `:require`s `re-frame.ui.rules`. cognitect
                 ;; test-runner LOADS every test namespace at discovery
                 ;; time before filtering by var metadata, so ui must be
                 ;; on the classpath here too — matching the `:test`
                 ;; alias above. Without it the nightly `:slow-test` run
                 ;; dies at load with a FileNotFoundException for
                 ;; `re_frame/ui/rules`.
                 day8/re-frame2-ui         {:local/root "../ui"}
                 day8/re-frame2-test-quiet {:local/root "../test-quiet"}}
   :main-opts   ["-m" "re-frame.test-quiet.runner" "-i" ":slow" "-i" ":stress"]}

  ;; Clojars deployment.
  ;; The release workflow runs `clojure -M:clein deploy` from this
  ;; artefact's directory, which builds pom + jar and pushes to Clojars.
  ;;
  ;; IMPORTANT: when this artefact is published, the `day8/re-frame2`
  ;; core dep above is replaced by an :mvn/version coordinate — clein
  ;; reads :deps and writes them into pom.xml, and a :local/root entry
  ;; would resolve to nothing for downstream consumers. The release
  ;; workflow swaps :local/root → :mvn/version before invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-ssr
   :main     re-frame.ssr
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
