;; day8/re-frame2-routing is the optional routing artefact.
;;
;; Per Spec 012 §Routing the route grammar (`reg-route`,
;; `:rf.route/navigate`, `:rf.route/transitioned`, `:rf.route/url-requested`,
;; `:rf.route/handle-url-change`, `:rf.route/continue` /
;; `:rf.route/cancel`, the `:rf.nav/push-url` / `:rf.nav/replace-url` /
;; `:rf.nav/scroll` / `:rf.nav/capture-scroll` fxs, `match-url` /
;; `route-url`, the `:rf/route` /
;; `:rf.route/{id,params,query,transition,error,fragment,chain}` and
;; `:rf/pending-navigation` framework subs, and routing runtime-db state)
;; ships as a separate Maven artefact so apps that don't register routes don't
;; drag in the namespace, route-rank / pattern-compile / nav-token machinery,
;; or any of the `:rf.route/*` and `:rf.nav/*` trace strings onto the
;; classpath.
;;
;; Runtime routing state is rooted at `[:rf.runtime/routing]`. It contains
;; `:current`, `:pending-navigation` when a guard blocks, and may contain
;; resource-integration bookkeeping while the resources artefact is loaded.
;; Scroll positions and allocator high-water marks are host-side transient
;; caches keyed by frame id, not runtime-db state.
;;
;; Consumers add this artefact alongside the core artefact:
;;
;;   {:deps {day8/re-frame2         {:mvn/version "..."}
;;           day8/re-frame2-routing {:mvn/version "..."}}}
;;
;; And require `re-frame.routing` in any namespace that calls
;; `rf/reg-route` or relies on the `:rf/route` framework sub /
;; `:rf.nav/*` fxs — loading the namespace registers its late-bind
;; hooks, the `:rf.route/*` events, the `:rf.nav/*` reserved fxs, and
;; the `:rf/route` reg-sub family.
;;
;; Per Spec 006 §Adapter shipping convention, this artefact depends on
;; core; core never depends on this artefact. The cross-references
;; from core to routing (e.g. `re-frame.core`'s `reg-route` /
;; `match-url` / `route-url` re-exports, the `:rf/route` reg-sub) flow
;; through `re-frame.late-bind` exactly as the schemas / machines hooks
;; already do.
{:paths ["src"]
 :deps  {day8/re-frame2 {:local/root "../core"}}

 :aliases
 {:test {:extra-paths ["test"]
         ;; The routing JVM test's reset-runtime fixture touches
         ;; `re-frame.schemas/schemas-by-frame` and `re-frame.flows/flows`
         ;; AND reloads `re-frame.ssr` so its ns-load-time
         ;; registrations resurrect after `(registrar/clear-all!)`
         ;; (the reset matrix is defensive; none of these artefacts is
         ;; required in production routing builds, but all are exercised
         ;; during development). Pull schemas / flows / ssr in as
         ;; test-only deps so the fixture loads cleanly. Mirrors the
         ;; pattern in core/deps.edn.
         :extra-deps  {day8/re-frame2-schemas    {:local/root "../schemas"}
                       day8/re-frame2-flows      {:local/root "../flows"}
                       day8/re-frame2-ssr        {:local/root "../ssr"}
                       ;; Silent-on-success test reporter.
                       day8/re-frame2-test-quiet {:local/root "../test-quiet"}}
         ;; The default PR/local gate excludes the heavy
         ;; `^:stress` tests in `routing_concurrency_stress_test`
         ;; (5000-iter × 8-thread cross-frame nav). These were tagged
         ;; `^:stress`; the runner passes `-e` through to
         ;; cognitect-test-runner verbatim. Coverage is NOT lost: the
         ;; `:slow-test` alias below runs them, invoked by the nightly
         ;; `expensive-tests.yml` job + `scripts/test-rigorous-local.sh`.
         ;;
         ;; `-e :prod-gate` excludes the ONE namespace that is a statement
         ;; about the JVM it runs in rather than about routing:
         ;; `re-frame.routing-prod-gate-lane-pin-test` asserts
         ;; unconditionally that `-Dre-frame.debug=false` is on this JVM's
         ;; command line. It belongs to the `:prod-gate` lane below and is
         ;; red anywhere else BY DESIGN — a pin softened to "check the
         ;; property if it is set" would pass vacuously in exactly the case
         ;; it exists to catch (rf2-hnrwo). So `:test` + `:slow-test` +
         ;; `:prod-gate` are the three-way partition; every test still runs
         ;; exactly once across them.
         :main-opts   ["-m" "re-frame.test-quiet.runner"
                       "-e" ":slow" "-e" ":stress" "-e" ":prod-gate"]}

  ;; rf2-hnrwo — the PRODUCTION-GATE lane, as a MODIFIER composed onto
  ;; `:test`: `clojure -M:test:prod-gate`. `:extra-paths` / `:extra-deps`
  ;; merge in from `:test` (so the classpath cannot drift between the two
  ;; lanes), while `:jvm-opts` and `:main-opts` come from here —
  ;; `:main-opts` is last-wins in tools.deps, which is what lets this alias
  ;; drop `-e :prod-gate` and pick the pin up.
  ;;
  ;; WHY THE FLAG LIVES IN `:jvm-opts` AND NOT ON A COMMAND LINE. SECURITY.md
  ;; documents `-Dre-frame.debug=false` as the JVM/SSR production setting, and
  ;; `re-frame.interop/debug-enabled?` reads it ONCE at namespace-load time.
  ;; Nothing in CI ever set it for this artefact, so routing's production
  ;; posture was executed by no suite anywhere — the same hole that let
  ;; rf2-9c2jf (dispatch-sync a total no-op under the gate) stay green in
  ;; core. Every suite that calls itself a "production gate" test rebinds the
  ;; Var with `with-redefs` AFTER the framework has loaded, and a load-time
  ;; gate is invisible to that. Putting the property in the alias makes it
  ;; part of the LANE's definition rather than something a job has to
  ;; remember, and `re-frame.routing-prod-gate-lane-pin-test` fails the run if
  ;; it ever stops arriving.
  ;;
  ;; WHY ROUTING SPECIFICALLY. rf2-u2x6w established that sub-classification —
  ;; a PRIVACY invariant — genuinely egresses in production from routing's
  ;; `:routing/route-sub-egress-path`. That egress ran under no gate at all
  ;; until this lane existed.
  ;;
  ;; NOT THE WHOLE SUITE, YET. Under the real gate a documented slice of this
  ;; artefact's test namespaces is red, essentially all of it asserting dev
  ;; instrumentation (`:rf.route/*` traces, the `:errors` sink, source coords)
  ;; inline with semantics. Those are legitimate dev-posture tests, not
  ;; defects. The runnable roster lives in
  ;; `scripts/test-routing-prod-gate.sh`, which appends `-n` selectors for
  ;; every namespace MINUS a documented known-red list, so a NEW namespace
  ;; joins the lane by default. Do not invoke this alias bare; run the script.
  :prod-gate
  {:jvm-opts  ["-Dre-frame.debug=false"]
   :main-opts ["-m" "re-frame.test-quiet.runner" "-e" ":slow" "-e" ":stress"]}

  ;; Nightly/rigorous gate. Includes only the
  ;; `^:slow` / `^:stress` tests, so `:test` + `:slow-test` together cover
  ;; every test once.
  :slow-test
  {:extra-paths ["test"]
   :extra-deps  {day8/re-frame2-schemas    {:local/root "../schemas"}
                 day8/re-frame2-flows      {:local/root "../flows"}
                 day8/re-frame2-ssr        {:local/root "../ssr"}
                 day8/re-frame2-test-quiet {:local/root "../test-quiet"}}
   :main-opts   ["-m" "re-frame.test-quiet.runner" "-i" ":slow" "-i" ":stress"]}

  ;; Clojars deploy. Modeled on re-frame v1's release flow.
  ;; The release workflow runs `clojure -M:clein deploy` from this
  ;; artefact's directory, which builds pom + jar and pushes to Clojars.
  ;;
  ;; IMPORTANT: when this artefact is published, the `day8/re-frame2`
  ;; core dep above is replaced by an :mvn/version coordinate — clein
  ;; reads :deps and writes them into pom.xml, and a :local/root entry
  ;; would resolve to nothing for downstream consumers. The release
  ;; workflow swaps :local/root → :mvn/version before invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-routing
   :main     re-frame.routing
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src"]}}}
