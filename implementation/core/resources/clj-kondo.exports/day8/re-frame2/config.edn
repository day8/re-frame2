;; clj-kondo export for day8/re-frame2: macro-shape analysis only.
;;
;; A consumer picks this up with clj-kondo's ordinary dependency import —
;; nothing here is re-frame2-specific plumbing:
;;
;;   clj-kondo --lint "$(clojure -Spath)" --dependencies --copy-configs
;;
;; which copies this directory into the consumer's `.clj-kondo/`, where
;; clj-kondo loads it. See README.md beside this file.
;;
;; The re-frame2 reg-* macros emit a defmacro under `re-frame.core` (see
;; `core_reg_macros.cljc` → `defreg-macro` / `defreg-event-macro`). Each
;; user-facing reg-* macro takes the shape `(reg-foo :id ... body)` — a
;; registration call, written at top level or inside a fn body, that lints
;; as an ordinary call (see `:lint-as` below). `reg-view` is the outlier
;; (`(reg-view sym [args] body)`) and a hook rewrites it to `defn`.
;; No custom findings ship: every entry gives a macro its shape, so kondo's
;; ordinary analysis applies.
{:linters
 {;; `:unresolved-var` exclusions — exactly the macros `re-frame.core`
  ;; defines through the `defreg-macro` / `defreg-event-macro` meta-macros
  ;; (see `core_reg_macros.cljc`). kondo can't trace a macro-defining macro,
  ;; so in a `.clj` / `.cljc` consumer those Vars read as unresolved; a
  ;; `.cljs` consumer resolves them through the facade's same-named CLJS
  ;; value aliases. Every other `re-frame.core` name resolves unlisted —
  ;; `reg-machine`, `defmachine` and `reg-view` are plain `defmacro`s, the
  ;; retired `reg-event-db` / `-fx` / `-ctx` are `def`s — and an entry naming
  ;; a Var that does not exist would hide a real `Unresolved var`.
  ;; `re-frame.kondo-export-test` pins this list to that macro set.
  :unresolved-var
  {:exclude [re-frame.core/reg-event
             re-frame.core/reg-sub
             re-frame.core/reg-fx
             re-frame.core/reg-cofx
             re-frame.core/reg-interceptor
             re-frame.core/reg-flow
             re-frame.core/reg-route
             re-frame.core/reg-resource
             re-frame.core/reg-mutation
             re-frame.core/reg-resource-scope
             re-frame.core/reg-app-schema
             re-frame.core/reg-app-schemas
             re-frame.core/reg-error-projector
             re-frame.core/reg-head
             re-frame.core/reg-http-interceptor
             re-frame.core/reg-classification
             re-frame.core/reg-state]}}

 :lint-as
 {;; Core registration macros — `(reg-foo :id ... body)` is a
  ;; *registration* call (handler installed in the registrar by side
  ;; effect), NOT a `def` introducing a Var — and they need no entry. With
  ;; no entry, clj-kondo lints each call as an ordinary
  ;; call: every argument is an expression, the handler fn gets full
  ;; lexical-binding analysis, and a registration inside a fn body or a
  ;; `let` (a deferred `install!`) draws no finding of its own. A `do` shape, by
  ;; `:lint-as` or by hook, reports `redundant do` or `Unused value` there.

  ;; `defmachine` is `(defmachine name [doc] spec)` — a
  ;; `def`-shaped wrapper that introduces a Var holding the (source-
  ;; stamped) machine-spec value. Unlike the `reg-*` family it really IS
  ;; a top-level def, so it lints-as `clojure.core/def` (name resolved as
  ;; a Var, optional docstring + body expression analysed).
  re-frame.core/defmachine          clojure.core/def}

 ;; `reg-view` is `(reg-view sym [args] body)` — defn-shape, but the
 ;; macro auto-injects `dispatch` / `subscribe` into the body, which
 ;; lint-as wouldn't surface, so a hook declares them.
 ;;
 ;; `with-frame` and `with-new-frame` are siblings:
 ;; `(with-frame :keyword body+)` is pin-form (`do`-shape with leading
 ;; keyword), and `(with-new-frame [sym expr] body+)` is eval-bind-
 ;; run-destroy (`let`-shape). Their hooks make both parse cleanly and
 ;; the binding-vector case surface the lexical `sym`.
 ;;
 ;; `re-frame.test-support/with-trace-recorder!` is `let`-shaped over its
 ;; recorder symbol, and ships in this artefact beside the others.
 ;;
 ;; The hook code is `hooks/re_frame/core.clj` beside this file.
 :hooks
 {:analyze-call
  {re-frame.core/reg-view                       hooks.re-frame.core/reg-view
   re-frame.core/with-frame                     hooks.re-frame.core/with-frame
   re-frame.core/with-new-frame                 hooks.re-frame.core/with-new-frame
   re-frame.test-support/with-trace-recorder!   hooks.re-frame.core/with-trace-recorder!}}}
