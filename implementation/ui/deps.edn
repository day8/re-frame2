;; day8/re-frame2-ui — the compiled-view substrate artefact (epic
;; rf2-vxgfnd; the ratified re-frame.ui program, 08 §5 R-1..R-6).
;;
;; S1a (rf2-vxgfnd.1): artefact shape + classpath wiring.
;; S1b (rf2-vxgfnd.2): the compiler slice — template analyzer + CLJS
;; emitter (direct jsx) + JVM emitter (node-schema-v1 trees) + the
;; conversion rule table + fingerprints.
;; S1c (rf2-vxgfnd.3): root identity + the mount surface — Root
;; Descriptor v1 (:rf.root/schema-version 1), mount / create-root /
;; render! / hydrate-root / unmount! / frame-root plan extraction,
;; Layer-1 (build) + Layer-3 (client live-root registry) duplicate
;; detection. `re-frame.ui.test` (in-artefact, dev/test scope) lands
;; S1d.
;;
;; Per the program plan the compiler namespaces are `.cljc` — they run
;; on the JVM during CLJS compilation (and for JVM-tree emission, later
;; consumed by the ssr artefact) — and the client kernel is `.cljs`.
;;
;; NO :clein deploy aliases yet — deliberate, not an omission. The
;; version-lockstep gate (.github/scripts/verify-version-lockstep.sh)
;; requires every implementation/*/deps.edn carrying a :clein/build
;; alias to appear in its ARTEFACTS inventory AND the release.yml deploy
;; matrix. This artefact is pre-publication (nothing to deploy until the
;; substrate is real), so the publishing wiring lands with the stage
;; that first publishes it.
{:paths ["src"]
 :deps  {day8/re-frame2 {:local/root "../core"}}

 :aliases
 {:test {:extra-paths ["test"
                       ;; rf2-vxgfnd.95.9 — the S3 ergonomic-proof native views
                       ;; (realworld-resources.ui-editor / ui-counter /
                       ;; ui-dashboard, all `.cljc`) live in the example tree but
                       ;; are exercised by the Tier-1 structural coherence test in
                       ;; this artefact's `test/`. Listing the examples path here
                       ;; only widens the JVM classpath so those view namespaces
                       ;; RESOLVE — the cognitect runner still discovers tests in
                       ;; `test/` alone, and the views require nothing but
                       ;; `re-frame.ui` / `re-frame.core` (no `.cljs` example
                       ;; sources are loaded on the JVM). Examples stay test-free.
                       "../../examples/real-apps"]
         :extra-deps  {day8/re-frame2-test-quiet {:local/root "../test-quiet"}
                       ;; TEST-ONLY: the compiled `ui/route-link` defview
                       ;; (rf2-vxgfnd.95.5) consumes the routing-owned
                       ;; `:routing/link-model` / `:routing/activate-link!`
                       ;; late-bound seam. The integration tests
                       ;; (route_link_*_test) load routing to publish those hooks
                       ;; and exercise the anchor + click law end-to-end.
                       ;; Production `re-frame.ui` never `:require`s routing —
                       ;; the seam is reached through core's late-bind registry
                       ;; (`ui -> core late-bind <- routing`, no cycle).
                       day8/re-frame2-routing   {:local/root "../routing"}}
         :main-opts   ["-m" "re-frame.test-quiet.runner"]}}}
