;; Ring host adapter for re-frame2 SSR. It creates a server frame per
;; request, makes the Ring request available before the synchronous initial
;; event drain, renders or redirects from the resolved response accumulator,
;; materialises headers and cookies, and always tears the frame down.
;;
;; Consumers add this artefact alongside core and ssr:
;;
;;   {:deps {day8/re-frame2          {:mvn/version "..."}
;;           day8/re-frame2-ssr      {:mvn/version "..."}
;;           day8/re-frame2-ssr-ring {:mvn/version "..."}}}
;;
;; And require `re-frame.ssr.ring` in any namespace that wires the
;; runtime up to a Ring server (Jetty, HttpKit, Pedestal, Reitit-ring).
;;
;; Per Spec 006 §Adapter shipping convention, this optional artefact depends
;; on core and SSR; neither depends on it.
;;
;; `resources/` is on `:paths` for a `:local/root` consumer and on `:src-dirs`
;; for the jar, and carries two things:
;;
;;   - `re_frame/ssr_host.edn`, the marker that makes a JVM with this artefact
;;     on its classpath an SSR host, so the debug gate defaults OFF there
;;     (Spec 011 §The debug gate on an SSR JVM). The two test aliases below
;;     opt back in with `-Dre-frame.debug=true`.
;;   - `re_frame/ssr_node/`, the Node render sidecar's runtime, which
;;     `re-frame.ssr.ring.node/renderer` launches under `:module`. It is a
;;     copy of implementation/ssr-node's `bin/` and `src/`, pinned byte for
;;     byte by that package's own suite (`test/absence.test.cjs`): a copy
;;     inside this directory is the one arrangement both of the routes above
;;     carry unchanged, since clein copies each `:src-dirs` entry to the jar
;;     root and a `:paths` entry outside the project is deprecated.
{:paths ["src" "resources"]
 :deps  {day8/re-frame2     {:local/root "../core"}
         day8/re-frame2-ssr {:local/root "../ssr"}
         ;; The JVM->Node adapter (`re-frame.ssr.ring.node`) speaks JSON to
         ;; the bounded Node render sidecar. This is ssr-ring's ONE dependency
         ;; beyond core and ssr — first-party, with no transitive deps.
         org.clojure/data.json {:mvn/version "2.5.1"}}

 :aliases
 {:test {;; The local fixture combines core's public reset fixture with the
         ;; SSR per-request side-channel resets available through the
         ;; production SSR dependency.
         ;;
         ;; The two `../../examples` roots are the login arm's JVM host
         ;; witness (`login_host_crossing_test.clj`): it
         ;; requires `fresco.login.host` (examples/substrates) which
         ;; requires the shared `login.model` (examples/core). Loading the
         ;; namespace is half the witness — without it, a compile error in
         ;; that host would pass every gate silently. Same shape as
         ;; implementation/core/deps.edn's `:test`, which puts the example
         ;; buckets on the classpath for `re-frame.examples-test`.
         :extra-paths ["test"
                       "../../examples/core"
                       "../../examples/substrates"]
         ;; Mirrors implementation/ssr/deps.edn :test alias — schemas /
         ;; flows / routing / machines load at ns-load time and the
         ;; reset-runtime fixture reloads them after registrar/clear-all!.
         :extra-deps  {day8/re-frame2-schemas    {:local/root "../schemas"}
                       day8/re-frame2-flows      {:local/root "../flows"}
                       day8/re-frame2-routing    {:local/root "../routing"}
                       day8/re-frame2-machines   {:local/root "../machines"}
                       ;; `login.model` turns on managed HTTP and its
                       ;; stub transport (the example's demo backend).
                       day8/re-frame2-http       {:local/root "../http"}
                       ;; Resource payload tests require the optional hooks
                       ;; without adding them to the published adapter.
                       day8/re-frame2-resources  {:local/root "../resources"}
                       ;; Silent-on-success reporter.
                       day8/re-frame2-test-quiet {:local/root "../test-quiet"}
                       ;; End-to-end tests observe bytes through a real Jetty
                       ;; host. These test dependencies are not published.
                       ring/ring-jetty-adapter {:mvn/version "1.12.1"}}
         ;; Dev posture: this artefact on the classpath defaults the debug
         ;; gate OFF, and the suite reads traces.
         :jvm-opts    ["-Dre-frame.debug=true"]
         ;; The default gate excludes the JVM->Node->JVM crossing witness
         ;; (`:crossing`, which spawns a Node sidecar — this alias stays
         ;; Node-free); `:crossing-test` below runs exactly that set.
         :main-opts   ["-m" "re-frame.test-quiet.runner" "--dir" "test"
                       "-e" ":crossing"]}

  ;; The JVM->Node->JVM crossing witness: only the tests
  ;; tagged `:crossing`. Each has a renderer launch the sidecar this
  ;; artefact carries on a plain fixture render module (test/fixtures/node/),
  ;; so Node 24 must be on PATH. CI runs it as its own job
  ;; (`jvm-node-crossing` in .github/workflows/test.yml); the default `:test`
  ;; alias never touches Node.
  :crossing-test
  {:extra-paths ["test"
                 ;; The login arm's JVM host and the model it holds — the
                 ;; product half of the crossing.
                 "../../examples/core"
                 "../../examples/substrates"]
   :extra-deps  {day8/re-frame2-schemas    {:local/root "../schemas"}
                 day8/re-frame2-flows      {:local/root "../flows"}
                 day8/re-frame2-routing    {:local/root "../routing"}
                 day8/re-frame2-machines   {:local/root "../machines"}
                 day8/re-frame2-http       {:local/root "../http"}
                 day8/re-frame2-resources  {:local/root "../resources"}
                 day8/re-frame2-test-quiet {:local/root "../test-quiet"}
                 ring/ring-jetty-adapter {:mvn/version "1.12.1"}}
   :jvm-opts    ["-Dre-frame.debug=true"]
   :main-opts   ["-m" "re-frame.test-quiet.runner" "--dir" "test"
                 "-i" ":crossing"]}

  ;; Clojars deployment.
  ;; The release workflow swaps :local/root → :mvn/version before
  ;; invoking clein.
  :clein {:extra-deps {io.github.noahtheduke/clein
                       {:git/url "https://github.com/day8/clein.git"
                        :git/sha "2b83503246e8291fc023d688574640a9b23d8c50"}}
          :main-opts  ["-m" "noahtheduke.clein"]}

  :clein/build
  {:lib      day8/re-frame2-ssr-ring
   :main     re-frame.ssr.ring
   :url      "https://github.com/day8/re-frame2"
   :version  "../../VERSION"
   :license  {:name "MIT"
              :url  "https://opensource.org/licenses/MIT"}
   :src-dirs ["src" "resources"]}}}
