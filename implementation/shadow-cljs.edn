    :machines-tooling  {:init-fn re-frame.bundle-isolation-positive-control.machines-tooling/run
                        :depends-on #{:trace-tooling}}
    :derivation-graph  {:init-fn re-frame.bundle-isolation-positive-control.derivation-graph/run
                        :depends-on #{:subs-tooling}}
    :derivation-egress {:init-fn re-frame.bundle-isolation-positive-control.derivation-egress/run
                        :depends-on #{:trace-tooling}}
    :trace-cascade     {:init-fn re-frame.bundle-isolation-positive-control.trace-cascade/run
