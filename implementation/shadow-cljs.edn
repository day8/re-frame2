  ;; ============================================================================
  ;; Example apps (rf2-lyj0).
  ;;
  ;; Each example compiles into out/examples/<name>/ and is paired with a
  ;; hand-written examples/<substrate>/<name>/index.html host page that loads
  ;; main.js from the same directory. The serve-and-run-examples script
  ;; builds the site layout, serves it, and runs the Playwright specs that
  ;; sit alongside each example (examples/<substrate>/<name>/<name>.spec.cjs,
  ;; plus the per-task 7GUIs sub-folders under examples/reagent/seven_guis/).
  ;;
  ;; :asset-path is "." so the bundle's runtime resolves siblings (cljs_base,
  ;; cljs-runtime, etc.) relative to the page rather than the document root —
  ;; necessary because each example is served from its own subdirectory.
  ;; ============================================================================

  :examples/counter
  {:target     :browser
   :output-dir "out/examples/counter"
   :asset-path "."
   ;; goog.DEBUG=false is pinned for RELEASE ONLY, not shared
   ;; :compiler-options. The bundle-isolation gate greps the `release`
   ;; counter bundle (scripts/check-bundle-isolation.cjs, out/examples/
   ;; counter) and wants goog.DEBUG=false explicit there, matching the
   ;; sibling :bundle-isolation-positive-control build. But the SAME
   ;; build also serves the Xray feature browser gate
   ;; (scripts/serve-and-run-xray-feature-gate.cjs), which compiles it in
   ;; `compile`/dev with the :devtools Xray preload below and needs
   ;; goog.DEBUG at its dev default (true) so Xray's dev instrumentation
   ;; is NOT elided and the shell mounts. Pinning goog.DEBUG=false in the
   ;; shared :compiler-options leaked into that dev compile and elided
   ;; Xray, so the counter smoke scenarios could not open the shell —
   ;; scoping it to :release keeps both gates green. (release always
   ;; defaults goog.DEBUG=false, so this stays explicit, never weaker.)
   :release    {:compiler-options {:closure-defines {goog.DEBUG false}}}
   :modules    {:main {:init-fn counter.core/run}}
   ;; Xray Phase 1 smoke (rf2-n6x4q). Pulling the preload here is the
   ;; convention-anchoring path standing rule: every Phase-2+ panel
   ;; bead inherits this entry. The preload is dev-only — the
   ;; `:devtools` block is honoured by `shadow-cljs watch` /
   ;; `compile` but NOT by `release` (per shadow-cljs's docs on the
   ;; :devtools key), so the per-example Playwright spec running
   ;; against `release` builds remains unaffected.
   :devtools   {:preloads [day8.re-frame2-xray.preload]}}

  ;; rf2-5lbx — counter mounted on day8/reagent-slim (the rewrite),
  ;; same six-domino logic as :examples/counter but every Reagent
  ;; import points at reagent2.* and rf/init! receives the slim
  ;; adapter Var. The Reagent Slim bundle-isolation contract from the
  ;; reagent-slim IMPL-SPEC (§1.4, §1.8, §12.3, S3-008) binds here:
  ;;
  ;;   - The :advanced bundle for this build must contain NO
  ;;     `reagent.impl.*` symbols (the bridge's stock-Reagent
  ;;     internals must not leak in).
  ;;   - The bundle must contain NO `react-dom/server` symbols
  ;;     (slim's render-to-static-markup is pure-CLJS).
  ;;
  ;; The grep that enforces both invariants lives at
  ;; scripts/check-reagent-slim-bundle-isolation.cjs; the corresponding
  ;; CI job is `cljs-reagent-slim-bundle-isolation` in .github/workflows/test.yml.
  ;;
  ;; The `:init-fn` is the gate-owned entrypoint
  ;; `reagent-slim.counter.bundle-isolation-entry/run` — NOT the teaching
  ;; `reagent-slim.counter.core/run`. The entry boots the same app and
  ;; additionally exercises the pure-CLJS `render-to-static-markup` path so
  ;; Contract 4 (S3-005 non-vacuity) has signal; keeping the fixture behind
  ;; this entry leaves the teaching `core` namespace free of harness plumbing
  ;; (rf2-vyl0vt). A reader watches `core/run`; the gate compiles via the entry.
  :examples/counter-slim-and-fast
  {:target     :browser
   :output-dir "out/examples/counter-slim-and-fast"
   :asset-path "."
   :modules    {:main {:init-fn reagent-slim.counter.bundle-isolation-entry/run}}}

