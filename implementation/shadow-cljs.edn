  :ui-bench
  {:target    :node-script
   :main      re-frame.ui.bench.main/-main
   :output-to "out/ui-bench.js"
   ;; The load-bearing pass hook is inherited from :build-defaults.
   :compiler-options {:optimizations :advanced
                      :infer-externs :auto}}

