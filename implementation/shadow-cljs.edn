   ;; probe this dev testbed's live runtime alongside Xray.
   :devtools   {:preloads [re-frame2-pair.runtime
                           day8.re-frame2-xray.preload]}}

  ;; ============================================================================
  ;; Per-adapter testbeds (rf2-eceuv).
  ;;
  ;; Per Mike's directive ("examples are for humans, not smoke tests")
  ;; each adapter (Reagent / UIx / Helix) ships a dedicated standalone
  ;; smoke fixture under implementation/adapters/<name>/testbed/. Each is
  ;; a minimal counter that proves the adapter wires up — mount,
  ;; subscribe, dispatch, re-render — without depending on any example.
  ;;
  ;; The orchestrator (implementation/adapters/scripts/serve-and-run-adapter-smokes.cjs)
  ;; stages each bundle into out/examples/adapter-testbeds/<name>/ next
  ;; to the testbed's hand-written index.html and the companion spec.cjs
  ;; (discovered by the runner via ADAPTER_SMOKE_SPEC_ROOTS).
  ;; ============================================================================

  ;; rf2-54jz4 — re-frame2-pair.runtime preload added so pair-MCP can
  ;; probe each adapter testbed's live runtime. These are dev-only
  ;; smoke fixtures (the browser smoke runs them under
  ;; `shadow-cljs compile`); `:devtools` preloads DCE from `release`
  ;; builds so this never reaches a production bundle.
  :adapters/reagent-testbed
  {:target     :browser
   :output-dir "out/examples/adapter-testbeds/reagent"
   :asset-path "."
   :modules    {:main {:init-fn adapter-testbed-reagent.core/init}}
   :devtools   {:preloads [re-frame2-pair.runtime]}}

  :adapters/uix-testbed
  {:target     :browser
   :output-dir "out/examples/adapter-testbeds/uix"
   :asset-path "."
   :modules    {:main {:init-fn adapter-testbed-uix.core/init}}
   :devtools   {:preloads [re-frame2-pair.runtime]}}

  :adapters/helix-testbed
  {:target     :browser
   :output-dir "out/examples/adapter-testbeds/helix"
   :asset-path "."
   :modules    {:main {:init-fn adapter-testbed-helix.core/init}}
   :devtools   {:preloads [re-frame2-pair.runtime]}}

  ;; rf2-xsgu8a — per-adapter CLIENT-RUNTIME smoke for the day8/reagent-slim
  ;; substrate. Same minimal-counter shape as the Reagent/UIx/Helix
  ;; testbeds above, but every Reagent import points at reagent2.* and
  ;; rf/init! receives the slim adapter Var (init value 5; inc + dec). It
  ;; proves the slim mount/inject/click path end-to-end in a browser — the
  ;; layer the rf2-xsgu8a review found uncovered (the slim example's prior
  ;; browser coverage was compile-only + the release-bundle sentinel grep).
  ;;
  ;; Deliberately NOT in the shared adapter-smoke manifest
  ;; (implementation/adapters/scripts/adapter-smoke-filter.cjs): it is the slim adapter's OWN
  ;; gate, driven by scripts/serve-and-run-reagent-slim-smoke.cjs (npm
  ;; test:reagent-slim:smoke) — mirroring how the slim bundle-isolation
  ;; contract ships its own check-reagent-slim-bundle-isolation.cjs rather
  ;; than folding into the shared check-bundle-isolation.cjs.
  :adapters/reagent-slim-testbed
  {:target     :browser
   :output-dir "out/examples/adapter-testbeds/reagent-slim"
   :asset-path "."
   :modules    {:main {:init-fn adapter-testbed-reagent-slim.core/init}}
   :devtools   {:preloads [re-frame2-pair.runtime]}}

  ;; ============================================================================
  ;; Machines-Viz read-only viewer (rf2-8wrzz.2 — wires PR #2013's viewer
  ;; entry into an emittable bundle).
  ;;
  ;; tools/machines-viz/public/viewer.html is a statically-hostable single
  ;; page that decodes a `#machine=<base64url>` URL fragment and renders the
  ;; encoded chart read-only (per tools/machines-viz/spec/API.md §Read-only
  ;; viewer). It loads a sibling `viewer.js` via `<script src="viewer.js">`
  ;; and then calls `window.day8.re_frame2_machines_viz.viewer.run()` itself,
  ;; so this build only needs to COMPILE the entry ns and preserve its
  ;; `^:export run` symbol — NOT auto-invoke an :init-fn (that would double-
  ;; render). The single `:viewer` module emits `viewer.js`; co-locate it
  ;; with viewer.html at serve/release time (same staging pattern as the
  ;; examples, whose hand-written index.html lives in the source tree and is
  ;; placed next to the bundle by the orchestrator).
  ;;
  ;; Bundle-isolation holds: machines-viz is a tool jar, so emitting a tool
  ;; bundle from this consumer build introduces no production-bundle leak
  ;; (nothing under implementation/ :requires the viewer ns).
  :machines-viz-viewer
  {:target     :browser
   :output-dir "out/machines-viz-viewer"
   :asset-path "."
   :modules    {:viewer {:entries [day8.re-frame2-machines-viz.viewer]}}}}}
