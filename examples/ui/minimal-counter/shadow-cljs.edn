;; minimal-counter — shadow-cljs build config.
;;
;; The Clojure classpath comes from deps.edn via the :shadow alias (which
;; supplies shadow-cljs's own JVM side). Source paths live in deps.edn's
;; :paths — shadow IGNORES :source-paths here whenever :deps is used, so
;; setting it in this file would be silently dead config.
;;
;; npm deps (react, react-dom) come from package.json.
{:deps     {:aliases [:shadow]}

 ;; Serves resources/public on http://localhost:8280 during `watch`.
 :dev-http {8280 "resources/public"}

 ;; ---------------------------------------------------------------------
 ;; NO Freehand build configuration, and that is the point: interpreted
 ;; views need none at all (docs/core/freehand/install.md §Shadow build
 ;; settings). The whole framework contribution to this file is nothing.
 ;;
 ;; The COMPILED tier is what needs one — its analyzer and registries run
 ;; at build time, behind a single hook set once in :build-defaults:
 ;;
 ;;   :build-defaults {:build-hooks [(re-frame.freehand.compiler.build-hook/hook)]}
 ;;
 ;; This scaffold declares no `{:compiled true}` view, so it wires no hook.
 ;; Opt a view into the compiled tier and the hook comes with it.
 ;; ---------------------------------------------------------------------

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   ;; shadow's :browser target re-runs :init-fn after each hot reload —
   ;; no separate ^:dev/after-load hook is needed.
   :modules    {:main {:init-fn my.app/run}}}}}
