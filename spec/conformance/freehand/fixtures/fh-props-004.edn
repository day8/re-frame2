;; FH-PROPS-004 — a props schema is optional in the grammar, and where one is
;; declared it means the SAME thing in both execution modes.
;;
;; The law has two halves and they pull in opposite directions, which is why
;; both are pinned here.
;;
;; The first is the trust-the-programmer half: `:props` is OPTIONAL. An ordinary
;; application view that declares no schema compiles, mounts and renders, and
;; reports its schema as ABSENT rather than as a permissive `:any` — an
;; undeclared contract and a deliberately open one are different facts and stay
;; distinguishable. `:schema-less` names the declaration that proves it.
;;
;; The second is the half that makes a declared schema worth declaring: a schema
;; CLOSES the props map, and closes it identically whichever mode the view was
;; declared in. `:calls` is the accept/reject matrix — one table of props maps,
;; each with the verdict it MUST receive, driven against the same schema
;; declared once interpreted and once compiled. A verdict that differed between
;; the modes would mean promotion silently renegotiated the view's contract.
;;
;; What differs between the modes is WHEN the breach is reported, never what is
;; legal: a compiled call site's keys are literal, so the analyzer reports them
;; at build time under `:compiled-reject-id`; a delivered props map is knowable
;; at render, so the boundary reports it then under `:reject-id`.
;;
;; `:open` is the escape, and it is deliberately spelled in the schema rather
;; than as a second declaration option: a view that really does forward
;; arbitrary props — `v/route-link` passing every unrecognised key to its `<a>`
;; — states that once, where the rest of its props contract already is.
;;
;; `:reserved` pins the two keys no schema may govern. `:key` is stripped by the
;; call ABI before props are delivered and `:children` arrives as trailing forms
;; under `:children-policy`; a schema that had to name them would be a second
;; contract for something that already has one. Governing them is therefore not
;; merely ignored — `:reserved-declarations` are the literal schemas a
;; DECLARATION refuses, under `:declaration-reject-id`, because a schema that
;; named a reserved slot would advertise to a catalogue a prop the call ABI can
;; never deliver.
;;
;; `:opaque` is the other half of the closure rule, and the half that is easiest
;; to lose: a schema behind a registry reference or a runtime expression closes
;; NOTHING, and closes nothing at EVERY surface. A guess about keys nobody can
;; see would be worse than the open map it replaced, and an opacity honoured
;; where the schema is read as a form and forgotten where it is read as a value
;; would be exactly the cross-mode divergence the parity matrix above exists to
;; forbid. What the declaration publishes is therefore the AUTHORED schema, as
;; inert data — evaluating it would hand one consumer a literal `[:map …]` the
;; other one cannot see.
{:fh/id "FH-PROPS-004"

 :schema             [:map [:id :int] [:label :string]]
 :open-schema        [:map {:closed false} [:id :int]]

 :reject-id          :rf.error/view-bad-props
 :compiled-reject-id :rf.ui.compile/undeclared-prop

 ;; props map -> the verdict the schema above MUST return, in EITHER mode.
 :calls
 [{:props {:id 1 :label "a"}     :verdict :accept :why "every declared key, supplied"}
  {:props {:id 1}                :verdict :accept :why "a subset — closure is about which keys MAY appear, not which must"}
  {:props {}                     :verdict :accept :why "no props at all is a subset too"}
  {:props {:id 1 :key "k"}       :verdict :accept :why ":key is reserved, stripped before delivery, and never a schema slot"}
  {:props {:id 1 :labl "a"}      :verdict :reject :why "a one-character typo — the case a closed map exists to catch"}
  {:props {:id 1 :title "a"}     :verdict :reject :why "an undeclared prop the view would silently never read"}
  {:props {:extra 1 :other 2}    :verdict :reject :why "two at once; both are named, not just the first"}]

 ;; The same matrix against the OPEN escape: closure is what the declaration
 ;; asked for, so opting out admits everything the closed schema refused.
 :open-calls
 [{:props {:id 1}                :verdict :accept}
  {:props {:id 1 :title "a"}     :verdict :accept :why "an undeclared key is exactly what {:closed false} admits"}
  {:props {:anything 1}          :verdict :accept}]

 :reserved #{:key :children}

 :declaration-reject-id :rf.error/defview-bad-args

 ;; Literal schemas a declaration must REFUSE, each with the reserved slot it
 ;; names. Refused at declaration rather than at a call, because the breach is
 ;; in the contract itself and no call could repair it.
 :reserved-declarations
 [{:schema [:map [:key :string] [:id :int]]         :reserved :key}
  {:schema [:map [:children [:vector :any]] [:id :int]] :reserved :children}]

 ;; An opaque schema, and the surfaces its openness must survive. Every row of
 ;; `:calls` above is `:accept` against one, in both modes, at build time as
 ;; much as at the boundary.
 :opaque {:closes-nothing-at-every-surface?    true
          :describe-carries-the-authored-form? true}

 ;; The declaration that carries no schema at all — the optional half.
 :schema-less {:describe-omits-props-schema? true}}
