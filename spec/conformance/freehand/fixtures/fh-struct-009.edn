;; FH-STRUCT-009 — React's prop grammar, in a real browser.
;;
;; React does not take DOM attribute spellings. It takes PROPS, and their
;; canonical names are React's own external contract: `contentEditable`,
;; `acceptCharset`, `charSet`, `tabIndex`, `strokeWidth`. Hand React the
;; lowercase or hyphen-collapsed form and it does not quietly do the right
;; thing — it warns about an unrecognized property and treats it as one.
;;
;; That is why the `:dom` rows below are read off `document` after a real
;; `react-dom/client` mount, and why the row that matters most is a
;; NEGATIVE one: `:react-console-silent`. A structural assertion can show
;; that the emitter produced a prop; only a mounted React can show that
;; React ACCEPTED it. An emitter that spells a prop wrongly still produces
;; a perfectly shaped `createElement` call, and several of the wrong
;; spellings still land in the DOM — with a console warning and, for the
;; reserved props, different behaviour. Warnings are the observable.
;;
;; The SVG rows are doubled deliberately. `stroke-width` is authored twice
;; on the same page: once directly beneath `<svg>`, and once inside a
;; declared view, which React renders as a real component whose body runs
;; with no walk above it. A context-sensitive naming rule can only be
;; right on the first, so it changes what reaches the DOM the moment an
;; author extracts a view — a refactor that is supposed to change nothing.
{:fh/id "FH-STRUCT-009"
 :fh/law
 "The interpreted React emitter spells attributes as React's canonical props, identically at every depth and across declared-view boundaries; the structural tree keeps author-space names; the reserved and rejected spellings — `:children`, `:ref`, `:key`, the raw-markup aliases — are refused by both emitters rather than reaching React; and an alias of an accepted slot-owning key (`:class`, `:style`) is routed to that key's slot, composing with the `.class#id` sugar rather than replacing it."

 :view :props-page

 ;; The author keyword -> the React prop name the emitter writes. The
 ;; vocabulary is react-dom 19.2.0's own `possibleStandardNames`; an
 ;; unrecognized name passes verbatim, which is React 16+'s rule.
 :prop-names
 [{:note "the collapsed spelling is not a prop; tabIndex is"      :attr :tab-index        :prop "tabIndex"}
  {:note "React warns about contenteditable and omits it"         :attr :content-editable :prop "contentEditable"}
  {:note "already-camel author spellings hit the same row"        :attr :contentEditable  :prop "contentEditable"}
  {:note "acceptcharset is the wrong attribute; acceptCharset is" :attr :accept-charset   :prop "acceptCharset"}
  {:note "charset is React's charSet"                             :attr :char-set         :prop "charSet"}
  {:note "and so is the collapsed authoring"                      :attr :charset          :prop "charSet"}
  {:note ":class takes React's reserved className"                :attr :class            :prop "className"}
  {:note "and :for takes htmlFor"                                 :attr :for              :prop "htmlFor"}
  {:note "an SVG kebab attribute is a camelCase React prop"       :attr :stroke-width     :prop "strokeWidth"}
  {:note "and so is the SVG viewBox"                              :attr :view-box         :prop "viewBox"}
  {:note "data-* passes verbatim, casing intact (Spec 004B; React 19 separately warns at MOUNT about a camelCase data-* name, which is a question about that row rather than about this projection)"
   :attr :data-fooBar :prop "data-fooBar"}
  {:note "and a lowercase data-* is the ordinary case"            :attr :data-priority    :prop "data-priority"}
  {:note "aria-* passes verbatim too"                             :attr :aria-hidden      :prop "aria-hidden"}
  {:note "an unrecognized name passes verbatim — React 16+ pass-through" :attr :my-thing   :prop "my-thing"}]

 ;; The structural tree is AUTHOR space. React prop names are the React
 ;; emitter's concern and appear nowhere in the value the JVM answers.
 :structural
 [{:note "author-space keys survive into :attrs, uncanonicalised"
   :form [:section {:tab-index 3 :content-editable true :data-fooBar "kept"}]
   :tree {:tag :section
          :attrs {:tab-index "3" :content-editable true :data-fooBar "kept"}
          :rf.ui/tree-version 1}}
  {:note "and an SVG attribute keeps its authored kebab name beside its :ns"
   :form [:svg [:rect {:stroke-width 2}]]
   :tree {:tag :svg :ns :svg
          :children [{:tag :rect :ns :svg :attrs {:stroke-width "2"}}]
          :rf.ui/tree-version 1}}]

 ;; Read off `document`, after a real react-dom/client mount of :view.
 :dom
 [{:note "tabIndex reaches the DOM as tabindex"
   :selector "#props" :attrs {"tabindex" "3"}}

  {:note "a data-* name passes verbatim"
   :selector "#props" :attrs {"data-priority" "high"}}

  {:note "contentEditable is a booleanish attribute React writes as a string"
   :selector "#ce" :attrs {"contenteditable" "true"}}

  {:note "acceptCharset serialises as the hyphenated HTML attribute"
   :selector "#f" :attrs {"accept-charset" "utf-8"}}

  {:note "htmlFor serialises as for"
   :selector "#f > label" :attrs {"for" "n"}}

  {:note "maxLength serialises as maxlength, and readOnly as the bare boolean readonly"
   :selector "#n" :attrs {"maxlength" "8" "readonly" ""}}

  {:note "viewBox is case-sensitive in SVG and survives exactly"
   :selector "#s" :attrs {"viewBox" "0 0 24 24"}}

  {:note "an SVG attribute authored DIRECTLY under <svg> mounts correctly"
   :selector "#r" :attrs {"stroke-width" "2" "fill-opacity" "0.5"}}

  {:note "and the SAME attribute authored inside a declared view mounts identically — the boundary changes nothing"
   :selector "#s circle" :attrs {"stroke-width" "3"}}

  {:note "the SVG elements really are in the SVG namespace, so the naming rule had a namespace to lose"
   :selector-all "#s rect, #s circle" :count 2}]

 ;; The load-bearing negative. React reports an unrecognized property
 ;; through console.error; a canonical prop produces nothing at all.
 :react-console-silent true

 ;; …and the control that makes that silence mean something. A production
 ;; React build warns about nothing, so "no warnings" would pass on an
 ;; emitter that spelled every prop wrongly. This row mounts the
 ;; non-canonical spelling through `createElement` DIRECTLY, around the
 ;; emitter, and requires React to complain — so the observable is proven
 ;; live in the same browser, in the same build, in the same test.
 :react-warning-control
 {:note  "React reports an unrecognized DOM property through console.error, naming the canonical spelling it expected"
  :tag   "div"
  :prop  "contenteditable"
  :value "true"
  :names "contentEditable"}

 ;; Reserved and rejected spellings never reach React. Each is refused by
 ;; BOTH emitters, at the walk, with the same diagnostic id — so a
 ;; declaration cannot be structurally fine and behaviourally different,
 ;; and a void element cannot throw in React alone.
 :rejected
 [{:note ":children is React's reserved prop — through the attribute path it would render content the structural tree does not carry"
   :form [:div {:children "ghost"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and on a void element React throws rather than render it, which the structural walk would never have predicted"
   :form [:img {:children "ghost"}] :error-id :rf.error/ui-tree-malformed}
  {:note ":ref is a commit-phase host hook React consumes; the interpreted tier has no ref machinery"
   :form [:div {:ref "node"}] :error-id :rf.error/ui-tree-malformed}
  {:note "React's raw-markup prop has one visible spelling in this grammar, and it is a node variant"
   :form [:div {:dangerouslySetInnerHTML "<b>x</b>"}] :error-id :rf.error/ui-tree-malformed}
  {:note "its kebab alias is denied too"
   :form [:div {:dangerously-set-inner-html "<b>x</b>"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and so is the shorter one"
   :form [:div {:inner-html "<b>x</b>"}] :error-id :rf.error/ui-tree-malformed}
  {:note "one spelling per name: :class-name is not a second way to write :class"
   :form [:div {:class-name "a"}] :error-id :rf.error/ui-tree-malformed}
  {:note "nor :html-for a second way to write :for"
   :form [:label {:html-for "n"}] :error-id :rf.error/ui-tree-malformed}

  ;; The refusal reads the prop name the emitters WRITE, not the raw map
  ;; key. A key is classified and projected by its `name`, so a namespace,
  ;; a string or a symbol changes the spelling at the site and nothing at
  ;; all about where the value lands — which is exactly how a guard that
  ;; compared the raw key let one declaration render content the
  ;; structural tree does not carry.
  {:note "a namespaced :children reaches React's reserved children slot all the same"
   :form [:div {:x/children "ghost"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and on a void element it is the same throw the exact spelling was refused for"
   :form [:img {:x/children "ghost"}] :error-id :rf.error/ui-tree-malformed}
  {:note "a string key spells the same prop"
   :form [:div {"children" "ghost"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and so does a symbol key"
   :form [:div {children "ghost"}] :error-id :rf.error/ui-tree-malformed}
  {:note "a namespaced :ref is still the commit-phase host hook the walk has no machinery for"
   :form [:div {:x/ref "node"}] :error-id :rf.error/ui-tree-malformed}
  {:note "as is the string spelling"
   :form [:div {"ref" "node"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and the symbol one"
   :form [:div {ref "node"}] :error-id :rf.error/ui-tree-malformed}
  {:note "React's raw-markup prop is the same slot however the key is qualified"
   :form [:div {:x/dangerouslySetInnerHTML "<b>x</b>"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and its kebab alias carries no namespace escape either"
   :form [:div {:x/dangerously-set-inner-html "<b>x</b>"}] :error-id :rf.error/ui-tree-malformed}
  {:note "nor the shorter alias, spelled as a string"
   :form [:div {"inner-html" "<b>x</b>"}] :error-id :rf.error/ui-tree-malformed}
  {:note "one spelling per name holds under a namespace too"
   :form [:div {:x/class-name "a"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and under a symbol"
   :form [:label {html-for "n"}] :error-id :rf.error/ui-tree-malformed}

  ;; React's `key` is not a prop. The reconciler consumes it and it never
  ;; reaches the DOM, so an alias routed into that slot would not misspell
  ;; an attribute — it would change which element React considers the SAME
  ;; element across renders. Preserved DOM state landing on the wrong row,
  ;; or a remount where none was intended, is `:children`'s hazard class,
  ;; so `:key` keeps its one spelling and every alias of it is refused.
  {:note "a namespaced :key would address reconciliation identity through a spelling the grammar never declared"
   :form [:div {:x/key "k"}] :error-id :rf.error/ui-tree-malformed}
  {:note "the string spelling reaches the same slot"
   :form [:div {"key" "k"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and so does the symbol one"
   :form [:div {key "k"}] :error-id :rf.error/ui-tree-malformed}

  ;; The `#id` shorthand OWNS the emitted id slot, so an authored key that
  ;; projects onto it spells the element's id a SECOND time — the
  ;; ambiguity this grammar removes rather than ranks. The exact `:id` was
  ;; always refused here; the aliases were not, because that guard also
  ;; compared the raw key. React writes every one of these pairs into the
  ;; same JavaScript property, so the authored id replaced the shorthand's
  ;; while the structural tree went on reporting both — a selector or a
  ;; label reading the tree would target an id the browser does not have.
  {:note "the shorthand and an :id prop are two spellings of one attribute"
   :form [:div#sugar {:id "alias"}] :error-id :rf.error/ui-tree-malformed}
  {:note "a namespaced id reaches the shorthand's slot all the same"
   :form [:div#sugar {:x/id "alias"}] :error-id :rf.error/ui-tree-malformed}
  {:note "as does the string spelling"
   :form [:div#sugar {"id" "alias"}] :error-id :rf.error/ui-tree-malformed}
  {:note "and the symbol one"
   :form [:div#sugar {id "alias"}] :error-id :rf.error/ui-tree-malformed}]

 ;; The control that makes the rows above mean something. Refusing by
 ;; emitted prop name is only correct if it refuses the names that ARE
 ;; spoken for and no others — an over-broad guard that turned every
 ;; qualified attribute away would be a worse defect than the bypass it
 ;; closed, and would look identical in a table of rejections. These keys
 ;; project onto ordinary props and are accepted, qualified or not.
 ;;
 ;; Two of the accepted names own a SLOT rather than a place in the
 ;; attribute map — `:class`, which composes with the `.class#id` sugar,
 ;; and `:style`, which carries the CSS grammar — and an alias of either is
 ;; ROUTED to that slot rather than refused, because they are ordinary
 ;; props that reach the DOM and the substrate already routes an aliased
 ;; spelling of an accepted key (`v/spread-safe`). Those rows carry a
 ;; `:props` map as well: the structural tree says where the value landed
 ;; in author space, and `:props` says what the React emitter wrote, which
 ;; is where a router that ASSIGNED over the sugar instead of composing
 ;; into it would show up.
 :accepted-keys
 [{:note "a namespaced attribute whose name is an ordinary prop passes"
   :form [:div {:x/title "ok"}]
   :tree {:tag :div :attrs {:x/title "ok"} :rf.ui/tree-version 1}
   :props {"title" "ok"}}
  {:note "including one whose name React canonicalises"
   :form [:div {:x/tab-index 3}]
   :tree {:tag :div :attrs {:x/tab-index "3"} :rf.ui/tree-version 1}
   :props {"tabIndex" "3"}}
  {:note "data-* is untouched by the refusal, qualified or not"
   :form [:div {:x/data-priority "high" :data-priority "high"}]
   :tree {:tag :div :attrs {:x/data-priority "high" :data-priority "high"}
          :rf.ui/tree-version 1}
   :props {"data-priority" "high"}}
  {:note ":class is React's className and is NOT the rejected :class-name"
   :form [:div {:class "a"}]
   :tree {:tag :div :attrs {:class "a"} :rf.ui/tree-version 1}
   :props {"className" "a"}}
  {:note "and :for is htmlFor, not the rejected :html-for"
   :form [:label {:for "n"}]
   :tree {:tag :label :attrs {:for "n"} :rf.ui/tree-version 1}
   :props {"htmlFor" "n"}}

  ;; The routed slots. `:class` is the one that carries an obligation: the
  ;; tag shorthand and an authored class are MERGED, so a routed alias that
  ;; assigned would silently drop `.a.b` — an element that still renders,
  ;; with the wrong classes, which is why the shorthand is in every row.
  {:note "an aliased :class composes into the shorthand exactly as :class does"
   :form [:div.a.b {:x/class "c"}]
   :tree {:tag :div :attrs {:class "a b c"} :rf.ui/tree-version 1}
   :props {"className" "a b c"}}
  {:note "and it keeps the whole class grammar — a flag map renders its truthy entries in lexicographic order"
   :form [:div.a.b {:x/class {:open true :busy false}}]
   :tree {:tag :div :attrs {:class "a b open"} :rf.ui/tree-version 1}
   :props {"className" "a b open"}}
  {:note "a string key spells the same slot, and composes the same way"
   :form [:div.a.b {"class" ["c" "d"]}]
   :tree {:tag :div :attrs {:class "a b c d"} :rf.ui/tree-version 1}
   :props {"className" "a b c d"}}
  {:note "and so does a symbol key"
   :form [:div.a.b {class "c"}]
   :tree {:tag :div :attrs {:class "a b c"} :rf.ui/tree-version 1}
   :props {"className" "a b c"}}
  {:note "an aliased :style reaches the CSS grammar, so a number still gains px"
   :form [:div {:x/style {:color "red" :width 4}}]
   :tree {:tag :div :attrs {:style {:color "red" :width "4px"}} :rf.ui/tree-version 1}
   :props {"style" {"color" "red" "width" "4px"}}}
  {:note "the canonical :class is untouched by the routing — the shorthand still merges"
   :form [:div.a.b {:class "c"}]
   :tree {:tag :div :attrs {:class "a b c"} :rf.ui/tree-version 1}
   :props {"className" "a b c"}}
  {:note "and so is the canonical :style"
   :form [:div {:style {:color "red" :width 4}}]
   :tree {:tag :div :attrs {:style {:color "red" :width "4px"}} :rf.ui/tree-version 1}
   :props {"style" {"color" "red" "width" "4px"}}}
  ;; `:key` carries no `:props` row and that is the point: React lifts a key
  ;; onto the ELEMENT and strips it from props, which is exactly why an
  ;; alias of it is refused rather than routed — there is no prop to land in.
  {:note "the canonical :key is still lifted onto the node and is never an attribute"
   :form [:div {:key "k"}]
   :tree {:tag :div :key "k" :rf.ui/tree-version 1}
   :react-key "k"}

  ;; The id rows, and the reason they carry a `:props` map: the tree's id
  ;; and React's `id` must be the SAME id. That is what the shorthand
  ;; conflict guard buys, and these are the forms it must not have touched
  ;; — a guard that turned every id away would look identical in a table of
  ;; rejections. Each carries exactly one id, spelled one way.
  {:note "the .class#id shorthand alone — the tree's id is the one React receives"
   :form [:div#sugar]
   :tree {:tag :div :attrs {:id "sugar"} :rf.ui/tree-version 1}
   :props {"id" "sugar"}}
  {:note "an :id prop with no shorthand to collide with is untouched"
   :form [:div {:id "plain"}]
   :tree {:tag :div :attrs {:id "plain"} :rf.ui/tree-version 1}
   :props {"id" "plain"}}
  {:note "and a QUALIFIED id with no shorthand stays in author space, carrying the value React writes into id — one id, two vocabularies"
   :form [:div {:x/id "alias"}]
   :tree {:tag :div :attrs {:x/id "alias"} :rf.ui/tree-version 1}
   :props {"id" "alias"}}
  {:note "the shorthand beside an unrelated qualified attribute is no conflict at all"
   :form [:div#sugar {:x/title "ok"}]
   :tree {:tag :div :attrs {:id "sugar" :x/title "ok"} :rf.ui/tree-version 1}
   :props {"id" "sugar" "title" "ok"}}]

 ;; The BEHAVIOURAL control for the reserved `children` slot: React really
 ;; does render a `children` prop as content. Mounted through
 ;; `createElement` DIRECTLY, around the emitter, so the consequence the
 ;; refusal prevents is proved live in the same browser and the same build
 ;; — otherwise "the alias is refused" would be a claim about a table
 ;; rather than about the DOM.
 :react-children-control
 {:note  "a children prop handed to React renders as content — which is what an attribute-path alias would have produced, with nothing in the structural tree to match it"
  :tag   "div"
  :prop  "children"
  :value "ghost"
  :text  "ghost"}}
