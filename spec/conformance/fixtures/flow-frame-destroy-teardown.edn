;; Conformance fixture: flow/frame-destroy-teardown
;; Per Spec 013 §Frame-destroy teardown and Spec 002 §Destroy —
;; `destroy-frame!` MUST release the destroyed frame's flow evaluation memo:
;; every memo row it holds. Sibling frames' memos are preserved, and the
;; flow definitions — registrar rows, not frame state — outlive every frame.
;;
;; This is a normative requirement: without lockstep teardown a
;; long-running SSR JVM with per-request frame churn leaks cached input
;; vectors indefinitely.
;;
;; `:fc/a` and `:fc/b` both run `:area`; `:fc/scratch` alone runs
;; `:area-sole`. After a `:seed` dispatch into each frame populates its
;; memo, the harness destroys `:fc/a` and `:fc/scratch` and asserts:
;;
;;   - `:flow-registry-after`         — `:fc/b` still runs `:area`; the
;;                                       destroyed `:fc/scratch` runs nothing.
;;   - `:flow-last-inputs-after`      — `:area`'s memo row survives on `:fc/b`
;;                                       only, and `:area-sole` has none left.
;;   - `:registrar-flow-slots-after`  — both definitions are still registered.

{:fixture/id           :flow/frame-destroy-teardown
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :flow/basic :flow/frame-scoped}
 :fixture/doc          "destroy-frame! releases the destroyed frame's flow evaluation memo. Sibling frames' memos are preserved and the flow definitions stay registered. The teardown is normative — without it, long-running SSR JVM hosts with per-request frame churn leak cached input vectors indefinitely."

 :fixture/registry
 {:event {:seed {:doc "Seed :w/:h on the dispatching frame."}}
  :flow  {:area      {:doc         "Rectangle area at [:rect :area]."
                      :inputs      [[:w] [:h]]
                      :output-path [:rect :area]}
          :area-sole {:doc         "Rectangle area at [:rect :area-sole]."
                      :inputs      [[:w] [:h]]
                      :output-path [:rect :area-sole]}}}

 :fixture/handlers
 {:event {:seed [[:set [:w] [:event-arg 1]]
                 [:set [:h] [:event-arg 2]]]}}

 :fixture/flow-bodies
 {:area      [[:fn :* [:event-arg 0] [:event-arg 1]]]
  :area-sole [[:fn :* [:event-arg 0] [:event-arg 1]]]}

 :fixture/frames
 [{:id :fc/a       :flows [:area]}
  {:id :fc/b       :flows [:area]}
  {:id :fc/scratch :flows [:area-sole]}]

 :fixture/dispatches
 [;; Distinct inputs per frame make the memo rows distinct.
  {:event [:seed 3 4]   :frame :fc/a}
  {:event [:seed 7 9]   :frame :fc/b}
  {:event [:seed 11 13] :frame :fc/scratch}
  ;; Harness teardown steps.
  {:destroy-frame :fc/a}
  {:destroy-frame :fc/scratch}]

 :fixture/expect
 {:final-app-dbs
  ;; :fc/b is the only surviving frame.
  {:fc/b {:w 7 :h 9 :rect {:area 63}}}

  ;; The flows each frame's config names; a destroyed frame names none.
  :flow-registry-after
  {:fc/b       #{:area}
   :fc/scratch #{}}

  ;; The frames holding a memo row for each flow.
  :flow-last-inputs-after
  {:area      #{:fc/b}
   :area-sole #{}}

  ;; Definitions are registrar rows; no destroy removes them.
  :registrar-flow-slots-after
  #{:area :area-sole}}}
