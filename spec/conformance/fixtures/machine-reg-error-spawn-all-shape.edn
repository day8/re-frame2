;; Conformance fixture: machine/reg-error-spawn-all-shape
;;
;; Per [005 §Spawn-and-join via `:spawn-all`](../../005-StateMachines.md#spawn-and-join-via-spawn-all)
;; A `:spawn-all`-bearing state node is shape-validated at
;; registration:
;;
;;   - A state node MUST NOT declare BOTH `:spawn` and `:spawn-all` (they
;;     are mutually exclusive) — `:rf.error/machine-spawn-all-with-spawn`.
;;   - Two children inside one `:spawn-all` block MUST NOT share an `:id`
;;     keyword — `:rf.error/machine-spawn-all-duplicate-id`.
;;   - The `:join` grammar is a CLOSED two-member enum (`:all` / `:any`).
;;     Any other mode (`{:n N}` / `{:fn pred}`), and `:cancel-on-decision?`,
;;     which is not a block key, are rejected as an unknown join spec /
;;     unknown block key — `:rf.error/machine-spawn-all-bad-shape`.
;;   - The RETIRED child-vocabulary keys `:on-child-done` / `:on-child-error`
;;     are likewise unknown block keys. A child completes by entering a
;;     `:final?` state, so a `:spawn-all` declares only how RESULTS COMBINE
;;     (per [005 §Child completion protocol](../../005-StateMachines.md#child-completion-protocol)).
;;   - A `:spawn-all` CHILD spec MUST NOT declare `:on-error` — failure
;;     control flow under a join is the block's `:on-any-failed` —
;;     `:rf.error/machine-unknown-spawn-key`. `:on-done` IS accepted on a
;;     child spec as a fn: it folds the parent's `:data` at that child's
;;     finality. Any other child `:on-done` value — a transition map included —
;;     is `:rf.error/machine-bad-on-done-clause`. EDN carries no fn, so the
;;     fold itself is pinned by the host test suites, not here.
;;
;; Mode-B `:reg-machine` fixture pinning members of the registration-error
;; taxonomy (Spec 009 §The thrown-error shape). Each call's `:expect-error`
;; names the `:rf.error/id` discriminator.

{:fixture/id           :machine/reg-error-spawn-all-shape
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:actor/spawn-and-join :fsm/registration-validation}
 :fixture/doc          "A state node declaring both :spawn and :spawn-all throws :rf.error/machine-spawn-all-with-spawn; two :spawn-all children sharing an :id throw :rf.error/machine-spawn-all-duplicate-id; a :join {:n N} / {:fn pred} mode, the :cancel-on-decision? key, or the retired :on-child-done / :on-child-error child-vocabulary keys throw :rf.error/machine-spawn-all-bad-shape; :on-error on a child spec throws :rf.error/machine-unknown-spawn-key; a non-fn child :on-done throws :rf.error/machine-bad-on-done-clause. The control case — a well-formed :spawn-all with distinct child :ids — validates silently."

 :fixture/registry {}
 :fixture/handlers  {}

 :fixture/calls
 [;; (1) A state declaring BOTH :spawn and :spawn-all — mutually exclusive, rejected.
  {:call         :reg-machine
   :definition   {:initial :gathering
                  :states  {:gathering
                            {:spawn     {:machine-id :worker/solo}
                             :spawn-all {:children        [{:id :a :machine-id :worker/a}]
                                         :on-all-complete [:all/done]}}}}
   :expect-error :rf.error/machine-spawn-all-with-spawn}

  ;; (2) Two :spawn-all children sharing an :id keyword — rejected.
  {:call         :reg-machine
   :definition   {:initial :gathering
                  :states  {:gathering
                            {:spawn-all {:children        [{:id :dup :machine-id :worker/a}
                                                           {:id :dup :machine-id :worker/b}]
                                         :on-all-complete [:all/done]}}}}
   :expect-error :rf.error/machine-spawn-all-duplicate-id}

  ;; (3) A :join {:n N} quorum mode is not in the enum — rejected as an unknown join spec.
  {:call         :reg-machine
   :definition   {:initial :gathering
                  :states  {:gathering
                            {:spawn-all {:children         [{:id :a :machine-id :worker/a}]
                                         :join             {:n 2}
                                         :on-some-complete [:some/done]}}}}
   :expect-error :rf.error/machine-spawn-all-bad-shape}

  ;; (4) :cancel-on-decision? is not a :spawn-all block key (sibling
  ;; cancellation on a join decision is unconditional) — rejected as an
  ;; unknown block key.
  {:call         :reg-machine
   :definition   {:initial :gathering
                  :states  {:gathering
                            {:spawn-all {:children            [{:id :a :machine-id :worker/a}]
                                         :join                :any
                                         :cancel-on-decision? false
                                         :on-some-complete    [:some/done]}}}}
   :expect-error :rf.error/machine-spawn-all-bad-shape}

  ;; (5) The retired :on-child-done / :on-child-error child-vocabulary keys —
  ;; rejected as unknown block keys. A child completes by entering a :final?
  ;; state, so a :spawn-all declares only how RESULTS COMBINE; a spec naming
  ;; the retired keys fails loud rather than having them silently ignored
  ;; (per 005 §Child completion protocol).
  {:call         :reg-machine
   :definition   {:initial :gathering
                  :states  {:gathering
                            {:spawn-all {:children        [{:id :a :machine-id :worker/a}]
                                         :on-child-done   :child/done
                                         :on-child-error  :child/error
                                         :on-all-complete [:all/done]}}}}
   :expect-error :rf.error/machine-spawn-all-bad-shape}

  ;; (6) :on-error on a :spawn-all CHILD spec — rejected as an unknown spawn
  ;; key. Failure control flow under a join is the block's :on-any-failed,
  ;; which decides for the whole fan-out, so nothing would honour a per-child
  ;; error transition. (:on-done IS honoured on a child spec — see the control
  ;; below.)
  {:call         :reg-machine
   :definition   {:initial :gathering
                  :states  {:gathering
                            {:spawn-all {:children        [{:id :a :machine-id :worker/a
                                                            :on-error {:target :failed}}]
                                         :on-all-complete [:all/done]}
                             }
                            :failed {}}}
   :expect-error :rf.error/machine-unknown-spawn-key}

  ;; (7) A transition-shaped :on-done on a :spawn-all CHILD spec — rejected. A
  ;; join child's :on-done is a :data fold (a fn); the join's own events own
  ;; control flow.
  {:call         :reg-machine
   :definition   {:initial :gathering
                  :states  {:gathering
                            {:spawn-all {:children        [{:id :a :machine-id :worker/a
                                                            :on-done {:target :failed}}]
                                         :on-all-complete [:all/done]}}
                            :failed {}}}
   :expect-error :rf.error/machine-bad-on-done-clause}

  ;; (8) Control: a well-formed :spawn-all with distinct child :ids validates
  ;; silently.
  {:call       :reg-machine
   :definition {:initial :gathering
                :states  {:gathering
                          {:spawn-all {:children        [{:id :a :machine-id :worker/a}
                                                         {:id :b :machine-id :worker/b}]
                                       :on-all-complete [:all/done]}}}}}]}
