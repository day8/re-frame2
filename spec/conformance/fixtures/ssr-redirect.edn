;; Conformance fixture: ssr/redirect
;; A handler emits :rf.server/redirect during the SSR drain; the response
;; accumulator carries the redirect and its :status 302. Per [011 §Redirect
;; precedence]. Dropping the HTML body and payload is the host adapter's job,
;; done where it builds the request result, so its tests grade that.

{:fixture/id           :ssr/redirect
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx :ssr/response-contract}
 :fixture/doc          "An :initial-events event emits :rf.server/redirect with status 302 and Location /login. The response accumulator has the redirect populated and :status 302."

 :fixture/registry
 {:event {:rf/server-init     {:doc       "Per-request server-side init."
                               :platforms #{:server}}
          :auth/check-session {:doc       "Authentication gate."
                               :platforms #{:server}}}
  ;; :rf.server/redirect is registered by the runtime (re-frame.ssr,
  ;; per Spec 011 §HTTP response contract). Not declared
  ;; here so the harness doesn't shadow it with a no-op stub.
  }

 :fixture/handlers
 {:event {:rf/server-init     [[:fx [[:dispatch [:auth/check-session]]]]]
          :auth/check-session [[:fx [[:rf.server/redirect {:status 302 :location "/login"}]]]]}}

 :fixture/frame-config {:initial-events [[:rf/server-init]] :platform :server}

 :fixture/dispatches []                                              ;; the :initial-events cascade is sufficient

 :fixture/expect
 ;; Submap match. The :rf/response accumulator lives in a
 ;; framework-private side-channel atom (re-frame.ssr/response-slots),
 ;; NOT in app-db — so the redirect shape is asserted via
 ;; :ssr/request-result. Spec 011 §Redirect precedence: the redirect's
 ;; :status flows through to the response :status.
 {:final-app-db {}

  :ssr/request-result
  {:response {:status   302
              :redirect {:status 302 :location "/login"}}}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :rf/server-init}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :auth/check-session}}]}}
