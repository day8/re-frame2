;; Conformance fixture: rf.http.managed/accept-failure
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Failure
;; categories — `:rf.http/accept-failure`: an `:accept` fn returning
;; `{:failure user-map}` on a structurally-OK 2xx classifies the reply under
;; `:kind :rf.http/accept-failure`, with the user's verbatim failure map at
;; `:detail` and the pre-`:accept` decoded value at `:decoded`.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-failure`, so no managed-HTTP code runs: no
;; `:accept` fn runs and nothing is classified — the failure envelope is
;; written out in the canned-failure body. What it grades is the redirection
;; of `:rf.http/managed` to that body, the args the body receives
;; (`:effects-routed`) and the dispatch of the reply it writes. The
;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/accept-failure
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx
                         :rf.http/managed}
 :fixture/doc          "Shaped like Spec 014's :rf.http/accept-failure: the fixture's canned-failure body, reached through :fx-overrides, dispatches {:status :error :error {:kind :rf.http/accept-failure :detail <user failure map> :decoded <pre-:accept value>}} to the :on-failure target. Grades override routing, args forwarding and reply dispatch; no :accept fn runs and nothing is classified."

 :fixture/registry
 {:event {:article/load        {:doc "Issue the GET."}
          :article/load-error  {:doc "Receive the failure payload."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-failure {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:article/load
   [[:fx [[:rf.http/managed
           {:request {:method :get :url "/articles/hello"}
            :decode  :json
            ;; The :accept fn would normally inspect the decoded value
            ;; and return {:failure ...}; the canned-failure stub
            ;; pre-synthesises the resulting failure envelope.
            :on-failure [:article/load-error]}]]]]

   :article/load-error
   [[:set [:article :error] [:event-arg 1]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-failure
   [[:dispatch [:article/load-error
                {:status :error
                 :error  {:kind    :rf.http/accept-failure
                          :detail  {:reason  :missing-article
                                    :message "Response missing :article"}
                          :decoded {:meta {:status "ok"}}}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-failure}}

 :fixture/dispatches
 [[:article/load]]

 :fixture/expect
 {:final-app-db
  {:article {:error {:status :error
                     :error  {:kind    :rf.http/accept-failure
                              :detail  {:reason  :missing-article
                                        :message "Response missing :article"}
                              :decoded {:meta {:status "ok"}}}}}}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :article/load}}
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-failure}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :article/load-error}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-failure
    :args  {:request    {:method :get :url "/articles/hello"}
            :decode     :json
            :on-failure [:article/load-error]}}]}}
