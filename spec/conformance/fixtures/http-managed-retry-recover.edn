;; Conformance fixture: rf.http.managed/retry-recover
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Retry ×
;; `:on-success` semantics: when a retriable attempt succeeds before
;; `:max-attempts` exhausts, the caller sees exactly one success reply (the
;; recovered payload) at `:on-success`.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-success`, so no managed-HTTP code runs: no
;; attempt is made and nothing retries — the canned-success body dispatches
;; one reply it writes itself (`retry-exhaustion.edn` is the failure-side
;; twin). What it grades is the redirection of `:rf.http/managed` to that
;; body, the args the body receives (`:effects-routed`, the `:retry` policy
;; verbatim) and the dispatch of the reply it writes. The
;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/retry-recover
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx
                         :rf.http/managed}
 :fixture/doc          "Shaped like Spec 014 §Retry and backoff's recovery case: a GET carrying a :retry policy of 3 attempts, redirected by :fx-overrides to the fixture's canned-success body, which dispatches one recovered-payload reply to :on-success. Grades override routing, args forwarding and reply dispatch; no attempt is made and nothing retries."

 :fixture/registry
 {:event {:flaky/load         {:doc "Issue the GET with retry policy."}
          :flaky/load-success {:doc "Receive the recovered payload."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-success {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:flaky/load
   [[:fx [[:rf.http/managed
           {:request    {:method :get :url "/flaky"}
            :decode     :json
            :retry      {:on           #{:rf.http/http-5xx}
                         :max-attempts 3
                         :backoff      {:base-ms 5 :factor 1 :max-ms 10}}
            :on-success [:flaky/load-success]}]]]]

   :flaky/load-success
   [[:set [:flaky :data] [:event-arg 1]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-success
   ;; Recovered-on-retry shape per Spec 014 §Reply payload shape.
   [[:dispatch [:flaky/load-success
                {:status :ok
                 :value  {:ok true :recovered-on :attempt-2}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-success}}

 :fixture/dispatches
 [[:flaky/load]]

 :fixture/expect
 {:final-app-db
  {:flaky {:data {:status :ok
                  :value  {:ok true :recovered-on :attempt-2}}}}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :flaky/load}}
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-success}}
   ;; The canned-success body dispatches one reply; :rf.http/retry-attempt
   ;; traces come only from the live fx, which does not run here.
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :flaky/load-success}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-success
    :args  {:request    {:method :get :url "/flaky"}
            :decode     :json
            :retry      {:on           #{:rf.http/http-5xx}
                         :max-attempts 3
                         :backoff      {:base-ms 5 :factor 1 :max-ms 10}}
            :on-success [:flaky/load-success]}}]}}
