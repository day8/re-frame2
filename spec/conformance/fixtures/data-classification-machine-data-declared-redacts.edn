;; Conformance fixture: data-classification/machine-data-declared-redacts
;;
;; Per Spec 015 §Subsystem projection-relative classification + the §Tests
;; fixture table, and Spec 005 §Privacy — redacting machine `:data` at trace
;; egress.
;;
;; EP-0025 (final): a machine declares its durable `:data` classification
;; PROJECTION-RELATIVE on its `reg-machine` spec — a `:sensitive` (and/or
;; `:large`) vector of snapshot-relative `:data`-rooted `:rf/path` vectors. The
;; runtime LOWERS each declaration PER ACTOR INSTANCE at spawn / first-boot
;; (`re-frame.machines.classification/lower-at-spawn!`), re-rooting `[:data
;; :token]` to the absolute snapshot path `[:rf.runtime/machines :snapshots
;; <actor-id> :data :token]` and writing it `{:source :machine}` into the SAME
;; per-frame elision registry the four commit-plane effects populate — and drops
;; it on destroy (any cause). NO frame annotation and NO author-side absolute
;; runtime path: the classification travels with the machine DEFINITION like
;; XState's `context` shape, covering every generated instance with zero
;; per-instance author code.
;;
;; This REPLACES the earlier frame-declared-absolute-path shape (the superseded
;; rf2-398kql "frame-declared paths are the sole machine :data mechanism"
;; disposition that EP-0025 §subsystems reversed). The fixture's machine spec
;; now carries the classification directly (`:sensitive [[:data :token]]`); no
;; `:fixture/classification-effects` op is needed — the machine lifecycle lowers
;; it at boot.
;;
;; The machine's `:data-schema` carries NO `:sensitive?` prop (validation-only,
;; EP-0025 reverses the EP-0005 schema→classification bridge); the
;; classification is entirely the machine's projection-relative declaration.
;;
;; The redaction is a TRACE-EGRESS concern: the committed runtime-db snapshot
;; carries the raw value; only the projected trace event redacts (the listener
;; fan-out runs through `:classification/project-trace-event`, which re-roots the
;; lowered snapshot-path declaration relative to the snapshot value via
;; `classification/frame-snapshot-classification`).
;;
;; Capability `:data-classification/classification-effects` (claimed by both the
;; JVM and CLJS conformance corpus runners) + `:fsm/flat` + `:core/trace`.

{:fixture/id           :data-classification/machine-data-declared-redacts
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:fsm/flat :core/event-handler :core/trace
                         :data-classification/classification-effects}
 :fixture/doc          "A reg-machine declaring :sensitive [[:data :token]] PROJECTION-RELATIVE (lowered per actor instance at spawn, :source :machine), after a transition whose action writes a secret token into :data, projects :rf/redacted at [:data :token] in the :rf.machine/transition and :rf.machine/snapshot-updated trace :after snapshot; an unmarked sibling slot (:retries) rides egress verbatim. The committed runtime-db snapshot carries the raw value — redaction is trace-egress only. EP-0025: the machine definition declares its own classification (the :data-schema validates but no longer classifies); no frame annotation, no author-side absolute runtime path."

 :fixture/registry
 {:event {:dc/auth {:doc "Machine-as-event-handler; durable :data classified by the machine's own projection-relative declaration."}}
  :machine-action
  {:dc/store-token {:doc "Action body writes the secret token + bumps retries into machine :data."}}
  ;; The machine spec is registered via re-frame.machines/reg-machine. It
  ;; declares its OWN sensitive :data slot projection-relative (:sensitive
  ;; [[:data :token]]); the machine lifecycle lowers it per actor at boot. Its
  ;; :data-schema VALIDATES :data only (no :sensitive? prop, EP-0025). The
  ;; runner merges the realised :machine-action body into the spec's :actions slot.
  :machine
  {:dc/auth {:sensitive   [[:data :token]]
             :initial     :anon
             :data        {:retries 0 :token nil}
             :data-schema [:map
                           [:retries :int]
                           [:token [:maybe :string]]]
             :states      {:anon   {:on {:login {:target :authed
                                                 :action :dc/store-token}}}
                           :authed {}}}}}

 :fixture/handlers
 ;; Action signature (Spec 005 §Actions): (fn [{:keys [data event]}] {:data … :fx …}).
 ;; [:set [:token] [:event-arg 1]] writes the inner event's token arg into :data;
 ;; the inner event is [:login "secret-jwt"], so [:event-arg 1] is the token.
 {:machine-action
  {:dc/store-token [[:set [:token]   [:event-arg 1]]
                    [:set [:retries] 1]]}}

 :fixture/frame-config {}

 :fixture/dispatches
 ;; Inner-event sub-routing (Spec 005 §Registration): the outer event
 ;; [:dc/auth [:login "secret-jwt"]] yields inner-event [:login "secret-jwt"]
 ;; inside the handler, triggering the :anon → :authed transition whose action
 ;; writes the secret token into :data.
 [[:dc/auth [:login "secret-jwt"]]]

 :fixture/expect
 ;; The committed runtime-db snapshot carries the RAW token — redaction is a
 ;; trace-egress concern only.
 {:trace-emissions
  ;; The matcher partial-matches each trace by its named keys and matches a
  ;; map-valued :tags key one level deep, comparing each :tags entry by exact
  ;; value. The :after snapshot is asserted as a full literal map (small +
  ;; deterministic): the machine-declared :token slot redacts to :rf/redacted,
  ;; the unmarked :retries sibling rides verbatim, and the reserved
  ;; :rf/spawn-counter snapshot key is carried.
  [{:operation :rf.machine/transition
    :tags      {:actor-id :dc/auth
                :after      {:state :authed
                             :data  {:retries 1 :token :rf/redacted}
                             :rf/spawn-counter {}}}}
   {:operation :rf.machine/snapshot-updated
    :tags      {:actor-id :dc/auth
                :after      {:state :authed
                             :data  {:retries 1 :token :rf/redacted}
                             :rf/spawn-counter {}}}}]}}
