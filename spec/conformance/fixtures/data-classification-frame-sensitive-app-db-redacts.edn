;; Conformance fixture: data-classification/frame-sensitive-app-db-redacts
;;
;; Per Spec 015 §Tests (the `frame-sensitive-app-db-redacts.edn` row) — a
;; frame that classifies `[:auth :token]` sensitive (EP-0025 commit-plane
;; `:sensitive` classification effect), after an event writes a token to
;; `[:auth :token]`, projects `:rf/redacted` at that path in any off-box
;; record; an unmarked sibling passes through.
;;
;; The OBSERVABLE seam exercised here is the t1 `:rf.event/db-pending` trace
;; event (router `flows-after-interceptor`, rf2-ta0y7): it stamps the full
;; pending app-db value under `:rf.event/db`, and the trace-egress projection
;; (the classification trace projection → `elide-wire-value`) redacts the
;; frame-declared sensitive path BEFORE any listener observes it. t1 fires
;; whether or not the flows artefact is loaded.
;;
;; The committed app-db carries the RAW value — redaction is a trace-egress
;; concern only (Spec 015 §Out of scope — mid-handler protection; handlers
;; see real values). The data-classification contract lives on the t1 slot.
;;
;; Harness note: `:fixture/classification-effects` declares the sensitive path
;; against the established frame scope (`{:sensitive [[:auth :token]]}`),
;; installing it into the elision registry under `:source :effect` —
;; equivalent to a reg-event returning `:sensitive [[:auth :token]]` alongside
;; `:db` (EP-0025 commit-plane classification effect). Capability
;; `:data-classification/classification-effects`.

{:fixture/id           :data-classification/frame-sensitive-app-db-redacts
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/trace
                         :data-classification/classification-effects}
 :fixture/doc          "A frame that classifies [:auth :token] sensitive (EP-0025 commit-plane :sensitive effect), after an event writes a token to [:auth :token], projects :rf/redacted at that path in the t1 :rf.event/db-pending trace event's :rf.event/db slot; an unmarked sibling ([:auth :user]) rides egress verbatim. The committed app-db carries the raw value — redaction is a trace-egress concern."

 :fixture/registry
 {:event {:dc/login {:doc "Writes a secret token + an unmarked user id into app-db."}}}

 :fixture/handlers
 {:event {:dc/login [[:set [:auth :token] "super-secret"]
                     [:set [:auth :user]  "ada"]]}}

 ;; Declare [:auth :token] sensitive BEFORE the event writes it, so the t1
 ;; pending-db projection redacts that path at trace egress.
 :fixture/classification-effects
 [{:sensitive [[:auth :token]]}]

 :fixture/frame-config
 {:initial-events [[:dc/login]]}

 :fixture/dispatches
 [[:dc/login]]

 :fixture/expect
 ;; The committed app-db is the RAW value — redaction is trace-egress only.
 {:final-app-db {:auth {:token "super-secret" :user "ada"}}

  ;; The load-bearing assertion: the t1 pending-db snapshot redacts the
  ;; sensitive [:auth :token] and leaves the unmarked sibling [:auth :user]
  ;; raw. The full :rf.event/db map is asserted literally (small + deterministic).
  :trace-emissions
  [{:operation :rf.event/db-pending
    :tags      {:rf.event/db {:auth {:token :rf/redacted :user "ada"}}}}]}}
