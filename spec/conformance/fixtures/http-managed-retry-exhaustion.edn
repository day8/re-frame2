;; Conformance fixture: rf.http.managed/retry-exhaustion
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Retry ×
;; `:on-failure` semantics: only the final exhausted-retries failure
;; dispatches `:on-failure`; intermediate retriable attempts emit
;; `:rf.http/retry-attempt` traces but do NOT dispatch the failure handler.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-failure`, so no managed-HTTP code runs: no
;; attempt is made and nothing retries — the canned-failure body dispatches
;; one final failure it writes itself. What it grades is the redirection of
;; `:rf.http/managed` to that body, the args the body receives
;; (`:effects-routed`, the `:retry` policy verbatim) and the dispatch of the
;; reply it writes. The ;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/retry-exhaustion
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx
                         :rf.http/managed}
 :fixture/doc          "Shaped like Spec 014 §Retry and backoff's exhaustion case: a GET carrying a :retry policy of 3 attempts, redirected by :fx-overrides to the fixture's canned-failure body, which dispatches one final :rf.http/http-5xx failure to :on-failure. Grades override routing, args forwarding and reply dispatch; no attempt is made and nothing retries."

 :fixture/registry
 {:event {:flaky/load        {:doc "Issue the GET with retry policy."}
          :flaky/load-error  {:doc "Receive the final failure after :max-attempts exhausted."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-failure {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:flaky/load
   [[:fx [[:rf.http/managed
           {:request    {:method :get :url "/flaky"}
            :decode     :json
            :retry      {:on           #{:rf.http/http-5xx}
                         :max-attempts 3
                         :backoff      {:base-ms 5 :factor 1 :max-ms 10}}
            :on-failure [:flaky/load-error]}]]]]

   :flaky/load-error
   [[:set [:flaky :error] [:event-arg 1]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-failure
   ;; Final-after-retries-exhausted shape per Spec 014 §Reply payload shape.
   [[:dispatch [:flaky/load-error
                {:status :error
                 :error  {:kind        :rf.http/http-5xx
                          :status      503
                          :status-text "Service Unavailable"
                          :body        {:err true}
                          :headers     {}}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-failure}}

 :fixture/dispatches
 [[:flaky/load]]

 :fixture/expect
 {:final-app-db
  {:flaky {:error {:status :error
                   :error  {:kind        :rf.http/http-5xx
                            :status      503
                            :status-text "Service Unavailable"
                            :body        {:err true}
                            :headers     {}}}}}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :flaky/load}}
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-failure}}
   ;; The canned-failure body dispatches one final failure;
   ;; :rf.http/retry-attempt traces come only from the live fx, which does
   ;; not run here.
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :flaky/load-error}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-failure
    :args  {:request    {:method :get :url "/flaky"}
            :decode     :json
            :retry      {:on           #{:rf.http/http-5xx}
                         :max-attempts 3
                         :backoff      {:base-ms 5 :factor 1 :max-ms 10}}
            :on-failure [:flaky/load-error]}}]}}
