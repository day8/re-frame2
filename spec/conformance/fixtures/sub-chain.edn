;; Conformance fixture: sub/chain
;; Subscriptions chained through `:inputs`. Layer 2 subs derive from layer 1 subs, never
;; reading app-db directly. Implementations must support `:inputs` composition.

{:fixture/id           :sub/chain
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/sub}
 :fixture/doc          "A sub composed via :inputs against another sub. Total derives from items; updating items propagates."

 :fixture/registry
 {:event {:cart/initialise {:doc "Seed the cart."}
          :cart.item/add   {:doc "Add an item's amount, its qty * price."}}
  :sub   {:cart/items {:doc "The item amounts in the cart."}
          :cart/total {:doc "Sum of the item amounts — a declared-input derivation over :cart/items."}}}

 :fixture/handlers
 {:event {:cart/initialise [[:set [:cart] {:items []}]]
          :cart.item/add   [[:update [:cart :items] [:fn :conj [:event-arg 1]]]]}
  :sub   {:cart/items [[:get [:cart :items]]]
          :cart/total [[:reduce-input :cart/items
                        [:fn :+]
                        [:fn :identity]]]}}

 :fixture/frame-config
 {:initial-events [[:cart/initialise]]}

 :fixture/dispatches
 [[:cart.item/add 19.98]        ;; 2 at 9.99
  [:cart.item/add 4.50]]        ;; 1 at 4.50

 :fixture/expect
 {:final-app-db
  {:cart {:items [19.98 4.50]}}

  :sub-values
  {[:cart/items] [19.98 4.50]
   [:cart/total] 24.48}}}
