;; Conformance fixture: routing/history-popstate
;;
;; Per Spec 012 §URL changes are events: popstate, the initial load and
;; the SSR request URL all arrive as `:rf.route/handle-url-change`. ONE
;; event stands for THREE doors, so the `:url-bound?` frame lifecycle's
;; listener names which one it is via the runtime-internal
;; `:rf.route/cause` rider on the event's trailing opts map — `:popstate`
;; from the browser-driven callback, `:initial` from the same listener's
;; initial URL sync (per [012 §The request grammar]
;; (#the-request-grammar--address-policy-and-edit-keys)). A rider-free
;; dispatch on a client frame IS the initial / direct-URL feed, so a
;; fixture claiming to be the popstate contract must carry the rider or
;; it exercises `:initial` under a popstate name.
;;
;; The runtime parses the URL via `match-url`, writes the canonical
;; :rf/route slice (`:id` / `:params` / `:query` / `:fragment` /
;; `:nav-token` / ...), and emits `:rf.nav/scroll` with the
;; popstate-default `:restore` strategy. Crucially, the URL came FROM the
;; browser — the runtime MUST NOT push it back via `:rf.nav/push-url` /
;; `:rf.nav/replace-url`.
;;
;; This fixture pins the cross-implementation contract for the
;; popstate-driven URL-change cascade:
;;   1. :rf/route slice round-trips from the URL.
;;   2. The default scroll strategy is :restore (the saved position
;;      trumps; forward-navigation default is :top — exercised by
;;      routing-scroll-restoration.edn).
;;   3. NO :rf.nav/push-url / :rf.nav/replace-url fires (the URL is
;;      already in the address bar).
;;   4. The commit's `:rf.route/planned` projection reports
;;      `:cause :popstate` — the door the rider named, not `:initial`.
;;
;; Per [012 §URL changes are events] (#url-changes-are-events),
;; [§Resolved target and the plan diagnostic projection]
;; (#resolved-target-and-the-plan-diagnostic-projection) and
;; [§Scroll restoration] (#scroll-restoration).

{:fixture/id           :routing/history-popstate
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:routing/match-url :core/event-handler :core/fx :core/trace}
 :fixture/doc          "Popstate-driven URL change: dispatch [:rf.route/handle-url-change url {:rf.route/cause :popstate}] exactly as the :url-bound? frame lifecycle's listener does. The :rf/route slice round-trips from the URL; :rf.nav/scroll fires with the popstate-default :restore strategy; the runtime does NOT push or replace the URL (it came from the browser); and the commit's :rf.route/planned projection reports :cause :popstate."

 :fixture/registry
 {:event {:rf/init                    {:doc "Seed."}
          :rf.route/handle-url-change {:doc "Browser-driven URL change (popstate / initial / SSR)."}}
  :sub   {:rf/route {:doc "Current route."}}
  :route {:route/home    {:path "/"}
          :route/article {:path   "/articles/:id"
                          :params [:map [:id :string]]}}
  :fx    {:rf.nav/push-url    {:platforms #{:client}}
          :rf.nav/replace-url {:platforms #{:client}}
          :rf.nav/scroll      {:platforms #{:client}}}}

 ;; Per rf2-xak8u: no :sub override for :rf/route — the framework's
 ;; :rf/route sub reads the slice at [:rf.runtime/routing :current]
 ;; directly — no projection — and that is what consumers see. A fixture-DSL `[[:get [:rf/route]]]` body would return the
 ;; full container (including the internal counters), so we let the
 ;; real sub stand.
 :fixture/handlers
 {:event {:rf/init [[:set-runtime [:rf.runtime/routing :current] {:route-id :route/home :params {}}]]}
  :fx    {:rf.nav/push-url    [[:noop]]
          :rf.nav/replace-url [[:noop]]
          :rf.nav/scroll      [[:noop]]}}

 ;; :platform :client so the navigation fxs (declared `:platforms
 ;; #{:client}`) are actually routed, mirroring the routing-navigate.edn
 ;; fixture shape.
 :fixture/frame-config {:initial-events [[:rf/init]] :platform :client}

 :fixture/dispatches
 [;; Simulate a popstate landing on /articles/intro. The `:rf.route/cause`
  ;; rider is what makes this a POPSTATE rather than an initial-load feed —
  ;; the lifecycle's listener stamps it, and without it the identical
  ;; dispatch on a client frame resolves as `:initial`.
  [:rf.route/handle-url-change "/articles/intro" {:rf.route/cause :popstate}]]

 :fixture/expect
 {:final-runtime-db {:rf.runtime/routing {:current {:route-id     :route/article
              :params {:id "intro"}}}}

  ;; Per rf2-xak8u (Option-A): the :rf/route layer-1 sub projects the
  ;; slice keys only. The nav-token / pending-nav counters are NOT
  ;; runtime-db state — they live in a host-side transient cache
  ;; (rf2-oosjmh) — so they never surface through the sub.
  :sub-values
  {[:rf/route] {:route-id         :route/article
                :params     {:id "intro"}
                :query      {}
                :fragment   nil
                :transition :idle
                :error      nil
                :nav-token  "nav-1"}}

  ;; Critical contract: ONLY :rf.nav/scroll routes — the runtime MUST
  ;; NOT push or replace the URL when the URL change ORIGINATED at the
  ;; browser. The :restore strategy is the popstate / initial / SSR
  ;; default (per Spec 012 §Scroll restoration step 3).
  :effects-routed
  [{:fx-id :rf.nav/scroll
    :args  {:strategy :restore
            :from     {:id :route/home}
            :to       {:id :route/article :params {:id "intro"}}}}]

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :rf/init}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :rf.route/handle-url-change}}
   ;; The commit branch emits ONE plan projection, and its `:cause` is the
   ;; door the rider named. This is the assertion that makes the fixture
   ;; bite: dropping the rider from the dispatch above reds it with
   ;; `:cause :initial`. `:param-keys` is the resolved params' KEY SET —
   ;; never their values (per 012 §Resolved target).
   {:operation :rf.route/planned
    :tags      {:cause      :popstate
                :route-id   :route/article
                :url        "/articles/intro"
                :param-keys [:id]
                :query-keys []}}]}}
