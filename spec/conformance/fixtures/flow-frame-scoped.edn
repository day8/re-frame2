;; Conformance fixture: flow/frame-scoped
;; Per Spec 013 §Activation — a flow is a top-level registration, and a
;; frame runs the flows its `:flows` config names, and no others. Two
;; normative consequences this fixture pins:
;;
;;   Contract 1 (sibling-frame isolation). An event dispatched on one frame
;;     evaluates ONLY the flows that frame runs; the sibling frame's app-db
;;     and flow outputs are untouched (§Drain integration property 4,
;;     "Frame isolation").
;;
;;   Contract 2 (two derivations are two ids). `:compute/double` and
;;     `:compute/cent` both read `[:x]` and write `[:result]`. No frame runs
;;     both, so the shared output path is legal (the overlap check is per
;;     frame), and the same input value in each frame yields that frame's
;;     own output.

{:fixture/id           :flow/frame-scoped
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :flow/basic :flow/frame-scoped}
 :fixture/doc          "Flows are activated per frame (Spec 013 §Activation). Two frames run two different flows over the same input and output paths; an event dispatched on one frame evaluates only that frame's flow, and each frame holds its own output."

 :fixture/registry
 {:event {:tenant/init  {:doc "Seed :x on the dispatching frame."}
          :tenant/set-x {:doc "Mutate :x on the dispatching frame to drive a flow recompute."}}
  :flow  {:compute/double {:doc         "Twice :x, at :result."
                           :inputs      [[:x]]
                           :output-path [:result]}
          :compute/cent   {:doc         "A hundred times :x, at :result."
                           :inputs      [[:x]]
                           :output-path [:result]}}}

 :fixture/handlers
 {:event {:tenant/init  [[:set [:x] 1]]
          :tenant/set-x [[:set [:x] [:event-arg 1]]]}}

 :fixture/flow-bodies
 {:compute/double [[:fn :* [:event-arg 0] 2]]
  :compute/cent   [[:fn :* [:event-arg 0] 100]]}

 ;; Each frame seeds :x through its own :initial-events cascade, whose drain
 ;; evaluates the frame's flow for the first time.
 :fixture/frames
 [{:id :left  :flows [:compute/double] :initial-events [[:tenant/init]]}
  {:id :right :flows [:compute/cent]   :initial-events [[:tenant/init]]}]

 ;; Sequence:
 ;;   1. {:event [:tenant/set-x 5] :frame :left}
 ;;        :left's :compute/double recomputes → :left :result 10. :right's
 ;;        :x is still 1 and its :result still 100 (Contract 1).
 ;;   2. {:event [:tenant/set-x 5] :frame :right}
 ;;        :right's :compute/cent recomputes → :right :result 500. Same input
 ;;        as :left, its own derivation (Contract 2).
 :fixture/dispatches
 [{:event [:tenant/set-x 5] :frame :left}
  {:event [:tenant/set-x 5] :frame :right}]

 :fixture/expect
 {:final-app-dbs
  {:left  {:x 5 :result 10}
   :right {:x 5 :result 500}}

  ;; The flows each frame's config names.
  :flow-registry-after
  {:left  #{:compute/double}
   :right #{:compute/cent}}

  ;; Each flow computed twice — on its frame's seeding event and on that
  ;; frame's set-x — and never on the sibling's events (Contract 1).
  :flow-recompute-counts
  {:compute/double 2
   :compute/cent   2}

  ;; Both definitions are ordinary registrations.
  :registrar-flow-slots-after
  #{:compute/double :compute/cent}}}
