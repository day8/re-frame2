;; Conformance fixture: rf.http.managed/get-success
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §The shape and
;; §`:accept`: a GET decoded as JSON whose success reply reaches the
;; `:on-success` target as the canonical `{:status :ok :value <decoded>}`
;; envelope.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-success`, so no managed-HTTP code runs: nothing
;; is decoded and no envelope is synthesised. What it grades is the
;; redirection of `:rf.http/managed` to the canned-success body, the args
;; that body receives (`:effects-routed`) and the dispatch of the reply the
;; body writes. The ;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/get-success
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/sub :core/fx
                         :rf.http/managed}
 :fixture/doc          "GET /articles/hello with :decode :json, redirected by :fx-overrides to the fixture's canned-success body, which dispatches {:status :ok :value {:title \"hello\" :id 42}} to the :on-success target :article/loaded; the target writes it to [:article]. Grades override routing, args forwarding and reply dispatch, not managed HTTP."

 :fixture/registry
 {:event {:article/load   {:doc "Issue the GET."}
          :article/loaded {:doc "Receive the payload."}}
  :sub   {:article {:doc "The article slice."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-success {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:article/load
   [[:fx [[:rf.http/managed
           {:request {:method :get :url "/articles/hello"}
            :decode  :json
            :on-success [:article/loaded]}]]]]

   :article/loaded
   [[:set [:article] [:event-arg 1]]]}

  :sub
  {:article [[:get [:article]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-success
   [[:dispatch [:article/loaded {:status :ok
                                 :value  {:title "hello" :id 42}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-success}}

 :fixture/dispatches
 [[:article/load]]

 :fixture/expect
 {:final-app-db
  {:article {:status :ok
             :value  {:title "hello" :id 42}}}

  :sub-values
  {[:article] {:status :ok
               :value  {:title "hello" :id 42}}}

  :trace-emissions
  [{:operation :rf.event/run-start :op-type :rf.event :tags {:rf.trace/event-id :article/load}}
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-success}}
   {:operation :rf.event/run-start :op-type :rf.event :tags {:rf.trace/event-id :article/loaded}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-success
    :args  {:request    {:method :get :url "/articles/hello"}
            :decode     :json
            :on-success [:article/loaded]}}]}}
