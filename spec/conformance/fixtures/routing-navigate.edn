;; Conformance fixture: routing/navigate
;; :rf.route/navigate updates app-db AND emits a :rf.nav/push-url effect.

{:fixture/id           :routing/navigate
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:routing/match-url :core/event-handler :core/fx}
 :fixture/doc          "User-initiated navigation: dispatch [:rf.route/navigate :route-id params]. Updates app-db's :rf/route slice and emits a :rf.nav/push-url effect with the URL."

 :fixture/registry
 {:event {:rf/init        {:doc "Seed."}
          :rf.route/navigate {:doc "Navigate to a registered route."}}
  :sub   {:rf/route {:doc "Current route."}}
  :route {:route/home          {:path "/"}
          :route/articles      {:path "/articles"}
          :route/article-detail {:path "/articles/:id"
                                 :params [:map [:id :string]]}}
  :fx    {:rf.nav/push-url        {:platforms #{:client}}}}

 ;; The fixture intentionally does NOT override :rf.route/navigate — the
 ;; runtime's built-in handler (per Spec 012) computes the URL via
 ;; route-url and emits :rf.nav/push-url, which is exactly what
 ;; :effects-routed asserts.
 ;;
 ;; Per rf2-xak8u: no :sub override for :rf/route either — the
 ;; framework's route-sub-fn projects the slice (select-keys over the
 ;; routing-runtime container at app-db :rf/route), which is what
 ;; consumers see. A fixture-DSL `[[:get [:rf/route]]]` body would
 ;; return the full container (including the internal counters), so
 ;; we let the real sub stand.
 :fixture/handlers
 {:event {:rf/init [[:set-runtime [:rf.runtime/routing :current] {:route-id :route/home :params {}}]]}
  :fx    {:rf.nav/push-url [[:noop]]}}

 ;; :rf.nav/push-url declares :platforms #{:client}; the frame runs on the
 ;; client platform so the fx is actually routed (per Spec 002 §`:platforms`
 ;; gating on reg-fx).
 :fixture/frame-config {:initial-events [[:rf/init]] :platform :client}

 :fixture/dispatches
 [[:rf.route/navigate :route/articles]
  [:rf.route/navigate :route/article-detail {:id "intro"}]]

 :fixture/expect
 ;; The runtime's :rf.route/navigate handler writes the canonical slice
 ;; (per Spec 012 §The :rf/route slice): :id, :params, :query, :fragment,
 ;; :transition, :error, :nav-token. The :final-app-db submap match
 ;; tolerates the additional keys; the :sub-values check is exact, so
 ;; the expected slice mirrors what the :rf/route sub publishes.
 ;;
 ;; Per rf2-xak8u (Option-A): the :rf/route layer-1 sub projects the
 ;; slice keys only. The nav-token / pending-nav counters are NOT
 ;; runtime-db state — they live in a host-side transient cache
 ;; (rf2-oosjmh) — so :final-runtime-db carries only :current and
 ;; :sub-values asserts the slice-only shape.
 {:final-runtime-db {:rf.runtime/routing {:current {:route-id :route/article-detail :params {:id "intro"}}}}

  :sub-values   {[:rf/route] {:route-id         :route/article-detail
                              :params     {:id "intro"}
                              :query      {}
                              :fragment   nil
                              :transition :idle
                              :error      nil
                              :nav-token  "nav-2"}}

  :effects-routed
  [{:fx-id :rf.nav/push-url :args "/articles"}
   {:fx-id :rf.nav/push-url :args "/articles/intro"}]

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :rf/init}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :rf.route/navigate}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :rf.route/navigate}}]}}
