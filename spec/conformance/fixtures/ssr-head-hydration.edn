;; Conformance fixture: ssr/head-hydration
;; The hydration payload carries a BODY-ONLY :rf/render-hash AND a SEPARATE
;; :rf/head-hash over the canonical head model (rf2-1oxjxk, Option B). The
;; client recomputes both hashes (body via :render-tree-fn; head via
;; active-head against the hydrated state) and they match — no
;; :rf.ssr/hydration-mismatch (failing-id :rf.ssr/head-mismatch) emitted.
;; Per [011 §Mismatch detection — head].

{:fixture/id           :ssr/head-hydration
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :ssr/head-contract :ssr/hydration}
 :fixture/doc          "Hydration payload carries a BODY-ONLY :rf/render-hash and a SEPARATE :rf/head-hash over the canonical head model (rf2-1oxjxk); the client recomputes both and they match; no :rf.ssr/hydration-mismatch (failing-id :rf.ssr/head-mismatch) emitted. The head channel is omitted for explicit-:head-STRING requests."

 :fixture/registry
 {:event {:rf/hydrate {:doc "Standard hydration handler."}}
  :route {:route/article {:doc "Article page." :path "/articles/:id" :head :head/article}}
  :head  {:head/article {:doc "Article-page head model."}}}

 :fixture/handlers
 {:event {;; EP-0001 (rf2-vzld77): hydration installs BOTH partitions — the
          ;; payload's `:rf/app-db` into app-db AND its `:rf/runtime-db`
          ;; (the durable route slice) into the runtime-db partition.
          :rf/hydrate [[:set [] [:get-event-arg 1 :rf/app-db]]
                       [:set-runtime [] [:get-event-arg 1 :rf/runtime-db]]]}
  :head  {:head/article
          [[:return-head
            {:title "Article: re-frame2 SSR — Example"
             :meta  [{:name "description" :content "How re-frame2 ships SSR"}]
             :link  [{:rel "canonical" :href "https://example.com/articles/123"}]}]]}}

 :fixture/frame-config {:initial-events [] :platform :client}

 :fixture/dispatches
 ;; Per Spec 011 §The :rf/hydrate event the payload's `:rf/app-db`
 ;; carries the active-route slice under the canonical `:rf/route`
 ;; key (matching Spec 004 §Active-route storage). The runtime's
 ;; `active-head` reads `:rf/route` to find the route-id whose `:head`
 ;; metadata names the head fn to invoke.
 ;; EP-0001 (rf2-vzld77): the active-route slice is durable routing
 ;; runtime-db state, so it rides the payload's `:rf/runtime-db` slice; the
 ;; `:rf/app-db` slice carries only application data.
 [[:rf/hydrate {:rf/version    1
                :rf/frame-id   :rf/default
                :rf/app-db     {:articles {"123" {:title "re-frame2 SSR"
                                                  :summary "How re-frame2 ships SSR"}}}
                :rf/runtime-db {:rf.runtime/routing {:current {:route-id :route/article :params {:id "123"}}}}
                ;; rf2-1oxjxk: BODY-ONLY :rf/render-hash + a SEPARATE
                ;; :rf/head-hash over the canonical head model.
                :rf/render-hash "render-hash-server-A"
                :rf/head-hash   "head-hash-server-A"}]]

 :fixture/render-after-hydrate
 ;; Harness simulates the client recomputing BOTH channels to the same
 ;; hashes: the BODY render-tree (via :render-tree-fn) matches
 ;; :rf/render-hash, and the head model (recomputed via active-head against
 ;; the hydrated state) matches :rf/head-hash. No mismatch trace. Per Spec
 ;; 011 §Mismatch detection — head: body and head ride SEPARATE channels
 ;; (rf2-1oxjxk); a host attributes a head-only mismatch via :failing-id.
 {:simulated-client-render-hash "render-hash-server-A"
  :simulated-client-head-hash   "head-hash-server-A"}

 :fixture/expect
 {:final-app-db {:articles {"123" {:title "re-frame2 SSR"
                                   :summary "How re-frame2 ships SSR"}}}

  :final-runtime-db {:rf.runtime/routing {:current {:route-id :route/article :params {:id "123"}}}}

  :ssr/active-head
  {:title "Article: re-frame2 SSR — Example"
   :meta  [{:name "description" :content "How re-frame2 ships SSR"}]
   :link  [{:rel "canonical" :href "https://example.com/articles/123"}]}

  ;; Importantly: NO :rf.ssr/hydration-mismatch trace with the
  ;; head discriminator (:failing-id :rf.ssr/head-mismatch).
  ;; :source is a TOP-LEVEL field per Spec 009 §Required top-level fields,
  ;; not a key inside :tags.
  :trace-emissions
  [{:operation :rf.event/run-start :source :ssr-hydration :tags {:rf.trace/event-id :rf/hydrate}}]

  :trace-not-emitted
  [{:operation :rf.ssr/hydration-mismatch
    :tags      {:failing-id :rf.ssr/head-mismatch}}]}}
