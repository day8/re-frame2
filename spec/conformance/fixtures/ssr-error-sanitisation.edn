;; Conformance fixture: ssr/error-sanitisation
;; A handler throws during the SSR RENDER-TIME drain (a post-construction
;; request dispatch — NOT the :initial-events setup step). The runtime
;; captures the full structured trace event (with exception detail). The
;; active error projector produces a sanitised :rf/public-error and stamps
;; :status 500 onto the response accumulator. The :rf/response slot carries
;; ONLY the public projection's :status; the rendered HTML body would
;; contain NO stack trace, NO exception message, NO internal detail.
;; Asserts the projector's output (writes to :rf/response) — NOT a
;; user-stub-rolled :rf.server/set-status fx. Per [011 §Server error
;; projection].
;;
;; rf2-vw5h1r: the throwing :load/article dispatch is a RENDER-TIME request
;; dispatch (`:fixture/dispatches`), NOT a construction `:initial-events`
;; step. Construction-time :initial-events is now STRICT (EP-0027 §Failure,
;; Mike-ruled (a)): a THROWN setup step tears the partial frame down and is
;; the OUTER `:on-error` transport path (Spec 011 §`:on-error` vs
;; `:error-view`), NOT a projector-catches-it case. The error PROJECTOR
;; covers errors INSIDE the render/cascade drain — exactly what a post-
;; construction request dispatch models. So :rf/server-init is a clean
;; setup step; the throwing handler fires afterward, in the projector's
;; domain.

{:fixture/id           :ssr/error-sanitisation
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/error :ssr/error-projection}
 :fixture/doc          "A handler throws. Internal trace event carries full :exception-message; the runtime's default projector maps it to {:status 500 :code :internal-error :message \"Something went wrong\" :retryable? false} and writes :status 500 to the response accumulator. Asserts the projector's output, not a user-stub-rolled fx."

 :fixture/registry
 {:event {:rf/server-init   {:platforms #{:server}}
          :load/article     {:doc "Throws — used to trigger projection." :platforms #{:server}}}
  ;; :rf.ssr/default-error-projector ships with the runtime
  ;; (re-frame.ssr/reg-error-projector at ns-load).
  :error-projector
        {:rf.ssr/default-error-projector
         {:doc "The runtime's default error projector — generic 500 in prod."}}}

 :fixture/handlers
 ;; :rf/server-init is now a CLEAN setup step (no-op write) — construction
 ;; succeeds and the frame is alive for the render-time request dispatch. The
 ;; throwing handler runs AFTER construction, in the projector's drain-time
 ;; domain.
 {:event {:rf/server-init [[:set [] {}]]
          :load/article   [[:throw "Database connection failed: SECRET_TOKEN=xyz"]]}}

 :fixture/frame-config {:initial-events [[:rf/server-init]]
                        :platform :server
                        :ssr {:public-error-id   :rf.ssr/default-error-projector
                              :dev-error-detail? false}}      ;; prod-mode default

 ;; The render-time request dispatch that throws — the error the projector
 ;; catches. dispatch-sync traces it as :rf.error/handler-exception and
 ;; recovers in-band (no escaping throw), so the fixture run continues and the
 ;; :ssr/public-error check below projects the captured trace.
 :fixture/dispatches [[:load/article]]

 :fixture/expect
 {;; The runtime's error-projection listener writes :status 500 to the
  ;; response accumulator (the locked generic-500 from the default
  ;; projector). The accumulator is a framework-private side-channel
  ;; atom keyed on frame-id (rf2-jbcmt) — NOT in app-db — so the
  ;; projector's output is pinned via :ssr/public-error below; the
  ;; final app-db is empty (the throw aborted the handler before any
  ;; user-visible state could land).
  :final-app-db {}

  ;; Internal trace event preserves full detail (for monitoring).
  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :rf/server-init}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :load/article}}
   {:operation :rf.error/handler-exception
    :op-type   :error
    :tags      {:category          :rf.error/handler-exception
                :failing-id        :load/article
                :exception-message "Database connection failed: SECRET_TOKEN=xyz"}}]

  ;; Public-error shape produced by the runtime's default projector.
  ;; Note the prod-shape is the locked four keys only — :details is
  ;; absent because :dev-error-detail? false. The internal trace
  ;; (above) still carries the full SECRET_TOKEN exception message;
  ;; sanitisation is a property of the public projection, not of the
  ;; trace stream.
  :ssr/public-error
  {:status     500
   :code       :internal-error
   :message    "Something went wrong"
   :retryable? false}}}
