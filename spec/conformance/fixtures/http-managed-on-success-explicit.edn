;; Conformance fixture: rf.http.managed/on-success-explicit
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Reply addressing
;; §Split target — separate handlers: with `:on-success [:event-id ...args]`
;; the runtime appends the canonical `{:status :ok :value v}` reply envelope
;; as the last argument of that event, which routes to the named handler
;; and not back to the originator.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-success`, so no managed-HTTP code runs: the
;; canned-success body names the target and appends the reply itself, so no
;; reply target is selected. What it grades is the redirection of
;; `:rf.http/managed` to that body, the args the body receives
;; (`:effects-routed`, the `:on-success` vector with its prefix arg) and the
;; dispatch of the reply it writes, with the prefix arg reaching the handler
;; ahead of the reply. The ;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/on-success-explicit
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/sub :core/fx
                         :rf.http/managed}
 :fixture/doc          "Shaped like Spec 014's split-target reply addressing: :on-success [:article/loaded :hello], redirected by :fx-overrides to the fixture's canned-success body, which dispatches [:article/loaded :hello {:status :ok :value v}] itself; the handler stores the prefix arg and the reply. Grades override routing, args forwarding and reply dispatch, not reply-target selection."

 :fixture/registry
 {:event {:article/load   {:doc "Issue the GET (originator)."}
          :article/loaded {:doc "Receive the success payload (explicit target)."}}
  :sub   {:article {:doc "The article slice."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-success {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:article/load
   [[:fx [[:rf.http/managed
           {:request    {:method :get :url "/articles/hello"}
            :decode     :json
            :on-success [:article/loaded :hello]}]]]]

   ;; The explicit target receives [:article/loaded :hello {:status :ok ...}]
   ;; — :event-arg 1 is :hello (the prefix arg), :event-arg 2 is the reply.
   :article/loaded
   [[:set [:article :slug]    [:event-arg 1]]
    [:set [:article :payload] [:event-arg 2]]]}

  :sub
  {:article [[:get [:article]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-success
   [[:dispatch [:article/loaded :hello {:status :ok
                                        :value  {:title "hello" :id 42}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-success}}

 :fixture/dispatches
 [[:article/load]]

 :fixture/expect
 {:final-app-db
  {:article {:slug    :hello
             :payload {:status :ok
                       :value  {:title "hello" :id 42}}}}

  :sub-values
  {[:article] {:slug    :hello
               :payload {:status :ok
                         :value  {:title "hello" :id 42}}}}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :article/load}}
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-success}}
   ;; The canned-success body dispatches :article/loaded, the addressed
   ;; target.
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :article/loaded}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-success
    :args  {:request    {:method :get :url "/articles/hello"}
            :decode     :json
            :on-success [:article/loaded :hello]}}]}}
