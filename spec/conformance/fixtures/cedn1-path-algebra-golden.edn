;; Conformance fixture: identity/cedn1-path-algebra-golden
;;
;; EP-0012 (`:rf/path` algebra + CEDN-1 canonical identity). Per the EP
;; §Validation/Conformance: "Conforming implementations SHOULD validate this
;; EP with property tests AND small cross-host fixtures" and the
;; Canonical-identity conformance list: "Pin FIXTURES for heterogeneous map
;; keys that the canonical encoder supports."
;;
;; This is the FROZEN cross-host byte-contract for the EP-0012 foundation
;; (rf2-qyb9l1). The live dual-host `.cljc` property + example tests
;; (`identity-cedn1-cljs-test`, `path-laws-cljs-test`) exercise the encoder
;; on each host; this fixture pins the EXACT CEDN-1 token stream a value
;; encodes to, so an encoder rewrite that silently changed the bytes would
;; fail the conformance corpus on BOTH the JVM and CLJS runners — a static
;; contract a live property test cannot give (it compares to itself, not to
;; a frozen string). It is the concrete target a non-Clojure port aims at
;; (the EP's stated motivation: "gives non-Clojure ports a concrete target").
;;
;; Capabilities exercised:
;;   :identity/cedn1 — the canonical-bytes encoding + identical-identity?
;;                     comparison, and the `:rf/path` instantiate boundary.
;;
;; Call ops (see the conformance runner's run-call):
;;   :canonical-bytes      {:value V :expect "<token-string>"}
;;   :canonical-value      {:value V :expect NORMALIZED}  ;; the `canonical` value
;;   :canonical-identical  {:a A :b B}            ;; A and B share ONE identity
;;   :canonical-distinct   {:a A :b B}            ;; A and B are DISTINCT facts
;;   :path-instantiate     {:path P :bindings M :expect CONCRETE}
;;                         {:path P :bindings M :expect-error :rf.error/...}
;;   :path-get             {:value V :path P [:not-found NF] :expect FOCUS}
;;   :path-lookup          {:value V :path P :expect {:present? .. [:value ..]}}
;;   :path-put             {:value V :path P :x X :expect V'}
;;   :path-over            {:value V :path P :fn (:inc|:wrap-vec) :expect V'}
;;   :path-compose         {:p P :q Q :expect CANONICAL-VECTOR}
;;   :path-prefix          {:p P :q Q :expect bool}
;;   :path-overlap         {:p P :q Q :expect bool}

{:fixture/id           :identity/cedn1-path-algebra-golden
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:identity/cedn1}
 :fixture/doc          "Frozen CEDN-1 canonical-bytes token contract for the EP-0012 foundation: scalars, vector-vs-list kind distinction, set / map canonical ordering, heterogeneous map keys, instants, plus the `:rf/path` instantiate concrete-path-producer boundary (a host/composite binding fails closed). The bytes are pinned so an encoder rewrite that changed them fails the corpus on both hosts."

 :fixture/calls
 [;; --- scalars: the type tag keeps distinct EDN kinds distinct ----------
  {:call :canonical-bytes :value "42"      :expect "s:\"42\""}
  {:call :canonical-bytes :value 42        :expect "i:42"}
  {:call :canonical-bytes :value :answer   :expect "k::answer"}
  {:call :canonical-bytes :value sym       :expect "y:sym"}
  {:call :canonical-bytes :value true      :expect "b:1"}
  {:call :canonical-bytes :value false     :expect "b:0"}
  {:call :canonical-bytes :value nil       :expect "n"}
  {:call :canonical-bytes
   :value #uuid "00000000-0000-0000-0000-000000000001"
   :expect "u:00000000-0000-0000-0000-000000000001"}
  {:call :canonical-bytes
   :value #inst "2026-06-12T00:00:00.000-00:00"
   :expect "t:2026-06-12T00:00:00.000Z"}

  ;; --- rf2-eynsfe: the reserved tagged-instant canonical form -----------
  ;; `canonical` normalizes an instant to the reserved tagged tuple
  ;; [:rf.identity/instant "<UTC millisecond text>"]; `canonical-bytes` emits
  ;; the SAME t:<text> token for a host instant AND for that tuple (a plain
  ;; string stays s:), so the FROZEN #inst canonical-bytes token above is
  ;; UNCHANGED while an instant stays DISTINCT from a look-alike string on both
  ;; surfaces. (This is NOT CEDN-2 — no pre-existing token changed.)
  {:call :canonical-value
   :value #inst "2026-06-12T00:00:00.000-00:00"
   :expect [:rf.identity/instant "2026-06-12T00:00:00.000Z"]}
  ;; idempotence: canonical of the already-tagged tuple returns it unchanged.
  {:call :canonical-value
   :value [:rf.identity/instant "2026-06-12T00:00:00.000Z"]
   :expect [:rf.identity/instant "2026-06-12T00:00:00.000Z"]}
  ;; the tagged tuple encodes to the SAME t: token as the host instant.
  {:call :canonical-bytes
   :value [:rf.identity/instant "2026-06-12T00:00:00.000Z"]
   :expect "t:2026-06-12T00:00:00.000Z"}
  ;; an instant and a LOOK-ALIKE string are DISTINCT identities on both surfaces.
  {:call :canonical-distinct
   :a #inst "2026-06-12T00:00:00.000-00:00"
   :b "2026-06-12T00:00:00.000Z"}
  ;; a heterogeneous instant+string-keyed map is a LEGAL two-entry map; the
  ;; keys order by their CEDN-1 bytes (s:"…" sorts before t:…).
  {:call :canonical-bytes
   :value {#inst "2026-06-12T00:00:00.000-00:00" :i "2026-06-12T00:00:00.000Z" :s}
   :expect "m{s:\"2026-06-12T00:00:00.000Z\" k::s t:2026-06-12T00:00:00.000Z k::i}"}

  ;; --- vector vs list: DISTINCT EDN facts, never collapsed --------------
  {:call :canonical-bytes :value [1 2 3]     :expect "v[i:1 i:2 i:3]"}
  {:call :canonical-bytes :value (1 2 3)     :expect "l(i:1 i:2 i:3)"}
  ;; the authoritative identities differ (the `=`-collapse rf2-o84qq2
  ;; notwithstanding — CEDN-1 is the authoritative identity).
  {:call :canonical-distinct :a [1 2 3] :b (1 2 3)}

  ;; --- map canonical KEY ORDER: insertion order is not identity ---------
  {:call :canonical-bytes :value {:b 2 :a 1} :expect "m{k::a i:1 k::b i:2}"}
  {:call :canonical-bytes :value {:a 1 :b 2} :expect "m{k::a i:1 k::b i:2}"}
  {:call :canonical-identical :a {:b 2 :a 1} :b {:a 1 :b 2}}

  ;; --- a map mixing value kinds incl. present-nil (distinct from absent) -
  {:call :canonical-bytes
   :value {:k "v" :n 42 :ok true :nada nil}
   :expect "m{k::k s:\"v\" k::n i:42 k::nada n k::ok b:1}"}

  ;; --- set canonical ELEMENT ORDER --------------------------------------
  {:call :canonical-bytes :value #{:m :x :a} :expect "q#{k::a k::m k::x}"}
  {:call :canonical-identical :a #{:m :x :a} :b #{:a :x :m}}

  ;; --- HETEROGENEOUS map keys (the EP's named fixture obligation): a
  ;;     vector key alongside a keyword key, both canonically ordered by
  ;;     their key CEDN-1 bytes.
  {:call :canonical-bytes
   :value {[:nested :key] 1 :flat 2}
   :expect "m{k::flat i:2 v[k::nested k::key] i:1}"}

  ;; --- the `:rf/path` instantiate concrete-path-producer boundary -------
  ;; A fully-bound template instantiates to a concrete path.
  {:call :path-instantiate
   :path     [:billing :invoices :by-id [:rf.path/param :invoice-id] :email]
   :bindings {:invoice-id "iid"}
   :expect   [:billing :invoices :by-id "iid" :email]}
  ;; A present-nil binding is a legal concrete segment.
  {:call :path-instantiate
   :path [:a [:rf.path/param :x] :c] :bindings {:x nil}
   :expect [:a nil :c]}
  ;; rf2-ehkut7: a COMPOSITE (vector) binding fails closed — it would
  ;; smuggle a non-concrete segment into a path presented as concrete.
  {:call :path-instantiate
   :path [:by-id [:rf.path/param :id]] :bindings {:id [:nested]}
   :expect-error :rf.error/bad-path}
  ;; an UNBOUND param fails closed with the missing-param error.
  {:call :path-instantiate
   :path [:a [:rf.path/param :x]] :bindings {}
   :expect-error :rf.error/missing-path-param}

  ;; --- the `:rf/path` algebra LAWS (rf2-du585y): the frozen get/put/over/
  ;;     compose/prefix/overlap laws become a non-Clojure conformance target
  ;;     so a port implementing only CEDN bytes + template instantiation no
  ;;     longer passes EP-0012 conformance. (Conventions §Path laws.)

  ;; root path [] focuses the whole value (the law raw assoc-in violates).
  {:call :path-get    :value {:a 1} :path [] :expect {:a 1}}
  {:call :path-lookup :value {:a 1} :path [] :expect {:present? true :value {:a 1}}}
  {:call :path-put    :value {:a 1} :path [] :x {:b 2} :expect {:b 2}}
  {:call :path-over   :value {:a 1} :path [] :fn :wrap-vec :expect [:wrapped {:a 1}]}
  {:call :path-overlap :p [] :q [:anything :deep 3] :expect true}

  ;; get / lookup on a nested path; a missing focus is nil (or :not-found).
  {:call :path-get    :value {:cart {:items {42 {:qty 2}}}} :path [:cart :items 42 :qty] :expect 2}
  {:call :path-get    :value {:cart {:items {}}} :path [:cart :items 99] :expect nil}
  {:call :path-get    :value {} :path [:missing] :not-found :nf :expect :nf}

  ;; PRESENT-nil vs MISSING — the distinction canonical identity preserves.
  {:call :path-lookup :value {}          :path [:page] :expect {:present? false}}
  {:call :path-lookup :value {:page nil} :path [:page] :expect {:present? true :value nil}}

  ;; put installs the focus; present-nil is stored (not dissoc'd) so put-lookup
  ;; holds at x = nil.
  {:call :path-put    :value {:a 1} :path [:b :c] :x 9 :expect {:a 1 :b {:c 9}}}
  {:call :path-lookup :value {:page 1} :path [:page] :expect {:present? true :value 1}}

  ;; over: increment a numeric focus; nil-on-missing get semantics.
  {:call :path-over   :value {:n 1}  :path [:n]      :fn :inc :expect {:n 2}}
  {:call :path-over   :value {}      :path [:missing] :fn :inc :expect {:missing 1}}

  ;; compose units + the canonical-vector result.
  {:call :path-compose :p [:a :b] :q []      :expect [:a :b]}
  {:call :path-compose :p []      :q [:a :b] :expect [:a :b]}
  {:call :path-compose :p [:cart :items] :q [42 :qty] :expect [:cart :items 42 :qty]}

  ;; prefix? / overlap? (symmetric; siblings are disjoint).
  {:call :path-prefix  :p [:cart] :q [:cart :items 42] :expect true}
  {:call :path-prefix  :p [:cart :items 42] :q [:cart] :expect false}
  {:call :path-overlap :p [:cart :items] :q [:cart :items 42 :qty] :expect true}
  {:call :path-overlap :p [:cart :items 42] :q [:cart :items 43] :expect false}

  ;; vector-index container policy: an in-range integer index updates the
  ;; vector in place; an out-of-range / non-integer segment replaces it with a
  ;; fresh map (put stays total).
  {:call :path-put    :value [10 20 30] :path [1] :x 99 :expect [10 99 30]}
  {:call :path-get    :value [10 20 30] :path [1] :expect 20}
  {:call :path-put    :value [10 20]    :path [5] :x 99 :expect {5 99}}
  {:call :path-put    :value [10 20]    :path [:k] :x 99 :expect {:k 99}}]}
