;; Conformance fixture: derivation-graph/algebra-full (EP-0014, rf2-djofbh)
;;
;; The host-agnostic corpus pin for the FULL EP-0014 derivation/process
;; ALGEBRA GRAPH — the broad `:derivation/algebra-graph` capability claim
;; (spec/Derivations.md §Graph inspection + §Conformance; EP-0014
;; §Validation / Conformance). The companion subset fixture
;; (`derivation-graph-algebra.edn`) proves ONLY the subs+machines slice and
;; claims the narrow `:derivation/algebra-graph-subs-machines` capability; a
;; host claiming the BROAD `:derivation/algebra-graph` must prove the whole
;; surface, which is exactly what this fixture pins (rf2-djofbh — the
;; portable corpus was overclaiming the broad capability while only
;; exercising subs+machines/static).
;;
;; What it ADDS over the subset fixture, so the broad claim no longer
;; overclaims (rf2-djofbh acceptance — "exercise flows, resources, routes,
;; route-owned resource activation, static and live graph modes, and the
;; resource authority/local-storage split"):
;;
;;   - FLOWS           — a `reg-flow` lowers to a `:derivation` node that is
;;                       MATERIALIZED (app-db / after-event / frame); the
;;                       subscription's policy TWIN over the same dependency
;;                       graph (Derivations §Worked equivalence). Its node id
;;                       is frame-scoped `[:flow <frame> <flow-id>]`.
;;   - RESOURCES       — a `reg-resource` lowers to a `:process` node whose
;;                       LOCAL storage is `:runtime-db` while its source of
;;                       truth is EXTERNAL — the issue-2 authority/storage
;;                       SPLIT: `:storage :runtime-db` AND a separate
;;                       `:authority {:kind :remote …}` axis. `:remote` is
;;                       NEVER a storage class.
;;   - ROUTES          — a `reg-route` lowers to the ONE `:rf/route` slice
;;                       `:process` node (runtime-db / on-route / frame),
;;                       keyed statically by `[:rf/route <route-id>]`.
;;   - ROUTE-OWNED     — the route declares `:resources`, so the assembled
;;     ACTIVATION       graph draws the static route-owned resource
;;                       ACTIVATION edge: route node → `[:resource <id>]`,
;;                       `:role :param`, `:target :parametric` (the
;;                       don't-execute rule withholds the concrete scoped
;;                       key), carrying the declared `:blocking?`.
;;   - LIVE MODE       — a second `:derivation-graph` call with `:mode :live`
;;                       asserts the live graph carries the `:mode :live` +
;;                       `:frame :rf/default` shape (via `:expect-graph`, the
;;                       graph-level submap check — rf2-ska8zk) and STILL
;;                       lowers the registered subscription / machine / route
;;                       nodes (the live view does not re-classify the
;;                       registered facts). The
;;                       REALIZED live route-owned resource edge (a concrete
;;                       scoped key under a nav-token) is the implementation-
;;                       local reference suite's subject
;;                       (`derivation_algebra_conformance_cljs_test`
;;                       `cplus-…`); a portable corpus pins the deterministic
;;                       static activation edge + the live-mode shape.
;;
;; The subscription `:<-` `:input` edge is re-pinned here too, so the full
;; fixture is a single cross-family assertion (lowering + classification +
;; the `:input` and `:param` edge roles + authority/storage split +
;; static/live modes) — the broad claim's contract. The `:selector` edge
;; (machine → its selector subscription) needs a parameterized
;; `[:rf/machine <id>]` `:<-` input the portable corpus DSL does not express;
;; it is pinned by the implementation-local reference suite
;; (derivation_algebra_conformance_cljs_test `c-static-edges-span-input-param-selector`).
;;
;; Capability `:derivation/algebra-graph` (the BROAD claim). A port that
;; exposes only the subs+machines graph claims the subset capability and
;; allowlists this one as a known-skip; a port claiming the broad capability
;; must pass this fixture.

{:fixture/id           :derivation-graph/algebra-full
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/sub :fsm/flat :flow/basic :rf.http/managed
                         :routing/match-url :routing/blocking
                         :derivation/algebra-graph}
 :fixture/doc          "The FULL cross-family derivation/process algebra graph: reg-sub → ephemeral :derivation, reg-flow → materialized app-db :derivation, reg-resource → :process (runtime-db storage + external :authority — the issue-2 split), reg-route → the :rf/route slice :process, reg-machine → :process refined :machine-process. Pins the static :input (sub :<-), :param (route-owned resource activation), and :selector (machine → selector sub) edges, the resource authority/local-storage split, AND the live-graph mode/frame shape (the graph-level :expect-graph {:mode :live :frame :rf/default} check — rf2-ska8zk; the static call pins :expect-graph {:mode :static}). The broad :derivation/algebra-graph claim the portable corpus formerly overclaimed with only subs+machines/static (rf2-djofbh)."

 :fixture/registry
 {:sub {:cart/items {:doc "All items in the cart (a layer-1 :db reader)."}
        :cart/total {:doc    "Item count (a :<- derivation over :cart/items)."
                     :inputs [:cart/items]}}
  :flow {:cart/materialized-total
         {:doc    "The subscription's policy TWIN — same whole-value fn, materialized into app-db :after-event."
          :inputs [[:cart :items]]
          :output-path [:cart :total]}}
  ;; a resource — the canonical :process member (runtime-db local storage +
  ;; external authority). The runner synthesizes the required :request fn
  ;; (EDN cannot carry a fn); the static graph never runs it (the opaque
  ;; :derive token). :scope / :params-schema are the fail-closed required
  ;; keys (Spec 016 §Resource registration spec).
  :resource {:article/by-slug
             {:doc           "A managed-HTTP resource fetched by slug."
              :scope         :rf.scope/global
              :params-schema [:map [:slug :string]]}}
  ;; a route that OWNS the resource — its :resources declaration is the
  ;; route-owned resource activation the static :param edge pins.
  :route {:route/article
          {:path      "/articles/:slug"
           :resources [{:resource :article/by-slug :blocking? true}]}}
  :machine
  {:upload/main
   {:initial :idle
    :data    {:progress 0}
    :states  {:idle      {:on {:upload/start {:target :uploading}}}
              :uploading {:on {:upload/done {:target :idle}}}}}}}

 ;; The sub BODIES never run here (this fixture asserts the registration-
 ;; derived GRAPH, not sub values). The realizer resolves the mapper at
 ;; registration, so use the known builtins. The :input edge is derived from
 ;; the `:<-` declared input, not from executing the body.
 :fixture/handlers
 {:sub {:cart/items [[:get [:cart :items]]]
        :cart/total [[:reduce-input :cart/items [:fn :+] [:fn :identity]]]}}

 ;; The flow :derive fn — opaque in the static graph (the :derive token,
 ;; never serialized / never run by static inspection). A simple identity
 ;; body keeps registration valid; the flow VALUE law is pinned elsewhere
 ;; (flow-recompute-on-input-change.edn + the reference whole-value tests).
 :fixture/flow-bodies
 {:cart/materialized-total [[:fn :identity [:event-arg 0]]]}

 :fixture/frame-config {}

 ;; Dispatch into the machine so its SINGLETON snapshot materializes in
 ;; runtime-db — the live machine instance node the `:mode :live` call below
 ;; asserts. The machine event is `[machine-id [inner-event]]` (Spec 005).
 ;; A live machine node exists only when its snapshot is materialized
 ;; (liveness is derived from runtime-db — Spec 005 §Liveness), so the live
 ;; assertion is driven through a deterministic contributor (this dispatch),
 ;; never a skip-when-absent.
 :fixture/dispatches
 [[:upload/main [:upload/start]]]

 :fixture/calls
 [;; ---- STATIC graph ----------------------------------------------------
  {:call :derivation-graph
   :mode :static

   ;; GRAPH-LEVEL shape (rf2-ska8zk): the static composer carries top-level
   ;; `:mode :static` and NO `:frame` (the static graph is frame-agnostic).
   ;; `:expect-graph` is a submap match against the whole graph map.
   :expect-graph {:mode :static}

   :expect-nodes
   [;; SUBS — ephemeral / on-demand / cache-entry :derivation.
    {:id         [:sub :cart/items]
     :kind       :derivation
     :storage    :ephemeral
     :evaluation :on-demand
     :lifecycle  :subscription-cache-entry}
    {:id         [:sub :cart/total]
     :kind       :derivation
     :storage    :ephemeral
     :evaluation :on-demand
     :lifecycle  :subscription-cache-entry}
    ;; FLOW — the subscription's MATERIALIZED policy twin (app-db /
    ;; after-event / frame). Node id is frame-scoped to :rf/default.
    {:id            [:flow :rf/default :cart/materialized-total]
     :kind          :derivation
     :storage       :app-db
     :evaluation    :after-event
     :lifecycle     :frame
     :materialized? true
     :output        [:db [:cart :total]]}
    ;; RESOURCE — the :process member; runtime-db LOCAL storage + a SEPARATE
    ;; external :authority axis (the issue-2 split — :remote is NOT storage).
    {:id            [:resource :article/by-slug]
     :kind          :process
     :refinement    :resource-process
     :storage       :runtime-db
     :authority     {:kind :remote :system :server :transport :rf.http/managed}
     :evaluation    #{:on-route :on-reply :scheduled :manual}
     :lifecycle     :scoped-resource-key
     :materialized? true}
    ;; ROUTE — the ONE :rf/route slice :process, keyed by [:rf/route <id>].
    {:id            [:rf/route :route/article]
     :kind          :process
     :refinement    :route-fact
     :storage       :runtime-db
     :evaluation    :on-route
     :lifecycle     :frame
     :materialized? true}
    ;; MACHINE — runtime-db / machine-instance :process refined :machine-process.
    {:id         [:machine :upload/main]
     :kind       :process
     :refinement :machine-process
     :storage    :runtime-db
     :lifecycle  :machine-instance}]

   :expect-edges
   [;; :input — the static `:<-` chain (cart/items → cart/total).
    {:from [:sub :cart/items] :to [:sub :cart/total] :role :input}
    ;; :param — the route-owned resource ACTIVATION edge. The concrete
    ;; scoped key is :parametric (the don't-execute rule); :blocking? rides
    ;; from the route's :resources declaration.
    {:from     [:rf/route :route/article]
     :to       [:resource :article/by-slug]
     :role     :param
     :target   :parametric
     :blocking? true}]

   ;; the layer-1 sub names no [:sub …] input, so no edge points AT it; and
   ;; static inspection draws NO realized route→resource owner edge (no
   ;; nav-token exists until a navigation commits — live state only).
   :expect-absent-edges
   [{:from [:sub :cart/total] :to [:sub :cart/items] :role :input}]}

  ;; ---- LIVE graph ------------------------------------------------------
  ;; The live mode shape (:mode :live) and the live MACHINE INSTANCE node the
  ;; live view materializes from the runtime-db snapshot the dispatch above
  ;; installed (the realized fact the static graph cannot enumerate — a live
  ;; instance has no per-instance registration; its liveness IS the snapshot,
  ;; Spec 005 §Liveness). The live view carries the SAME fixed classifications
  ;; as the static machine node (it does not re-classify). This node is a
  ;; FAILING precondition (the dispatch must have materialized it) — not a
  ;; skip-when-absent. The live sub-cache / realized route slice (substrate-
  ;; and navigation-dependent) are the reference suite's subjects
  ;; (derivation_algebra_conformance_cljs_test).
  {:call :derivation-graph
   :mode :live

   ;; GRAPH-LEVEL shape (rf2-ska8zk): the LIVE composer carries top-level
   ;; `:mode :live` AND `:frame :rf/default` (the corpus single-frame scope).
   ;; This is the false-positive guard the bead names — a port returning the
   ;; right live machine node while dropping/misreporting the live mode or
   ;; frame must FAIL here, not pass. `:expect-graph` is a submap match
   ;; against the whole graph map.
   :expect-graph {:mode :live :frame :rf/default}

   :expect-nodes
   [{:id            [:machine :upload/main]
     :kind          :process
     :refinement    :machine-process
     :storage       :runtime-db
     :lifecycle     :machine-instance
     :materialized? true}]}]

 ;; No app-db assertion — this fixture exercises the registration-derived
 ;; graph, not runtime state.
 :fixture/expect {}}
