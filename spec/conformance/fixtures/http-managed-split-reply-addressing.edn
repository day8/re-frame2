;; Conformance fixture: rf.http.managed/split-reply-addressing
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Reply addressing
;; — the split form. Every request addresses its reply; here the success
;; branch names its target with `:on-success`, and the runtime appends the
;; canonical `{:status :ok :value v}` envelope as that target event's last
;; argument. Nothing routes a reply back to the originating event
;; implicitly: a request that supplies none of `:reply-to`, `:on-success`
;; and `:on-failure` fails at fx-call time with
;; `:rf.error/http-no-reply-target`.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-success`, so no managed-HTTP code runs: the
;; canned-success body names the target and writes the reply itself, so no
;; reply target is selected. What it grades is the redirection of
;; `:rf.http/managed` to that body, the args the body receives
;; (`:effects-routed`) and the dispatch of the reply it writes. The
;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/split-reply-addressing
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/sub :core/fx
                         :rf.http/managed}
 :fixture/doc          "Shaped like Spec 014's split reply addressing: :rf.http/managed, redirected by :fx-overrides to the fixture's canned-success body, which dispatches [:article/load-reply {:status :ok :value {:stubbed true}}] itself. Grades override routing, args forwarding and reply dispatch, not reply-target selection."

 :fixture/registry
 {:event {:article/load          {:doc "Initial-dispatch path — issues the managed request."}
          :article/load-reply    {:doc "The :on-success target — receives the canonical reply envelope as its last argument and stores it under [:article]."}}
  :sub   {:article {:doc "The currently-loaded article."}}
  :fx    {:rf.http/managed                {:doc "Spec 014 — managed HTTP request."
                                           :platforms #{:client :server}}
          :rf.http/managed-canned-success {:doc "Spec 014 — synthesised success reply (test stub)."
                                           :platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {;; The initial-dispatch path issues the fx and addresses its reply
   ;; with :on-success, so the reply is dispatched to that target only.
   ;; The unified :reply-to form (one target for both branches) is
   ;; exercised by the JVM test
   ;; re-frame.http-managed-test/canned-success-reply-to-addressing, and
   ;; the unaddressed request by
   ;; re-frame.http-managed-test/no-reply-target-fails-loud.
   :article/load
   [[:fx [[:rf.http/managed
           {:request {:method :get :url "/articles/hello"}
            :decode  :json
            :on-success [:article/load-reply]}]]]]

   :article/load-reply
   ;; The :on-success target receives the reply payload as the last
   ;; arg — `[:article/load-reply {:status :ok :value v}]`.
   ;; Store the canonical reply at [:article].
   [[:set [:article] [:event-arg 1]]]}

  :sub
  {:article [[:get [:article]]]}

  :fx
  {;; The fixture's body for :rf.http/managed — never invoked under the
   ;; override below.
   :rf.http/managed                [[:noop]]
   ;; The fixture's canned-success body — dispatches the reply it writes.
   :rf.http/managed-canned-success
   [[:dispatch [:article/load-reply {:status :ok :value {:stubbed true}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-success}}

 :fixture/dispatches
 [[:article/load {:slug "hello"}]]

 :fixture/expect
 {:final-app-db
  {:article {:status :ok :value {:stubbed true}}}

  :sub-values
  {[:article] {:status :ok :value {:stubbed true}}}

  :trace-emissions
  [;; Initial dispatch.
   {:operation :rf.event/run-start :op-type :rf.event :tags {:rf.trace/event-id :article/load}}
   ;; The override redirected :rf.http/managed → :rf.http/managed-canned-success.
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-success}}
   ;; The stub re-dispatched to :article/load-reply with the success payload.
   {:operation :rf.event/run-start :op-type :rf.event :tags {:rf.trace/event-id :article/load-reply}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-success
    :args  {:request    {:method :get :url "/articles/hello"}
            :decode     :json
            :on-success [:article/load-reply]}}]}}
