;; Conformance fixture: rf.http.managed/post-json
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Body encoding and
;; §Request envelope: a POST with a Clojure-map body and
;; `:request-content-type :json`, whose success reply lands at the explicit
;; `:on-success` target.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-success`, so no managed-HTTP code runs: the body
;; is never serialised and no header is set. What it grades is the
;; redirection of `:rf.http/managed` to the canned-success body, the args
;; that body receives (`:effects-routed`, the request map verbatim) and the
;; dispatch of the reply the body writes. The ;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/post-json
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx
                         :rf.http/managed}
 :fixture/doc          "POST /auth/login with a Clojure-map body and :request-content-type :json. :fx-overrides routes the :rf.http/managed args verbatim to the fixture's canned-success body, which dispatches its own reply to :auth/login-success. Grades override routing, args forwarding and reply dispatch, not body encoding."

 :fixture/registry
 {:event {:auth/login         {:doc "Issue the POST."}
          :auth/login-success {:doc "Receive the success payload."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-success {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:auth/login
   [[:fx [[:rf.http/managed
           {:request {:method :post
                      :url    "/auth/login"
                      :body   {:user "alice" :password "wonderland"}
                      :request-content-type :json}
            :decode  :json
            :on-success [:auth/login-success]}]]]]

   :auth/login-success
   [[:set [:auth] [:event-arg 1]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-success
   [[:dispatch [:auth/login-success {:status :ok
                                     :value  {:token "tok-1" :user-id "u-1"}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-success}}

 :fixture/dispatches
 [[:auth/login]]

 :fixture/expect
 {:final-app-db
  {:auth {:status :ok
          :value  {:token "tok-1" :user-id "u-1"}}}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :auth/login}}
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-success}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :auth/login-success}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-success
    :args  {:request    {:method :post
                         :url    "/auth/login"
                         :body   {:user "alice" :password "wonderland"}
                         :request-content-type :json}
            :decode     :json
            :on-success [:auth/login-success]}}]}}
