;; Conformance fixture: flow/hot-reload-preserves-output
;; Per Spec 013 §Re-registration and Spec 001 §Hot-reload semantics —
;; reg-flow against an already-registered :id performs a surgical
;; update: the new flow's definition replaces the old; last-inputs
;; clears so the new body re-evaluates regardless of whether inputs
;; changed. Registered through :rf.fx/reg-flow, as here, a flow is
;; evaluated by the framework's settle before the registering dispatch
;; returns (Spec 013 §Sequencing), for a first registration and a
;; re-registration alike, so no follow-up event is involved.
;;
;; This fixture verifies the user-visible value at the output path:
;; if the new body would compute the same output, the prior output is
;; preserved across re-registration.

{:fixture/id           :flow/hot-reload-preserves-output
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/trace :flow/basic :flow/hot-reload :flow/trace}
 :fixture/doc          "Re-registering a flow with an equivalent body keeps the prior output value at the flow's :output-path. Registered through :rf.fx/reg-flow, the new flow re-evaluates before the re-registering dispatch settles (Spec 013 §Sequencing) — so the user observes a continuous output as long as the new body is value-equivalent on the same inputs. (A new body that computes a different value materialises it by that same boundary.)"

 :fixture/registry
 {:event {:doubled/init      {:doc "Seed :n to 7."}
          :doubled/reg-v1    {:doc "Register :double v1 — output is (* 2 n)."}
          :doubled/reg-v2    {:doc "Re-register :double v2 — same output value."}
          :doubled/poke      {:doc "No-op event to drive a drain."}}
  :fx    {:rf.fx/reg-flow {:doc "Reserved — register a flow."
                           :platforms #{:client :server}}}}

 :fixture/handlers
 {:event {:doubled/init   [[:set [:n] 7]]
          :doubled/reg-v1 [[:fx :rf.fx/reg-flow
                            {:id     :doubled/value
                             :inputs [[:n]]
                             :body   [[:fn :* [:event-arg 0] 2]]
                             :output-path [:doubled]}]]
          :doubled/reg-v2 [[:fx :rf.fx/reg-flow
                            {:id     :doubled/value
                             :inputs [[:n]]
                             :body   [[:fn :+ [:event-arg 0] [:event-arg 0]]]
                             :output-path [:doubled]}]]
          :doubled/poke   [[:set [:tick] [:event-arg 1]]]}}

 :fixture/frame-config
 {:initial-events [[:doubled/init]]}

 ;; Sequence:
 ;;   :initial-events [:doubled/init] — :n 7
 ;;   [:doubled/reg-v1]           — register v1; it evaluates before this
 ;;                                 dispatch settles → :doubled 14
 ;;   [:doubled/poke 1]           — :n is unchanged, so the flow skips
 ;;   [:doubled/reg-v2]           — re-register with (+ n n); last-inputs
 ;;                                 cleared, so v2 evaluates before this
 ;;                                 dispatch settles → the same 14
 ;;   [:doubled/poke 2]           — the flow skips again
 :fixture/dispatches
 [[:doubled/reg-v1]
  [:doubled/poke 1]
  [:doubled/reg-v2]
  [:doubled/poke 2]]

 :fixture/expect
 {:final-app-db
  {:n       7
   :tick    2
   :doubled 14}

  ;; The timing pin. `:final-app-db` is a submap match on the END state,
  ;; so it cannot see WHEN the flow evaluated; this order-preserving
  ;; subset can. Each `:rf.flow/computed` must land after its registering
  ;; event starts and before the next poke starts, so a runtime that left
  ;; either evaluation to the next drain fails here.
  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :doubled/reg-v1}}
   {:operation :rf.flow/computed   :tags {:flow-id :doubled/value :result 14}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :doubled/poke}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :doubled/reg-v2}}
   {:operation :rf.flow/computed   :tags {:flow-id :doubled/value :result 14}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :doubled/poke}}]}}
