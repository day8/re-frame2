;; Conformance fixture: construction/reset-in-handler-guard
;; EP-0027 §Reset (the handler-time guard) — `reset-frame!` called while an
;; event-handler cascade is IN FLIGHT is rejected LOUD with
;; `:rf.error/frame-reset-in-handler` BEFORE any teardown, so the frame is left
;; ALIVE and UNCHANGED. reset is a destroy + re-register (a LIFECYCLE
;; operation); without the up-front guard the destroy would succeed and the
;; re-construction would then hit the construction-in-handler guard, leaving
;; the frame gone and signalled by an error naming the WRONG cause.
;;
;; The frame is constructed with an :initial-events seed (n=0 then inc ⇒ n=1).
;; A runtime dispatch moves it to n=2, then the `:ctor/reset-self` handler emits
;; an fx whose body invokes `reset-frame!` on its own frame mid-cascade via the
;; `:reset-frame-capture` op. The fx runs in the `do-fx` walk (still under
;; `*handler-scope*`), so the guard fires; the op CAPTURES the thrown
;; `:rf.error/id` into app-db at `[:guard-id]` (a user fx throw is otherwise
;; swallowed by do-fx as `:rf.error/fx-handler-exception`). The frame is left
;; ALIVE and UNCHANGED — :n stays 2, proving no partial teardown / replay.

{:fixture/id           :construction/reset-in-handler-guard
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/frame :core/fx}
 :fixture/doc          "Per EP-0027 §Reset: reset-frame! called while an event-handler cascade is in flight fails loud :rf.error/frame-reset-in-handler BEFORE any teardown, leaving the frame alive and unchanged. The :ctor/reset-self handler emits an fx whose body invokes reset-frame! mid-cascade; the :reset-frame-capture op captures the thrown :rf.error/id into app-db (the guard throw is otherwise swallowed by do-fx as :rf.error/fx-handler-exception). app-db is untouched (:n stays 2) — no partial teardown, no replay."

 :fixture/registry
 {:event {:ctor/seed       {:doc "Replace app-db wholesale with the seed map."}
          :ctor/inc        {:doc "Increment :n."}
          :ctor/reset-self {:doc "Runtime event — emits an fx that tries to reset its own frame mid-cascade."}}
  :fx    {:user.fx/reset-frame {:doc       "Naive fx that resets a frame mid-cascade; the EP-0027 guard catches it."
                                :platforms #{:client :server}}}}

 :fixture/handlers
 {:event {:ctor/seed       [[:set [] [:event-arg 1]]]
          :ctor/inc        [[:update [:n] [:fn :inc]]]
          :ctor/reset-self
          ;; Emit ONE fx whose body invokes reset-frame! on :rf/default.
          [[:fx :user.fx/reset-frame :rf/default]]}

  :fx    {:user.fx/reset-frame
          ;; The fx body: reset the named frame mid-cascade and capture the
          ;; thrown :rf.error/id into app-db at [:guard-id]. The guard fires
          ;; because the do-fx walk is still under *handler-scope*.
          [[:reset-frame-capture [:guard-id] :rf/default]]}}

 :fixture/frame-config
 {:initial-events [[:ctor/seed {:n 0}]
                   [:ctor/inc]]}

 :fixture/dispatches
 ;; Construction left n=1. Move it to n=2, then trigger the mid-cascade reset.
 [[:ctor/inc]
  [:ctor/reset-self]]

 :fixture/expect
 ;; The load-bearing assertions, as pure data:
 ;;   1. :n stays 2 — the reset was rejected BEFORE any teardown / replay (a
 ;;      successful reset would have replayed the recorded seed+inc back to n=1).
 ;;   2. :guard-id captured :rf.error/frame-reset-in-handler — the dedicated
 ;;      discriminator, NOT the construction-in-handler id (which names the
 ;;      wrong cause) and NOT :rf/no-error (which would mean the guard was
 ;;      bypassed).
 {:final-app-db {:n 2
                 :guard-id :rf.error/frame-reset-in-handler}}}
