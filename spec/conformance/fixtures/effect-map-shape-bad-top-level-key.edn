;; Conformance fixture: effect-map-shape/bad-top-level-key
;; Spec 009 §:rf.error/effect-map-shape CASE (a) — bad TOP-LEVEL key.
;;
;; A reg-event-fx handler returns an effect-map with a key other than
;; :db / :fx (here the legacy v1 top-level :http, per MIGRATION §M-8). The
;; effect-map is CLOSED (Spec-Schemas §:rf/effect-map — only :db and :fx at
;; the top level), so the runtime PROACTIVELY polices the shape at commit:
;; one :rf.error/effect-map-shape trace per offending key (:offending-key
;; :http), the offending key is DROPPED, and the legal :db still applies
;; (recovery :logged-and-skipped). The legacy key is NOT routed through the
;; fx machinery.
;;
;; This is a FAIL-CLOSED proactive gate, not a thrown error — it never
;; surfaces as an exception, so a PORT with a lenient fx-entry guard (the
;; rf2-18kwf class bug) ships GREEN against the rest of the corpus while
;; silently accepting this malformed shape. This fixture gives the gate
;; TEETH: a conformant impl MUST emit the trace + drop the key, so the
;; lenient port FAILS here (no trace emitted, OR the :http key mis-routed).
;;
;; The handler returns the malformed map via the :return-raw DSL op — the
;; only DSL path that yields a literal effect-map verbatim (the :set / :fx
;; ops always build a well-shaped map, so the shape gate was unreachable
;; from a fixture before this op). Grounded against the reference emitter
;; re-frame.events/police-effect-map-shape!.

{:fixture/id           :effect-map-shape/bad-top-level-key
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx :core/error :core/trace}
 :fixture/doc          "A reg-event-fx handler returns {:db ... :http ...}. The non-:db/:fx top-level :http key is proactively policed: one :rf.error/effect-map-shape trace (:offending-key :http, :logged-and-skipped), the key dropped, the :db still applied."

 :fixture/registry
 {:event {:shape/init {:doc "Seed [:seeded?] false."}
          :shape/bad-key {:doc "Returns {:db {:seeded? true} :http {...}} — the legacy v1 top-level :http key is a shape violation."}}
  :sub   {:seeded? {:doc "Whether the :db still committed."}}}

 :fixture/handlers
 {:event {:shape/init    [[:set [:seeded?] false]]
          :shape/bad-key [[:return-raw {:db {:seeded? true}
                                        :http {:url "/api"}}]]}
  :sub   {:seeded? [[:get [:seeded?]]]}}

 :fixture/frame-config {:initial-events [[:shape/init]]}

 :fixture/dispatches
 [[:shape/bad-key]]

 :fixture/expect
 ;; :db still committed — only the malformed top-level key was dropped.
 {:final-app-db {:seeded? true}
  :sub-values   {[:seeded?] true}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :shape/bad-key}}
   ;; Proactive shape policing: one trace for the offending :http key.
   {:operation :rf.error/effect-map-shape
    :op-type   :error
    :recovery  :logged-and-skipped
    :tags      {:category          :rf.error/effect-map-shape
                :offending-key     :http
                :value             {:url "/api"}
                :rf.trace/event-id :shape/bad-key
                :rf.event/v        [:shape/bad-key]}}]

  ;; The legacy top-level :http key was NOT routed through the fx machinery
  ;; — no fx with id :http was ever attempted.
  :effects-routed []}}
