;; Conformance fixture: machine/spawn-all-join-all-completes
;;
;; Per Spec 005 §Spawn-and-join via :spawn-all (rf2-6vmw). Verify that
;; entering a :spawn-all-bearing state with `:join :all` emits:
;;   1. One :rf.machine/spawn-all-init fx that seeds the join state at
;;      [:rf.runtime/machines :spawned <parent> <invoke-id>]. It carries
;;      :child-args — the prepared per-child spawn args (identical to the
;;      args of the :rf.machine/spawn fxs below, in declaration order) — so
;;      its invoke-level admission preflight can decide unregistered-TYPE and
;;      spawn-time [:schemas :data] rejection BEFORE publishing a live join
;;      or running any child effect (rf2-7u8gen).
;;   2. N :rf.machine/spawn fxs (one per child), each carrying the
;;      runtime-stamped :rf/parent-id, :rf/spawn-all-id (the prefix-path
;;      of the :spawn-all-bearing state), and :rf/spawn-all-child-id
;;      (the user-supplied :id).
;;
;; The fixture exercises the desugared shape directly via :machine-transition
;; calls. The :rf.machine/spawn-all-init / :rf.machine/spawn fxs the
;; runtime emits are observable at the same level as any other fx.
;;
;; Pure-call machine-transition (the conformance harness's runner) carries
;; no parent registration, so :rf/parent-id is the sentinel
;; :rf/transition-pure.
;;
;; Per rf2-gr8q the spawn-id allocator lives inside the snapshot at
;; `:rf/spawn-counter` (a per-machine-id integer map). A fresh fixture
;; snapshot starts without the slot; each child spawn bumps its own
;; machine-id slot so the three children land at #1 each.

{:fixture/id           :machine/spawn-all-join-all-completes
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:fsm/flat :actor/spawn-destroy :actor/declarative-spawn :actor/spawn-and-join}
 :fixture/doc          "Declarative :spawn-all spawn-and-join with :join :all desugars to entry-cascade :rf.machine/spawn-all-init + N :rf.machine/spawn fxs at registration time. Verifies the entry-side fx emission for the auth-flow worked example shape (3 parallel children)."

 :fixture/registry
 {:machine
  {:load-config        {:doc "Stub child — :rf.machine/spawn target"}
   :load-feature-flags {:doc "Stub child — :rf.machine/spawn target"}
   :load-user-profile  {:doc "Stub child — :rf.machine/spawn target"}}}

 :fixture/calls
 ;; Entering :hydrating: 1 spawn-all-init fx + 3 spawn fxs.
 [{:call         :machine-transition
   :definition
   {:initial :idle
    :data    {}
    :states
    {:idle
     {:on {:start :hydrating}}

     :hydrating
     {:spawn-all
      {:children         [{:id :cfg  :machine-id :load-config}
                          {:id :flag :machine-id :load-feature-flags}
                          {:id :user :machine-id :load-user-profile}]
       :join             :all
       :on-all-complete  [:hydrate/done]
       :on-any-failed    [:hydrate/failed]}
      :on    {:hydrate/done   :ready
              :hydrate/failed :error}}

     :ready  {}
     :error  {}}}
   :snapshot     {:state :idle :data {}}
   :event        [:start]
   ;; Per rf2-rc8wci: a :spawn-all binds the WHOLE {<child-id> <spawned-id>}
   ;; map into the parent's :data under :rf/spawned, keyed by the shared
   ;; invoke-id `[:hydrating]` (XState-context parity; all N children
   ;; recorded under the one key, no clobber).
   :expect-next-snapshot {:state            :hydrating
                          :data             {:rf/spawned {[:hydrating] {:cfg  :load-config#1
                                                                        :flag :load-feature-flags#1
                                                                        :user :load-user-profile#1}}}
                          :rf/spawn-counter {:load-config        1
                                             :load-feature-flags 1
                                             :load-user-profile  1}}
   :expect-effects
   ;; The runtime emits 1 init fx + N spawn fxs in this order. Spawn-id
   ;; allocation is deterministic via the snapshot's `:rf/spawn-counter`
   ;; (per machine-id) per rf2-gr8q; each spawn-id is `:<machine-id>#1`
   ;; because each :machine-id has its own counter slot starting from 0.
   [[:rf.machine/spawn-all-init
     {:rf/parent-id :rf/transition-pure
      :rf/invoke-id [:hydrating]
      :join-state   {:children  {:cfg  :load-config#1
                                 :flag :load-feature-flags#1
                                 :user :load-user-profile#1}
                     :done      #{}
                     :failed    #{}
                     :resolved? false
                     :spec      {:children         [{:id :cfg  :machine-id :load-config}
                                                    {:id :flag :machine-id :load-feature-flags}
                                                    {:id :user :machine-id :load-user-profile}]
                                 :join             :all
                                 :on-all-complete  [:hydrate/done]
                                 :on-any-failed    [:hydrate/failed]}
                     :invoke-id [:hydrating]}
      ;; The prepared per-child spawn args, in declaration order — byte-for-byte
      ;; the args of the three :rf.machine/spawn fxs below. The init fx
      ;; preflights THESE, so its admission decision sees exactly what each
      ;; per-child effect would run.
      :child-args   [{:machine-id             :load-config
                      :id-prefix              :load-config
                      :rf/spawned-id          :load-config#1
                      :rf/parent-id           :rf/transition-pure
                      :rf/spawn-all-id        [:hydrating]
                      :rf/spawn-all-child-id  :cfg}
                     {:machine-id             :load-feature-flags
                      :id-prefix              :load-feature-flags
                      :rf/spawned-id          :load-feature-flags#1
                      :rf/parent-id           :rf/transition-pure
                      :rf/spawn-all-id        [:hydrating]
                      :rf/spawn-all-child-id  :flag}
                     {:machine-id             :load-user-profile
                      :id-prefix              :load-user-profile
                      :rf/spawned-id          :load-user-profile#1
                      :rf/parent-id           :rf/transition-pure
                      :rf/spawn-all-id        [:hydrating]
                      :rf/spawn-all-child-id  :user}]}]
    ;; Per rf2-er0t: the runtime dissocs :id from each child spec before
    ;; emitting the :rf.machine/spawn fx; the user-supplied child id rides
    ;; on :rf/spawn-all-child-id instead.
    [:rf.machine/spawn
     {:machine-id              :load-config
      :id-prefix               :load-config
      :rf/spawned-id           :load-config#1
      :rf/parent-id            :rf/transition-pure
      :rf/spawn-all-id        [:hydrating]
      :rf/spawn-all-child-id  :cfg}]
    [:rf.machine/spawn
     {:machine-id              :load-feature-flags
      :id-prefix               :load-feature-flags
      :rf/spawned-id           :load-feature-flags#1
      :rf/parent-id            :rf/transition-pure
      :rf/spawn-all-id        [:hydrating]
      :rf/spawn-all-child-id  :flag}]
    [:rf.machine/spawn
     {:machine-id              :load-user-profile
      :id-prefix               :load-user-profile
      :rf/spawned-id           :load-user-profile#1
      :rf/parent-id            :rf/transition-pure
      :rf/spawn-all-id        [:hydrating]
      :rf/spawn-all-child-id  :user}]]}]}
