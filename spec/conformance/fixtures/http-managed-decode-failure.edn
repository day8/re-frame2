;; Conformance fixture: rf.http.managed/decode-failure
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Failure
;; categories — `:rf.http/decode-failure`: a body that cannot be parsed
;; (Malli rejection, JSON syntax error, custom decoder threw) classifies
;; under this kind, and the `:on-failure` target receives the canonical
;; failure envelope.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-failure`, so no managed-HTTP code runs: nothing
;; is decoded or classified — the failure envelope is written out in the
;; canned-failure body. What it grades is the redirection of
;; `:rf.http/managed` to that body, the args the body receives
;; (`:effects-routed`) and the dispatch of the reply it writes. The
;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/decode-failure
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx
                         :rf.http/managed}
 :fixture/doc          "Shaped like Spec 014's :rf.http/decode-failure (Malli rejection / JSON syntax error / custom decoder threw): the fixture's canned-failure body, reached through :fx-overrides, dispatches {:status :error :error {:kind :rf.http/decode-failure ...}} to the :on-failure target. Grades override routing, args forwarding and reply dispatch; nothing is decoded."

 :fixture/registry
 {:event {:articles/list       {:doc "Issue the GET."}
          :articles/list-error {:doc "Receive the failure payload."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-failure {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:articles/list
   [[:fx [[:rf.http/managed
           {:request {:method :get :url "/articles"}
            :decode  :json
            :on-failure [:articles/list-error]}]]]]

   :articles/list-error
   [[:set [:articles :error] [:event-arg 1]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-failure
   [[:dispatch [:articles/list-error
                {:status :error
                 :error  {:kind         :rf.http/decode-failure
                          :body-text    "{not-valid-json"
                          :cause        "JSON syntax error"
                          :schema-validation-failure? false}}]]]}}

 :fixture/frame-config
 {:initial-events []
  :fx-overrides {:rf.http/managed :rf.http/managed-canned-failure}}

 :fixture/dispatches
 [[:articles/list]]

 :fixture/expect
 {:final-app-db
  {:articles {:error {:status :error
                      :error  {:kind         :rf.http/decode-failure
                               :body-text    "{not-valid-json"
                               :cause        "JSON syntax error"
                               :schema-validation-failure? false}}}}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :articles/list}}
   {:operation :rf.fx/override-applied :tags {:rf.fx/from :rf.http/managed
                                              :rf.fx/to   :rf.http/managed-canned-failure}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :articles/list-error}}]

  :effects-routed
  [{:fx-id :rf.http/managed-canned-failure
    :args  {:request    {:method :get :url "/articles"}
            :decode     :json
            :on-failure [:articles/list-error]}}]}}
