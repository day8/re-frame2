;; Conformance fixture: data-classification/observability-sink-receives-projected-record
;;
;; Per Spec 015 §Tests (the `observability-sink-receives-projected-record.edn`
;; row) and §9 (frame-owned observability sink policy) — a frame declaring an
;; `:observability` sink delivers an ALREADY-PROJECTED record to the sink on
;; each processed event: the framework performs projection, sinks consume
;; projected records only. The off-box default omits the `:event` args slot on
;; a handled-event record; a declared `:errors` sink receives a projected
;; `:rf.observe/error` record with a frame-sensitive path inside the error's
;; `:event` redacted.
;;
;; This fixture pins the host-agnostic PROJECTION CONTRACT that the §9 sink
;; consumes — the exact record shape a sink fn must accept — via two pure
;; `:project-egress` calls against a frame (`:obs/main`) that classifies
;; `[:auth :token]` sensitive:
;;
;;   1. handled-event under off-box-observability → summary fields, `:event`
;;      OMITTED (the sink never sees the raw arg-map);
;;   2. error record under off-box-observability → `:event` RETAINED but the
;;      sensitive `[:auth :token]` inside it REDACTED (the sink never sees the
;;      raw token; it never re-implements redaction).
;;
;; The RUNTIME WIRING leg — that a real `dispatch-sync` routes these projected
;; records through `route-handled-event!` / `route-error!` to a frame-declared
;; sink (`register-observability-sink!`), fail-closed on an unresolved frame, with
;; sibling-sink isolation — is pinned end-to-end by the dual-runtime CLJC test
;; `re-frame.observability-routing-cljs-test` (rf2-t55hxg.7 / .4), which runs
;; under BOTH `npm run test:cljs` and the JVM `clojure -M:test`. The corpus
;; cannot capture a sink fan-out host-neutrally (no render/side-effect-capture
;; harness), so it pins the projection the sink consumes; the wiring test pins
;; the route to it.

{:fixture/id           :data-classification/observability-sink-receives-projected-record
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:data-classification/classification-effects}
 :fixture/doc          "A frame's :observability sink consumes ALREADY-PROJECTED records (Spec 015 §9): a handled-event record under off-box-observability has its :event args slot OMITTED, and an error record has the frame-sensitive [:auth :token] inside its :event REDACTED. The framework projects; the sink never re-implements redaction. (Runtime sink ROUTING is pinned e2e by re-frame.observability-routing-cljs-test.)"

 :fixture/frames
 [{:id :obs/main}]

 ;; EP-0025: durable app-db classification rides the commit-plane
 ;; `:sensitive` / `:large` effects, not a frame annotation. The corpus
 ;; `:fixture/classification-effects` op installs the classification into the
 ;; frame's elision registry under `:source :effect` (the same write a
 ;; reg-event returning `:sensitive [[:auth :token]]` performs).
 :fixture/classification-effects
 [{:sensitive [[:auth :token]]}]

 :fixture/calls
 [;; 1. The handled-event record the :handled-events sink receives: off-box
    ;; default omits the :event args slot entirely.
  {:call              :project-egress
   :frame             :obs/main
   :rf.egress/profile :rf.egress/off-box-observability
   :value             {:kind        :rf.observe/handled-event
                       :frame       :obs/main
                       :event-id    :auth/login
                       :event       [:auth/login {:password "hunter2"}]
                       :status      :ok
                       :elapsed-ms  7
                       :effects     [:db]}
   :expect            {:kind        :rf.observe/handled-event
                       :frame       :obs/main
                       :event-id    :auth/login
                       :status      :ok
                       :elapsed-ms  7
                       :effects     [:db]}}

  ;; 2. The error record the :errors sink receives: :event RETAINED but the
    ;; frame-sensitive [:auth :token] inside it is REDACTED.
  {:call              :project-egress
   :frame             :obs/main
   :rf.egress/profile :rf.egress/off-box-observability
   :value             {:kind     :rf.observe/error
                       :frame    :obs/main
                       :error    :rf.error/handler-exception
                       :event-id :auth/login
                       :event    [:auth/login {:auth {:token "super-secret-token"}}]}
   :expect            {:kind     :rf.observe/error
                       :frame    :obs/main
                       :error    :rf.error/handler-exception
                       :event-id :auth/login
                       :event    [:auth/login {:auth {:token :rf/redacted}}]}}

  ;; 3. rf2-kuky.65 — the producer's COMPONENT ATTRIBUTION on an error record.
    ;; The structural identifiers (:failing-id here; :flow-id / :where on the
    ;; flow-eval category are the same class) are SUMMARY slots: they pass the
    ;; projector unchanged, which is what makes the attribution SURVIVE
    ;; :rf.egress/public-error — the profile that DROPS :exception. `:reason` is
    ;; NOT a summary slot: it is prose that interpolates app values, so it rides
    ;; the :tags tree slot and is walked under frame classification.
    ;;
    ;; This call pins the UNCLASSIFIED arm — the DEFAULT, where the walker
    ;; deliberately passes the slot through (the split is a sound default, not a
    ;; fail-closed property: see Spec 015 §Frame-owned observability sink
    ;; policy). The CLASSIFIED arm — a frame classifying [:reason] redacts that
    ;; slot WHOLE to :rf/redacted while :failing-id / :source-coord survive
    ;; beside it — needs a DIFFERENT frame classification from the [:auth :token]
    ;; this fixture's single scope frame declares, so it is pinned by
    ;; `re-frame.observability-routing-cljs-test` alongside the runtime-wiring
    ;; leg above. The two arms together are the whole of the claim.
  {:call              :project-egress
   :frame             :obs/main
   :rf.egress/profile :rf.egress/public-error
   :value             {:kind         :rf.observe/error
                       :frame        :obs/main
                       :error        :rf.error/interceptor-exception
                       :event-id     :auth/login
                       :failing-id   :app/audit-interceptor
                       :source-coord {:ns app.interceptors :file "src/app/interceptors.cljs" :line 42}
                       :tags         {:reason "Interceptor `:app/audit-interceptor` threw in :after."}
                       :event        [:auth/login {:auth {:token "super-secret-token"}}]}
   :expect            {:kind         :rf.observe/error
                       :frame        :obs/main
                       :error        :rf.error/interceptor-exception
                       :event-id     :auth/login
                       :failing-id   :app/audit-interceptor
                       :source-coord {:ns app.interceptors :file "src/app/interceptors.cljs" :line 42}
                       :tags         {:reason "Interceptor `:app/audit-interceptor` threw in :after."}
                       :event        [:auth/login {:auth {:token :rf/redacted}}]}}]}
