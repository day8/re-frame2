;; Conformance fixture: machine/after-single-delay
;;
;; A state with a single :after entry. On state entry the timer schedules with
;; the current epoch; the test-clock advances time; the timer fires; the
;; transition runs; the snapshot lands at the target. Verify the
;; :rf.machine/after-schedule effect at entry carries the epoch the elapsed
;; event then has to match.
;;
;; Per [005 §Delayed :after transitions]
;; (../../005-StateMachines.md#delayed-after-transitions).
;;
;; The harness substitutes a deterministic clock via re-frame.interop —
;; with-redefs of re-frame.interop/schedule-after! to a fixture-controlled
;; queue, and re-frame.interop/now-ms to a fixture-controlled counter. The
;; harness exposes an `:advance-clock` step which fires every queued timer
;; whose due-time is <= the new now-ms.

{:fixture/id           :machine/after-single-delay
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:fsm/flat :fsm/delayed-after}
 :fixture/doc          "A state with one :after entry. After entry, the test-clock advances past the delay; the timer fires; the transition runs; verify the :rf.machine/after-schedule effect at entry carries epoch 1 and the elapsed event carrying that epoch moves the snapshot to the target."

 :fixture/registry
 {:machine-action
  {:loading/note-entry {:doc "Records that :loading was entered."}}}

 :fixture/handlers
 {:machine-action
  {:loading/note-entry [[:set [:entered?] true]]}}

 :fixture/calls
 [;; Step 1: Dispatch :fetch — machine transitions :idle → :loading; entry
  ;; action runs; the 5000ms :after timer schedules with epoch 1.
  ;;
  ;; Per Spec 005 §Hierarchy interaction the `:rf/after-epoch` slot holds
  ;; a per-decl-path map `{<path> <int>}` — runtime-managed, so the
  ;; machine spec / input snapshot do NOT seed it.
  {:call         :machine-transition
   :definition   {:initial :idle
                  :data    {}
                  :actions {:note-entry :loading/note-entry}
                  :states
                  {:idle {:on {:fetch :loading}}
                   :loading
                   {:entry :note-entry
                    :after {5000 :timeout}
                    :on    {:loaded :ready}}
                   :timeout {}
                   :ready   {}}}
   :snapshot     {:state :idle :data {}}
   :event        [:fetch]
   :expect-next-snapshot {:state :loading :data {:rf/after-epoch {[:loading] 1} :entered? true}}
   ;; Entry to an :after-bearing state emits a
   ;; :rf.machine/after-schedule fx so the runtime layer can install
   ;; the host-clock timer (interop/set-timeout!).
   :expect-effects [[:rf.machine/after-schedule
                     {:rf/parent-id :rf/transition-pure
                      :rf/invoke-id [:loading]
                      :state        :loading
                      :delay-key    5000
                      :epoch        1
                      :server?      false}]]}

  ;; Step 2: Test-clock advances 5000ms. The timer fires; epoch matches; the
  ;; transition resolves; snapshot lands at :timeout; the :loading node's
  ;; per-path epoch advances to 2 (it was exited).
  {:call         :machine-transition
   :definition   {:initial :idle
                  :data    {:rf/after-epoch {[:loading] 1} :entered? true}
                  :actions {:note-entry :loading/note-entry}
                  :states
                  {:idle {:on {:fetch :loading}}
                   :loading
                   {:entry :note-entry
                    :after {5000 :timeout}
                    :on    {:loaded :ready}}
                   :timeout {}
                   :ready   {}}}
   :snapshot     {:state :loading :data {:rf/after-epoch {[:loading] 1} :entered? true}}
   ;; The synthetic timer-elapsed event carries (delay, epoch, decl-path);
   ;; the harness supplies it as the dispatched event.
   :event        [:rf.machine.timer/after-elapsed 5000 1 [:loading]]
   :expect-next-snapshot {:state :timeout :data {:rf/after-epoch {[:loading] 2} :entered? true}}
   ;; Exiting an :after-bearing state emits a
   ;; :rf.machine/after-cancel fx so the runtime layer releases the
   ;; host-clock timer handle (and any subscription watcher).
   :expect-effects [[:rf.machine/after-cancel
                     {:rf/parent-id :rf/transition-pure
                      :rf/invoke-id [:loading]}]]}]}
