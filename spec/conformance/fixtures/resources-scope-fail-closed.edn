;; Conformance fixture: resources/scope-fail-closed
;;
;; Spec 016 §Every resource declares a scope policy — the cache's tenant / user
;; / permission / locale / impersonation / SSR leak boundary MUST fail closed:
;; it never silently defaults to "shared". There is NO tier-4
;; [:rf.scope/global] fallthrough, and a resource's `:scope` policy is EXACTLY
;; one of two shapes — `:rf.scope/global` or `{:from-db <resource-scope-id>}`.
;; The fail-closed conditions each raise a distinct, loud error id rather than
;; reading a wrong or global cache scope:
;;
;;   (i)   REGISTRATION, missing — a `reg-resource` with no `:scope` policy is a
;;         loud registration error (:rf.error/resource-missing-scope-policy).
;;         "I forgot this read is user-scoped" is unrepresentable at
;;         registration rather than an Xray heuristic.
;;   (ii)  REGISTRATION, not one of the two shapes — an app-namespaced keyword,
;;         a literal map, a string, or a `:rf.scope/*` typo is refused by the
;;         SAME error. A constant at registration partitions the cache exactly
;;         as `:rf.scope/global` does; a tenant that is STATE is `{:from-db …}`.
;;   (iii) WRITE-SIDE / READ-SIDE USE-TIME — a `{:from-db <id>}` scope naming a
;;         resolver no `reg-resource-scope` registered fails closed at BOTH
;;         resolution boundaries (:rf.error/resource-scope-not-registered),
;;         never a silent global read and never a silent :idle. Exercised at the
;;         use-site OVERRIDE tier, which resolves the reference through the same
;;         single use-time rule the spec policy tier does.
;;
;; Each is pinned against the LIVE resolvers via a pure `:fixture/calls` op —
;; the write-side / read-side throws are captured DIRECTLY (no dispatch), the
;; way the runtime unit tests scope-resolution-fail-closed /
;; sub-side-scope-fail-closed assert them, so the exact error id is observable
;; (a dispatched handler throw would fold into a :rf.error/handler-exception
;; trace that does not carry the inner id). A control case confirms a declared
;; policy resolves rather than throwing.

{:fixture/id           :resources/scope-fail-closed
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:resources/scope-fail-closed}
 :fixture/doc          "The scope fail-closed set: reg-resource with no :scope policy, or with a value that is neither :rf.scope/global nor {:from-db <id>} → :rf.error/resource-missing-scope-policy; a {:from-db <id>} scope naming an unregistered resolver → :rf.error/resource-scope-not-registered on both the write and read resolvers. A control confirms an explicit :rf.scope/global policy resolves."

 :fixture/registry
 {:resource
  ;; An explicitly global resource. The use-time cases below reach it with a
  ;; `{:from-db …}` scope OVERRIDE, which resolves through the same single
  ;; use-time rule a `{:from-db …}` spec policy does — so the fail-closed
  ;; behaviour is pinned without the fixture having to carry a resolver
  ;; registration (EDN cannot express the resolver fn).
  {:res/global {:scope         :rf.scope/global
                :params-schema [:map [:slug :string]]
                :url-template  "/api/global/"}}}

 :fixture/calls
 [;; (i) REGISTRATION fail-closed: a spec with no :scope policy is rejected.
  {:call :reg-resource
   :resource-id :res/no-scope
   :spec        {:params-schema [:map [:slug :string]]}
   :expect-error :rf.error/resource-missing-scope-policy}

  ;; (ii) REGISTRATION fail-closed: values outside the closed two-shape policy.
  {:call :reg-resource
   :resource-id :res/app-keyword
   :spec        {:scope :my.app/tenant :params-schema [:map [:slug :string]]}
   :expect-error :rf.error/resource-missing-scope-policy}

  {:call :reg-resource
   :resource-id :res/literal-map
   :spec        {:scope {:tenant-id "acme"} :params-schema [:map [:slug :string]]}
   :expect-error :rf.error/resource-missing-scope-policy}

  {:call :reg-resource
   :resource-id :res/literal-string
   :spec        {:scope "tenant-acme" :params-schema [:map [:slug :string]]}
   :expect-error :rf.error/resource-missing-scope-policy}

  {:call :reg-resource
   :resource-id :res/reserved-typo
   :spec        {:scope :rf.scope/glabal :params-schema [:map [:slug :string]]}
   :expect-error :rf.error/resource-missing-scope-policy}

  ;; (iii) WRITE-SIDE use-time fail-closed: the reference names no resolver.
  {:call :resolve-scope
   :side :event
   :resource-id :res/global
   :payload-scope {:from-db :res/session}
   :expect-error :rf.error/resource-scope-not-registered}

  ;; (iii) READ-SIDE use-time fail-closed: the same reference, sub resolver.
  {:call :resolve-scope
   :side :sub
   :resource-id :res/global
   :params {:slug "x"}
   :payload-scope {:from-db :res/session}
   :expect-error :rf.error/resource-scope-not-registered}

  ;; CONTROL: an explicit :rf.scope/global policy resolves to global — because
  ;; that is its DECLARED policy, not because the precedence ran out of options.
  {:call :resolve-scope
   :side :event
   :resource-id :res/global
   :payload-scope nil
   :expect :rf.scope/global}

  ;; CONTROL: a concrete payload :scope is an OVERRIDE and resolves to itself.
  {:call :resolve-scope
   :side :event
   :resource-id :res/global
   :payload-scope {:user "u-1"}
   :expect {:user "u-1"}}]}
