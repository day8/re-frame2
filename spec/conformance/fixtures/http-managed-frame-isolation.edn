;; Conformance fixture: rf.http.managed/frame-isolation
;;
;; An `:fx-overrides` routing example shaped like Spec 014 §Frame awareness:
;; the reply lands in the frame the request was issued from. Two frames
;; issue requests from the same registered handler and keep their replies
;; isolated — frame A's reply writes to frame A's app-db, frame B's to frame
;; B's. The handler registry is shared (registered once); per-frame state is
;; partitioned.
;;
;; The fixture supplies its own bodies for `:rf.http/managed` and
;; `:rf.http/managed-canned-success`, so no managed-HTTP code runs. Each
;; frame carries its own `:fx-overrides`, and the canned-success body's
;; `:dispatch` inherits the originating frame (Spec 002 §Routing), so what
;; it grades is per-frame override redirection and the frame inheritance of
;; a dispatch made from an fx body. The ;; managed-HTTP lifecycle is not corpus-graded — see the conformance README
;; §Managed-HTTP lifecycle (not yet corpus-graded).

{:fixture/id           :rf.http.managed/frame-isolation
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx :core/frame
                         :rf.http/managed}
 :fixture/doc          "Two frames issue :rf.http/managed from the same registered :article/load handler, each redirected by its own :fx-overrides to the fixture's canned-success body; each reply that body dispatches lands in the frame the request was issued from. Grades per-frame override routing and the frame inheritance of an fx body's dispatch (Spec 002 §Routing), shaped like Spec 014 §Frame awareness."

 :fixture/registry
 {:event {:article/load   {:doc "Issue the GET (originator)."}
          :article/loaded {:doc "Receive the success payload, frame-scoped."}}
  :fx    {:rf.http/managed                {:platforms #{:client :server}}
          :rf.http/managed-canned-success {:platforms #{:client :server}}}}

 :fixture/handlers
 {:event
  {:article/load
   [[:fx [[:rf.http/managed
           {:request    {:method :get :url "/articles/hello"}
            :decode     :json
            :on-success [:article/loaded]}]]]]

   ;; The :on-success target writes to the receiving frame's :article slice.
   :article/loaded
   [[:set [:article] [:event-arg 1]]]}

  :fx
  {:rf.http/managed                [[:noop]]
   :rf.http/managed-canned-success
   ;; The DSL's :dispatch inherits the originating frame, so each canned
   ;; reply lands on the same frame the originating request was issued
   ;; from. The :value carries a frame-distinguishable token so the
   ;; fixture can assert where each reply landed.
   [[:dispatch [:article/loaded {:status :ok
                                 :value  {:from :stub}}]]]}}

 ;; Each frame carries its own :fx-overrides — multi-frame fixtures pass
 ;; per-frame opts via :fixture/frames, not the single-frame
 ;; :fixture/frame-config seam (which only applies to :rf/default).
 :fixture/frames
 [{:id :tab.left
   :doc "Left tab — issues its own managed request."
   :fx-overrides {:rf.http/managed :rf.http/managed-canned-success}}
  {:id :tab.right
   :doc "Right tab — issues its own managed request."
   :fx-overrides {:rf.http/managed :rf.http/managed-canned-success}}]

 :fixture/dispatches
 [{:event [:article/load] :frame :tab.left}
  {:event [:article/load] :frame :tab.right}]

 :fixture/expect
 {:final-app-dbs
  {:tab.left  {:article {:status :ok
                         :value  {:from :stub}}}
   :tab.right {:article {:status :ok
                         :value  {:from :stub}}}}

  ;; The :rf.fx/override-applied trace carries {:from :to} only — it
  ;; does not tag the frame (the override seam runs at fx dispatch
  ;; time, before the per-frame routing layer attaches its tags).
  ;; We assert the per-frame :event traces and the override-applied
  ;; pair without :frame.
  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :article/load   :frame :tab.left}}
   {:operation :rf.fx/override-applied
    :tags {:rf.fx/from :rf.http/managed
           :rf.fx/to   :rf.http/managed-canned-success}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :article/loaded :frame :tab.left}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :article/load   :frame :tab.right}}
   {:operation :rf.fx/override-applied
    :tags {:rf.fx/from :rf.http/managed
           :rf.fx/to   :rf.http/managed-canned-success}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :article/loaded :frame :tab.right}}]}}
