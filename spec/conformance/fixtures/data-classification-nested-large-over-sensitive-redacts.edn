;; Conformance fixture: data-classification/nested-large-over-sensitive-redacts
;;
;; Per Spec 015 §No propagation + EP-0025 §Egress rules: a `:large`-marked
;; subtree that CONTAINS a `:sensitive` DESCENDANT elides behind the ordinary
;; `:rf.size/large-elided` marker at the large node, with its `:bytes` (and
;; `:digest`, when enabled) measured over the subtree AFTER the sensitive
;; descendant is redacted — so no figure on the marker varies with the
;; secret's content or length. Sensitive at the same path still wins outright
;; (the sibling `sensitive-wins-over-large.edn` fixture).
;;
;; The OBSERVABLE seam is the t1 `:rf.event/db-pending` trace event (same emit
;; + projection path as the sibling sensitive / large / sensitive-wins
;; fixtures — projected through `re-frame.elision/elide-wire-value`). The
;; assertion pins the EXACT projected `:rf.event/db` value, including the
;; marker's exact `:bytes`.
;;
;; Mirrors the unit-level
;; `re-frame.elision-test/nested-axis-large-over-sensitive-elides-after-
;; redaction` (schema-first walker) and
;; `re-frame.projection-cljs-test/path-walker-nested-large-over-sensitive-
;; descendant-elides-after-redaction` (path walker) deftests, lifted to the
;; host-agnostic corpus through the runtime's emit-time projection chokepoint.
;;
;; Harness note: `:fixture/classification-effects` declares `[:a]` :large and
;; `[:a :b]` :sensitive via two ordered ops. Capability
;; `:data-classification/classification-effects`.

{:fixture/id           :data-classification/nested-large-over-sensitive-redacts
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/trace
                         :data-classification/classification-effects}
 :fixture/doc          "A :large-marked subtree [:a] containing a :sensitive descendant [:a :b] elides to the ordinary :rf.size/large-elided marker at [:a] in the t1 :rf.event/db-pending trace event, its :bytes measured over the subtree after [:a :b] is redacted, so the marker never varies with the secret (Spec 015 §No propagation)."

 :fixture/registry
 {:event {:dc/store {:doc "Writes a large-marked subtree carrying a sensitive descendant + a plain sibling into app-db."}}}

 :fixture/handlers
 {:event {:dc/store [[:set [:a :b] "TOP-SECRET-TOKEN"]
                     [:set [:a :c] "public"]]}}

 ;; Declare [:a] :large (the ancestor subtree) and [:a :b] :sensitive (a
 ;; strict descendant) — two ordered ops. The marker must be measured after
 ;; redaction regardless of declaration order.
 :fixture/classification-effects
 [{:large     [[:a]]}
  {:sensitive [[:a :b]]}]

 :fixture/frame-config
 {:initial-events [[:dc/store]]}

 :fixture/dispatches
 [[:dc/store]]

 :fixture/expect
 ;; The committed app-db is the RAW value — redaction is trace-egress only.
 {:final-app-db {:a {:b "TOP-SECRET-TOKEN" :c "public"}}

  ;; The load-bearing assertion: the large ancestor [:a] elides to the ordinary
  ;; marker, whose :bytes is the pr-str byte count of the subtree AFTER its
  ;; sensitive descendant redacts — `{:b :rf/redacted, :c "public"}`, 30 bytes.
  ;; A port that measures before redacting reports 36 and fails.
  :trace-emissions
  [{:operation :rf.event/db-pending
    :tags      {:rf.event/db
                {:a {:rf.size/large-elided
                     {:path   [:a]
                      :bytes  30
                      :type   :map
                      :reason :effect
                      :hint   nil
                      :handle [:rf.elision/at [:a]]}}}}}]}}
