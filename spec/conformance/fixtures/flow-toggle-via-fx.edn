;; Conformance fixture: flow/toggle-via-fx
;; Per Spec 013 §Activation rule 6 — a feature gate is data. A flow whose
;; output depends on whether a feature is engaged reads the gate as an
;; input, and the events that engage and withdraw the feature write the
;; gate into app-db. Nothing registers or clears a flow at runtime: the flow
;; is registered once and the frame runs it throughout, so the gate rewinds
;; with app-db under an epoch restore and arrives with it over SSR.

{:fixture/id           :flow/toggle-via-fx
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :flow/basic :flow/toggle}
 :fixture/doc          "A feature gate is an app-db input: :wizard/enter writes the gate and the flow's output takes it into account on that dispatch; :wizard/leave withdraws it on that dispatch too. The flow is registered once and runs throughout."

 :fixture/registry
 {:event {:wizard/init     {:doc "Seed the :step-2 total, with the gate withdrawn."}
          :wizard/enter    {:doc "Engage step 2 by writing its gate."}
          :wizard/bump-foo {:doc "Mutate the :step-2 total to drive a recompute."}
          :wizard/leave    {:doc "Withdraw step 2 by clearing its gate."}}
  :flow  {:step-2/computed {:doc         "The step-2 total while step 2 is engaged (gate 1), else 0 (gate 0)."
                            :inputs      [[:step-2 :total] [:step-2 :engaged]]
                            :output-path [:step-2 :result]}}}

 :fixture/handlers
 {:event {:wizard/init     [[:set [:step-2 :total] 7]
                            [:set [:step-2 :engaged] 0]]
          :wizard/enter    [[:set [:step-2 :engaged] 1]]
          :wizard/bump-foo [[:set [:step-2 :total] [:event-arg 1]]]
          :wizard/leave    [[:set [:step-2 :engaged] 0]]}}

 ;; `(fn [total engaged] (* total engaged))` — the gate is a 0/1 factor.
 :fixture/flow-bodies
 {:step-2/computed [[:fn :* [:event-arg 0] [:event-arg 1]]]}

 :fixture/frame-config
 {:flows          [:step-2/computed]
  :initial-events [[:wizard/init]]}

 ;; Sequence:
 ;;   :initial-events  — :total 7 with the gate at 0: the flow computes 0.
 ;;                      Recompute #1.
 ;;   :wizard/enter    — engages the gate; 7 at [:step-2 :result] by the
 ;;                      time this dispatch returns. Recompute #2.
 ;;   :wizard/bump-foo — :total 9; 9. Recompute #3.
 ;;   :wizard/leave    — withdraws the gate; 0 again on this same dispatch.
 ;;                      Recompute #4.
 :fixture/dispatches
 [[:wizard/enter]
  [:wizard/bump-foo 9]
  [:wizard/leave]]

 :fixture/expect
 {:final-app-db
  {:step-2 {:total 9 :engaged 0 :result 0}}

  ;; The frame runs the flow throughout.
  :flow-registry-after
  #{:step-2/computed}

  ;; `:final-app-db` is a SUBMAP matcher on the end state, so it cannot see
  ;; that the gate's writes each took effect on their own dispatch; four
  ;; recomputes say they did.
  :flow-recompute-counts
  {:step-2/computed 4}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :wizard/enter}}
   {:operation :rf.flow/computed   :tags {:flow-id :step-2/computed :result 7}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :wizard/bump-foo}}
   {:operation :rf.flow/computed   :tags {:flow-id :step-2/computed :result 9}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :wizard/leave}}
   {:operation :rf.flow/computed   :tags {:flow-id :step-2/computed :result 0}}]}}
