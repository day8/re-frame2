;; Conformance fixture: flow/toggle-via-fx
;; Per Spec 013 §Dynamic toggle via fx — two reserved fx-ids let event
;; handlers register and clear flows during normal event processing:
;;
;;   :rf.fx/reg-flow   — args are a flow map; registers the flow
;;   :rf.fx/clear-flow — args are a flow id;  clears the flow
;;
;; Both settle on the DISPATCHING frame (per Spec 013 §Sequencing): the
;; `:fx` walk enqueues one framework-private settling drain, so a flow
;; registered mid-event has its initial output by the time that dispatch
;; returns, and a cleared flow's :output-path is vacated by the same
;; boundary. No app-authored follow-up event is involved.

{:fixture/id           :flow/toggle-via-fx
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:core/event-handler :core/fx :flow/basic :flow/toggle}
 :fixture/doc          "Round-trip the dynamic toggle: an event handler emits :rf.fx/reg-flow which registers the flow; a later event emits :rf.fx/clear-flow which deregisters and dissoc-in's the output path. Both settle on their own dispatch — the flow's first run lands on the REGISTERING event, and the clear vacates the slot on the clearing event."

 :fixture/registry
 {:event {:wizard/init       {:doc "Seed :step-2 inputs."}
          :wizard/enter      {:doc "Register the :step-2/computed flow via fx."}
          :wizard/bump-foo   {:doc "Mutate :step-2 :foo to drive a recompute."}
          :wizard/leave      {:doc "Clear the :step-2/computed flow via fx."}}
  :fx    {:rf.fx/reg-flow   {:doc "Reserved — register a flow at runtime."
                             :platforms #{:client :server}}
          :rf.fx/clear-flow {:doc "Reserved — clear a flow at runtime."
                             :platforms #{:client :server}}}}

 ;; The flow body is described declaratively; the harness wires it to
 ;; (fn [foo bar] (+ foo bar)) when materialising the :rf.fx/reg-flow
 ;; effect's args.
 :fixture/handlers
 {:event {:wizard/init     [[:set [:step-2 :foo] 3]
                            [:set [:step-2 :bar] 4]]
          :wizard/enter    [[:fx :rf.fx/reg-flow
                             {:id     :step-2/computed
                              :inputs [[:step-2 :foo] [:step-2 :bar]]
                              :body   [[:fn :+ [:event-arg 0] [:event-arg 1]]]
                              :output-path [:step-2 :result]}]]
          :wizard/bump-foo [[:set [:step-2 :foo] [:event-arg 1]]]
          :wizard/leave    [[:fx :rf.fx/clear-flow :step-2/computed]]}}

 :fixture/frame-config
 {:initial-events [[:wizard/init]]}

 ;; Sequence:
 ;;   :wizard/enter    — registers the flow. It settles on THIS dispatch
 ;;                      (per Spec 013 §Sequencing); inputs are 3 + 4, so
 ;;                      [:step-2 :result] is 7 by the time it returns.
 ;;                      Recompute #1.
 ;;   :wizard/bump-foo — mutates :step-2 :foo to 5; the flow recomputes on
 ;;                      this drain → 5 + 4 = 9 at [:step-2 :result].
 ;;                      Recompute #2.
 ;;   :wizard/leave    — clears the flow. The output path is dissoc-in'd on
 ;;                      this same dispatch, so the registry row and the
 ;;                      value it owned go together.
 :fixture/dispatches
 [[:wizard/enter]
  [:wizard/bump-foo 5]
  [:wizard/leave]]

 :fixture/expect
 ;; After :wizard/leave, :step-2 retains :foo / :bar; :result is gone
 ;; (clear-flow dissoc-in's the leaf at the flow's :output-path).
 ;;
 ;; NOTE: rf2-aqt7 — clear-flow with a single-element :output-path (e.g. [:area])
 ;; currently leaves the key in app-db (off-by-one in update-in
 ;; (butlast path)). This fixture uses a two-element :output-path
 ;; ([:step-2 :result]) which exercises the working code path.
 {:final-app-db
  {:step-2 {:foo 5 :bar 4}}

  ;; The harness checks that the flow registry no longer contains
  ;; :step-2/computed after :wizard/leave fires.
  :flow-registry-after
  #{}

  ;; This count is what pins the settle contract, and `:final-app-db`
  ;; cannot: it is a SUBMAP matcher, so it is blind to a stale `:result`
  ;; the clear failed to vacate, and blind to whether the registering
  ;; dispatch computed anything at all. Two recomputes says both — one on
  ;; :wizard/enter (the settle) and one on :wizard/bump-foo. Under the
  ;; superseded next-drain behaviour :wizard/enter computed nothing and
  ;; this read 1.
  :flow-recompute-counts
  {:step-2/computed 2}}}
