;; Conformance fixture: ssr/hydration-mismatch
;; Hydration mismatches are reported by the hydrating root's React adoption
;; reporter — the recoveries React makes while it adopts the server markup
;; ([011 §Hydration-mismatch detection]). A data harness has no React root to
;; drive, so this fixture pins the half of the contract it can see: a payload
;; whose state differs from the client's own seed hydrates to the server's
;; slice.

{:fixture/id           :ssr/hydration-mismatch
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:ssr/hydration}
 :fixture/doc          "The client seeds a different state than the server rendered; :rf/hydrate replaces it with the payload's :rf/app-db. Mismatches are reported only by the hydrating root's React adoption reporter."

 :fixture/registry
 {:event {:rf/hydrate    {:doc "Standard hydration handler — replaces app-db with payload's :rf/app-db."}
          :counter/init  {:doc "Client-only seed; clobbered by hydrate."}}
  :sub   {:count {:doc "Current count."}
          :greeting {:doc "Greeting derived from app-db."}}
  :view  {:root {:doc "Root view; greeting + count."}}}

 :fixture/handlers
 {:event {:rf/hydrate   [[:set [] [:get-event-arg 1 :rf/app-db]]]  ;; replace app-db with payload's :rf/app-db
          :counter/init [[:set [] {:count 0 :greeting "Hello, client!"}]]}
  :sub   {:count    [[:get [:count]]]
          :greeting [[:get [:greeting]]]}}

 :fixture/frame-config
 {:initial-events [[:counter/init]]}                                       ;; client seeds something different than the server

 :fixture/dispatches
 [[:rf/hydrate {:rf/version       1
                :rf/frame-id      :rf/default
                :rf/app-db        {:count 5 :greeting "Hello, server!"}}]]

 :fixture/expect
 {:final-app-db {:count 5 :greeting "Hello, server!"}

  :sub-values   {[:count] 5
                 [:greeting] "Hello, server!"}

  :trace-emissions
  [{:operation :rf.event/run-start :tags {:rf.trace/event-id :counter/init}}
   {:operation :rf.event/run-start :tags {:rf.trace/event-id :rf/hydrate}}]}}
