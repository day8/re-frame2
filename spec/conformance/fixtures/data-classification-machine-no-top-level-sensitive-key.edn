;; Conformance fixture: data-classification/machine-no-top-level-sensitive-key
;;
;; Per Spec 015 §Machine-owned durable classification and the rf2-0k5ubx
;; (2026-06-09) ruling that explicitly REJECTED top-level machine `:sensitive` /
;; `:large` keys — a `reg-machine` spec carries NO top-level `:sensitive` /
;; `:large` key. Per EP-0025 (RULED 2026-06-20, rf2-398kql) machine `:data`
;; egress classification is FRAME-OWNED: the frame declares the machine
;; snapshot's `:data` path sensitive via `reg-frame` `:sensitive` / `:large
;; {:app-db …}` (the sole app-db mechanism). The earlier schema-first machine
;; route — `:sensitive?` / `:large?` Malli props on the `:data-schema` slots —
;; is REVERSED; the positive frame-owned surface is pinned by the
;; `data-classification-machine-data-frame-declared-redacts.edn` fixture.
;;
;; This fixture pins the NEGATIVE half host-agnostically: a machine spec that
;; carries a frame-shaped TOP-LEVEL `:sensitive` / `:large` key validates
;; SILENTLY — the key is IGNORED, not honoured as a classification route (the
;; classification belongs on the FRAME, not the machine spec). The ruled
;; behaviour is "ignore + no-op" (not "reject"): the registration-time validator
;; (`validate-machine!`) walks only the grammar keys, so a top-level
;; `:sensitive` / `:large` key is inert. A control `:reg-machine` call (no
;; `:expect-error`) passes iff the validator does not throw, which is exactly
;; the ignore-don't-reject disposition.
;;
;; Mode-B `:reg-machine` (registration-validation). Capabilities
;; `:fsm/flat` + `:fsm/registration-validation`.

{:fixture/id           :data-classification/machine-no-top-level-sensitive-key
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:fsm/flat :fsm/registration-validation}
 :fixture/doc          "A reg-machine spec carrying a frame-shaped TOP-LEVEL :sensitive / :large key validates SILENTLY — the key is ignored, not a classification route (rf2-0k5ubx). Per EP-0025 machine :data egress classification is declared by the commit-plane :sensitive / :large effects (a reg-event returns :sensitive / :large alongside :db); reg-machine carries no classification key at all (neither top-level :sensitive/:large nor — post-EP-0025 — a classifying :data-schema prop)."

 :fixture/calls
 [;; A machine spec with frame-shaped top-level :sensitive / :large keys —
    ;; the rf2-0k5ubx-rejected proposal. It validates SILENTLY: the keys are
    ;; ignored (no :expect-error ⇒ the validator must not throw).
  {:call       :reg-machine
   :definition {:sensitive [[:data :token]]
                :large     [[:data :blob]]
                :initial   :anon
                :data      {:token nil :blob nil}
                :states    {:anon   {:on {:login :authed}}
                            :authed {}}}}

  ;; Control: the SAME machine WITHOUT the top-level keys also validates
    ;; silently — confirming the keys were inert, not load-bearing grammar.
  {:call       :reg-machine
   :definition {:initial :anon
                :data    {:token nil :blob nil}
                :states  {:anon   {:on {:login :authed}}
                          :authed {}}}}]}
