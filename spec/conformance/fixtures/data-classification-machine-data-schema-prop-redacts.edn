;; Conformance fixture: data-classification/machine-data-schema-prop-redacts
;;
;; Per Spec 015 §Machine-owned durable classification (EP-0005 composition,
;; not replacement) + the §Tests fixture table, and Spec 005 §Privacy —
;; redacting machine `:data` at trace egress.
;;
;; EP-0015 issue 12 (RULED 2026-06-11): NO supersession of EP-0005. The
;; schema-first machine surface STANDS — machine `:data` sensitivity is
;; declared by attaching `:sensitive?` / `:large?` Malli props to the slots
;; of the machine's `:data-schema`. There are NO top-level machine
;; `:sensitive` / `:large` keys (a considered proposal to add them was
;; rejected; `reg-machine` carries no such key).
;;
;; This fixture pins the OBSERVABLE contract of that ruled surface: a
;; `reg-machine` whose `:data-schema` marks `[:token {:sensitive? true}]`,
;; after a transition whose action writes a live secret token into `:data`,
;; projects `:rf/redacted` at `[:data :token]` in the `:rf.machine/transition`
;; and `:rf.machine/snapshot-updated` trace `:after` snapshot — while an
;; unmarked sibling slot (`:retries`) rides egress verbatim. The redaction is
;; a TRACE-EGRESS concern: the committed runtime-db snapshot carries the raw
;; value; only the projected trace event redacts (the listener fan-out runs
;; through `:marks/project-trace-event`).
;;
;; Capability `:data-classification/marks` (already claimed by both the JVM
;; and CLJS conformance corpus runners) + `:fsm/flat` + `:core/trace`. The
;; schema-prop → snapshot-egress bridge (`register-data-schema-marks!`) runs
;; at `reg-machine` time and consults the schemas artefact's path extractor,
;; both of which the conformance runner loads.

{:fixture/id           :data-classification/machine-data-schema-prop-redacts
 :fixture/spec-version "1.0"
 :fixture/capabilities #{:fsm/flat :core/event-handler :core/trace
                         :data-classification/marks}
 :fixture/doc          "A reg-machine whose :data-schema marks [:token {:sensitive? true}], after a transition whose action writes a secret token into :data, projects :rf/redacted at [:data :token] in the :rf.machine/transition and :rf.machine/snapshot-updated trace :after snapshot; an unmarked sibling slot rides egress verbatim. EP-0015 issue 12: the schema-first machine surface stands (no top-level machine :sensitive / :large key)."

 :fixture/registry
 {:event {:dc/auth {:doc "Machine-as-event-handler; the schema-first machine surface under test."}}
  :machine-action
  {:dc/store-token {:doc "Action body writes the secret token + bumps retries into machine :data."}}
  ;; The machine spec is registered via re-frame.machines/reg-machine. Its
  ;; :data-schema marks the :token slot :sensitive? — extracted at
  ;; registration, rooted under [:data …] to match the snapshot shape, and
  ;; honoured in snapshot egress. The runner merges the realised
  ;; :machine-action body into the spec's :actions slot.
  :machine
  {:dc/auth {:initial     :anon
             :data        {:retries 0 :token nil}
             :data-schema [:map
                           [:retries :int]
                           [:token {:sensitive? true} [:maybe :string]]]
             :states      {:anon   {:on {:login {:target :authed
                                                 :action :dc/store-token}}}
                           :authed {}}}}}

 :fixture/handlers
 ;; Action signature (Spec 005 §Actions): (fn [{:keys [data event]}] {:data … :fx …}).
 ;; [:set [:token] [:event-arg 1]] writes the inner event's token arg into :data;
 ;; the inner event is [:login "secret-jwt"], so [:event-arg 1] is the token.
 {:machine-action
  {:dc/store-token [[:set [:token]   [:event-arg 1]]
                    [:set [:retries] 1]]}}

 :fixture/frame-config {}

 :fixture/dispatches
 ;; Inner-event sub-routing (Spec 005 §Registration): the outer event
 ;; [:dc/auth [:login "secret-jwt"]] yields inner-event [:login "secret-jwt"]
 ;; inside the handler, triggering the :anon → :authed transition whose action
 ;; writes the secret token into :data.
 [[:dc/auth [:login "secret-jwt"]]]

 :fixture/expect
 ;; The committed runtime-db snapshot carries the RAW token — redaction is a
 ;; trace-egress concern only. (The conformance harness asserts machine
 ;; snapshots via runtime-db; here the load-bearing contract is the projected
 ;; trace, asserted below.)
 {:trace-emissions
  ;; The matcher partial-matches each trace by its named keys and matches a
  ;; map-valued :tags key one level deep, comparing each :tags entry by exact
  ;; value. The :after snapshot is asserted as a full literal map (small +
  ;; deterministic): the :sensitive? :token slot redacts to :rf/redacted, the
  ;; unmarked :retries sibling rides verbatim, and the reserved
  ;; :rf/spawn-counter snapshot key is carried.
  [{:operation :rf.machine/transition
    :tags      {:machine-id :dc/auth
                :after      {:state :authed
                             :data  {:retries 1 :token :rf/redacted}
                             :rf/spawn-counter {}}}}
   {:operation :rf.machine/snapshot-updated
    :tags      {:machine-id :dc/auth
                :after      {:state :authed
                             :data  {:retries 1 :token :rf/redacted}
                             :rf/spawn-counter {}}}}]}}
