  {:namespace "re-frame.freehand" :var "->react" :kind :fn :facade? true :tier :advanced :owner "004" :status "EP-0036" :runtime-verified? false}
  ;; The BEHAVIOR TOOL PLANE (EP-0036 F5g, D013 §8) — the two read-only
