  ;; the open/close/teardown machinery is "otherwise unrowed-internal").
  {:namespace "day8.re-frame2-xray.mount" :var "mounted?" :kind :fn :facade? false :tier :internal-public :owner "tools/xray" :status "post-v1 lib" :runtime-verified? true}
  ;; day8.re-frame2-xray.panels — the `mount-<panel>!` aggregator family
  ;; (007-UX-IA §Mountable panel contract). `internal-public` — the
  ;; canonical SUPPORTED host/tool embedding surface (a host that builds its
  ;; own Xray chrome may call `mount-shell!` / a `mount-<panel>!`; an app
  ;; never should). This is exactly what `internal-public` means after
  ;; rf2-oekz6s tightened the tier: supported-for-embedding, not the
  ;; implementation leaves (the bare `Panel` reg-views are now
