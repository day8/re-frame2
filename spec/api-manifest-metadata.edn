  ;; They ride the DOOR rather than a `re-frame.freehand.controller`
  ;; sibling because Conventions §Freehand — one public namespace fixes
  ;; `re-frame.freehand.host` and `re-frame.freehand.test` as the only
  ;; sanctioned siblings. The mechanics stay in the internal
  ;; `re-frame.freehand.control`, which is not rowed.
  ["re-frame.freehand" "controller-key"]      {:tier :advanced  :owner "004" :status "EP-0036"}
  ["re-frame.freehand" "controller-revision"] {:tier :advanced  :owner "004" :status "EP-0036"}
  ["re-frame.freehand" "controller-current?"] {:tier :advanced  :owner "004" :status "EP-0036"}
