  ;; differs from the `:adapter`-tier wrapper adapters
  ;; (`re-frame.adapter.{reagent,uix}/adapter`): those are chosen against a
  ;; renderer, this is the substrate's own observation wiring for a substrate
  ;; that renders itself, and it is what a Freehand app reaches for by default.
  ;; Spec 006 owns the adapter contract.
  {:namespace "re-frame.freehand" :var "adapter" :kind :var :facade? false :tier :front-porch :owner "006" :status "EP-0036" :runtime-verified? true}
  {:namespace "re-frame.freehand" :var "mount" :kind :fn :facade? true :tier :front-porch :owner "004C" :status "EP-0036" :runtime-verified? false}
  {:namespace "re-frame.freehand" :var "hydrate-root" :kind :fn :facade? true :tier :front-porch :owner "011" :status "EP-0036" :runtime-verified? false}
  {:namespace "re-frame.freehand" :var "unmount!" :kind :fn :facade? true :tier :front-porch :owner "004C" :status "EP-0036" :runtime-verified? false}
  ;; `->react` (EP-0036 F5c, D014) is the OUTWARD React bridge: a declared view
