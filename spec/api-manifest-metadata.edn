  {:namespace "re-frame.fresco" :var "frame-provider" :kind :var :facade? false :tier :advanced :owner "002"  :status "v1" :runtime-verified? true}
  {:namespace "re-frame.fresco" :var "frame-root"     :kind :var :facade? false :tier :advanced :owner "002"  :status "v1" :runtime-verified? true}
  {:namespace "re-frame.fresco" :var "client-root"    :kind :fn  :facade? false :tier :advanced :owner "006"  :status "v1" :runtime-verified? true}
  {:namespace "re-frame.fresco" :var "portal"         :kind :var :facade? false :tier :advanced :owner "006"  :status "v1" :runtime-verified? true}
