#!/usr/bin/env sh
# .git/hooks/post-merge (re-frame2-managed segments)
#
# Two advisory blocks, both about things a `git pull` (which invokes
# `git merge`, and thus this hook) can silently invalidate:
#
#   rf2-6jj3r — source changes for an MCP server whose compiled binary is
#               gitignored: the binary on disk is now stale.
#   rf2-zt65l — changes under scripts/git-hooks/: the installed hooks are
#               copies, so they are now stale.
#
# Installed by scripts/install-git-hooks.sh (POSIX) or .ps1 (Windows).
# Source of truth: scripts/git-hooks/post-merge.
#
# The hook is ADVISORY: it never fails the merge. It prints to stderr only.
#
# Cross-platform: runs under Git Bash on Windows, macOS, Linux. POSIX sh.

# --- BEGIN re-frame2 MCP-staleness check (rf2-6jj3r) ---
# Managed by scripts/install-git-hooks.sh. Do not edit between markers.
{
  # Locate the repo root from the hook context. Git invokes hooks with the
  # working directory set to the top of the worktree, but be defensive in
  # case a wrapper changed cwd.
  _rf2_repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || _rf2_repo_root=""
  if [ -n "$_rf2_repo_root" ]; then
    _rf2_lib="$_rf2_repo_root/scripts/git-hooks/lib/check-stale-mcp-binary.sh"
    if [ -f "$_rf2_lib" ]; then
      # ORIG_HEAD is set by `git merge` (and thus `git pull`) to the
      # pre-merge HEAD. Compare it against the post-merge HEAD to find
      # changed paths. If ORIG_HEAD is unset (rare — e.g. a fast-forward
      # via plumbing that didn't update it), skip silently.
      if git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
        _rf2_changed=$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null)
        if [ -n "$_rf2_changed" ]; then
          # shellcheck source=lib/check-stale-mcp-binary.sh
          . "$_rf2_lib"
          printf '%s\n' "$_rf2_changed" | check_stale_mcp_binary
        fi
      fi
    fi
  fi
  unset _rf2_repo_root _rf2_lib _rf2_changed
} || true
# --- END re-frame2 MCP-staleness check (rf2-6jj3r) ---

# --- BEGIN re-frame2 hook-install staleness check (rf2-zt65l) ---
# Managed by scripts/install-git-hooks.sh. Do not edit between markers.
{
  # The hooks on disk are COPIES of scripts/git-hooks/*. A pull that lands a
  # new or changed guard leaves the copies behind, silently, forever — that
  # is rf2-zt65l: the beads boundary block sat unwritten for seven weeks
  # while every checkout believed it was guarded. `git pull` is the moment
  # the drift is created, so it is the moment to report it.
  _rf2_repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || _rf2_repo_root=""
  _rf2_installer="$_rf2_repo_root/scripts/install-git-hooks.sh"
  # Invoke via `sh` — a Windows checkout may not carry the exec bit.
  if [ -n "$_rf2_repo_root" ] && [ -f "$_rf2_installer" ] \
     && ! sh "$_rf2_installer" --check >/dev/null 2>&1; then
    printf '\n[re-frame2] git hooks on disk are stale or incomplete — the local\n' >&2
    printf '  commit guards may not be armed. Repair (idempotent, seconds; linked\n' >&2
    printf '  worktrees share one hooks directory, so a single run re-arms them all):\n\n' >&2
    printf '      sh scripts/install-git-hooks.sh\n\n' >&2
    printf '  What drifted:  sh scripts/install-git-hooks.sh --check\n\n' >&2
  fi
  unset _rf2_repo_root _rf2_installer
} || true
# --- END re-frame2 hook-install staleness check (rf2-zt65l) ---
