#!/usr/bin/env sh
# .git/hooks/pre-commit (re-frame2-managed segments)
#
# THREE marker blocks. The first two are one per direction of the
# mayor/worker boundary; the third asks a different question of the same file.
#
#   rf2-ydl2p — refuses commits in the MAYOR checkout that touch
#               worker-tracked surfaces (source, spec, docs, scripts).
#   rf2-ia8o7 — refuses commits in a WORKER worktree that touch the beads
#               DATABASE (the stale-worker-snapshot failure mode).
#   rf2-or8te — refuses a commit, from ANY worktree, that would empty the
#               beads tracker or lose more than a tenth of it.
#
# The first two say: source flows mayor -> worker, tracker state flows
# worker -> mayor, and neither crosses back. The third says: and when the
# tracker does flow, it arrives whole.
#
# Refuses commits in the MAYOR checkout that touch worker-tracked surfaces
# (rf2-ydl2p). Mayor commits are allowed only for `.beads/issues.jsonl` and
# the optional root `MEMORY.md`; any source/spec/test/doc/script change
# must originate from a worker worktree under the worktree parent
# directory (a sibling of the mayor checkout, e.g. `../re-frame2-worktrees/`).
#
# Activation is gated by a marker file (default `.git/mayor-marker`) that
# the installer drops into the mayor checkout's git common dir at install
# time. Worker worktrees share the same hooks directory (git's default
# for `git worktree add`) but do NOT share their per-worktree `.git/`
# directory — so the marker is only visible from the mayor's git dir, and
# this hook becomes a no-op everywhere else.
#
# Installed by scripts/install-git-hooks.sh (POSIX) or .ps1 (Windows).
# Source of truth: scripts/git-hooks/pre-commit.
#
# Discovery context: rf2-oswhk (#2136) near-mishap, 2026-05-25 — a worker
# tool call landed a commit on the mayor checkout's local main because of
# a PowerShell cwd leak. This commit-time guard complements the edit-time
# guard at scripts/assert-worker-worktree.ps1.
#
# Cross-platform: runs under Git Bash on Windows, macOS, Linux. POSIX sh.

# --- BEGIN re-frame2 mayor commit boundary (rf2-ydl2p) ---
# Managed by scripts/install-git-hooks.sh. Do not edit between markers.
{
  # Locate the per-worktree git dir (NOT the shared common dir). Git
  # invokes hooks with the worktree-specific GIT_DIR set; we re-derive it
  # defensively in case a wrapper changed the environment.
  _rf2_git_dir=$(git rev-parse --git-dir 2>/dev/null) || _rf2_git_dir=""
  _rf2_marker=""
  if [ -n "$_rf2_git_dir" ]; then
    # `--git-dir` may be relative (e.g. ".git") when invoked from the
    # worktree root; resolve to absolute against the toplevel so the
    # marker check is unambiguous.
    case "$_rf2_git_dir" in
      /*|[A-Za-z]:[\\/]*) _rf2_marker="$_rf2_git_dir/mayor-marker" ;;
      *)
        _rf2_top=$(git rev-parse --show-toplevel 2>/dev/null) || _rf2_top=""
        if [ -n "$_rf2_top" ]; then
          _rf2_marker="$_rf2_top/$_rf2_git_dir/mayor-marker"
        fi
        ;;
    esac
  fi

  if [ -n "$_rf2_marker" ] && [ -f "$_rf2_marker" ]; then
    # We are in the mayor checkout. Run the commit-boundary check.
    _rf2_repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || _rf2_repo_root=""
    if [ -n "$_rf2_repo_root" ]; then
      _rf2_lib="$_rf2_repo_root/scripts/git-hooks/lib/check-mayor-commit-boundary.sh"
      if [ -f "$_rf2_lib" ]; then
        # shellcheck source=lib/check-mayor-commit-boundary.sh
        . "$_rf2_lib"
        _rf2_staged=$(git diff --cached --name-only 2>/dev/null)
        if ! printf '%s\n' "$_rf2_staged" | check_mayor_commit_boundary; then
          unset _rf2_git_dir _rf2_marker _rf2_top _rf2_repo_root _rf2_lib _rf2_staged
          exit 1
        fi
      fi
    fi
  fi

  unset _rf2_git_dir _rf2_marker _rf2_top _rf2_repo_root _rf2_lib _rf2_staged
} || true
# --- END re-frame2 mayor commit boundary (rf2-ydl2p) ---

# --- BEGIN re-frame2 worker beads boundary (rf2-ia8o7) ---
# Managed by scripts/install-git-hooks.sh. Do not edit between markers.
{
  # The mirror image of the block above: that one keeps the MAYOR out of
  # worker-tracked source; this one keeps WORKERS out of the beads database.
  # It activates in every NON-PRIMARY (linked) worktree and no-ops in the
  # mayor checkout, where committing tracker state is the intended flow.
  # Primary-worktree derivation lives in the library — no marker file, so a
  # fresh clone that has never run the installer is correctly treated as
  # primary rather than being locked out of its own tracker.
  _rf2b_top=$(git rev-parse --show-toplevel 2>/dev/null) || _rf2b_top=""
  if [ -n "$_rf2b_top" ]; then
    _rf2b_lib="$_rf2b_top/scripts/git-hooks/lib/check-beads-boundary.sh"
    if [ -f "$_rf2b_lib" ]; then
      # shellcheck source=lib/check-beads-boundary.sh
      . "$_rf2b_lib"
      if ! rf2_beads_in_primary_worktree; then
        _rf2b_staged=$(git diff --cached --name-only 2>/dev/null)
        if ! printf '%s\n' "$_rf2b_staged" | check_beads_boundary commit; then
          unset _rf2b_top _rf2b_lib _rf2b_staged
          exit 1
        fi
      fi
    fi
  fi

  unset _rf2b_top _rf2b_lib _rf2b_staged
} || true
# --- END re-frame2 worker beads boundary (rf2-ia8o7) ---

# --- BEGIN re-frame2 beads truncation floor (rf2-or8te) ---
# Managed by scripts/install-git-hooks.sh. Do not edit between markers.
{
  # The two blocks above police WHO commits what. This one polices WHAT is
  # in the beads tracker when it IS committed, and it is the only one that
  # runs in the PRIMARY worktree — which is where it had to be, because both
  # times an empty export reached main the commit was a plain `git add` from
  # the mayor checkout, where the block above correctly no-ops.
  #
  # No marker file and no worktree derivation: a truncated tracker is wrong
  # from anywhere. In a worker the block above has already refused the commit
  # and exited, so in practice this fires only in the primary.
  _rf2t_top=$(git rev-parse --show-toplevel 2>/dev/null) || _rf2t_top=""
  if [ -n "$_rf2t_top" ]; then
    _rf2t_lib="$_rf2t_top/scripts/git-hooks/lib/check-beads-boundary.sh"
    if [ -f "$_rf2t_lib" ]; then
      # shellcheck source=lib/check-beads-boundary.sh
      . "$_rf2t_lib"
      _rf2t_staged=$(git diff --cached --name-only 2>/dev/null)
      if ! printf '%s\n' "$_rf2t_staged" | check_beads_truncation; then
        unset _rf2t_top _rf2t_lib _rf2t_staged
        exit 1
      fi
    fi
  fi

  unset _rf2t_top _rf2t_lib _rf2t_staged
} || true
# --- END re-frame2 beads truncation floor (rf2-or8te) ---
