# Clojure / CLJS
/.cpcache/
**/.cpcache/
/.shadow-cljs/
/target/
/out/
/classes/
/node_modules/
*.log
pom.xml

# OS / editors
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.iml

# Local dev
.env
.env.local
.envrc

# Throwaway test fixtures created under the repo so a repo-relative path can
# reach them across all Bash flavours (rf2-6m7pn4 — Windows path portability).
/.scratch/
**/.scratch/

# AI working tree (local-only — findings, map, super-prompt playground)
# Per docs/the-mayor-method/
/ai/
# Exception: extended-context is durable committed project context (the mayor
# consults it on bootstrap, contributes on retrospectives) — keep it tracked.
!/ai/extended-context/
!/ai/extended-context/**

# Force-tracked exception (TEMPORARY, removed at re-frame.ui S7 — see the S7
# cleanup bead): ai/findings/new-substrate-synthesis/ is force-added to git
# (`git add -f`, the same mechanism as new-substrate-codex/) so the ratified
# re-frame.ui program plan — blessed API table, decision record, certified prep
# docs, contract drafts — is durable + worker-visible and another AI can pick up
# the process from a clean clone. The S3–S7 stage epics cite it as the
# authoritative plan. Content promotes into spec/ across the stages (R-1/R-2);
# when every cited contract has its spec/ home the tree is git-rm'd. Other paths
# under ai/ stay local unless force-added the same way; the end state is that
# nothing under /ai/ is tracked. Edits to tracked files commit normally; a NEW
# synthesis file needs `git add -f`.

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# MkDocs build artefacts (rf2-h09k)
/site/
# spec/ + migration/ are staged into docs/{spec,migration}/ at build time;
# never commit the staged copies.
/docs/spec/
/docs/migration/
# The docs/cljs live-cell SCI bundle (rf2-tzy13) — a shadow-cljs :advanced
# build over re-frame2 core + reagent-slim + machines + flows + react@19. It is
# a GENERATED artefact, built at each consumption boundary (test.yml's
# tools-playground job at PR time, docs.yml on deploy) and by `npm run build` in
# docs/tools/playground locally. It was previously committed; every PR touching
# a baked-in surface then had to regenerate the same ~1.7 MB binary, and two such
# PRs always conflicted on it. Ignored by EXACT path — the esbuild bootstrap
# (playground.js / playground.css) in the same directory stays committed.
/docs/cljs/playground-rf2.js
# Python bytecode from mkdocs_hooks.py (rf2-qvlf) and scripts/ (rf2-sefq).
/__pycache__/
**/__pycache__/

# Skills build artefacts
skills/*/node_modules/
skills/*/.shadow-cljs/
skills/*/out/
skills/*/target/

# clj-kondo cache (rf2-mfi1s) — config.edn at /.clj-kondo/ is checked in;
# the cache subdir is regenerated per-machine.
/.clj-kondo/.cache/
/.clj-kondo/.cache-version

# Orphan npm lockfile (rf2-mfi1s) — there is no repo-root package.json;
# this guards against stray `npm` invocations from the wrong cwd.
/package-lock.json

# CDP scratch dir from examples/ test runs (rf2-mfi1s) — local Chrome
# user-data-dir, never committed.
/examples/.edge-cdp/

# Local worktrees created by EnterWorktree tool (rf2-mfi1s) — agent
# scratch space, local-only.
/.claude/worktrees/
