# Clojure / CLJS
/.cpcache/
**/.cpcache/
/.shadow-cljs/
/target/
# Per-artefact clein build output. `clojure -M:clein jar|pom` writes into
# <artefact>/target/; the release preflights (e.g. preflight-story-package.sh)
# build there before deploy, so running one locally must not dirty the tree.
implementation/**/target/
tools/*/target/
/out/
/classes/
/node_modules/
*.log
pom.xml

# OS / editors
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.iml

# Local dev
.env
.env.local
.envrc

# Gate artefacts from a worker run (rf2-lci2z). `*.log` above already covers the
# gate log, but the exit-code file written beside it is not a `.log`, so it
# survived as untracked residue — and one untracked path is enough to make
# `git worktree remove` refuse the tree (rf2-p0m6m: nine worktrees would not
# reap, every one dirty with exactly one leftover). Both spellings the dispatch
# template names are ignored here.
*.exit
*-exit.txt

# Throwaway test fixtures created under the repo so a repo-relative path can
# reach them across all Bash flavours (rf2-6m7pn4 — Windows path portability).
/.scratch/
**/.scratch/

# AI working tree (local-only — findings, map, super-prompt playground)
# Per docs/the-mayor-method/ — the end state is that nothing under /ai/ is tracked.
/ai/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# MkDocs build artefacts (rf2-h09k)
/site/
# spec/ + migration/ are staged into docs/{spec,migration}/ at build time;
# never commit the staged copies.
/docs/spec/
/docs/migration/
# The docs/cljs live-cell SCI bundle (rf2-tzy13) — a shadow-cljs :advanced
# build over re-frame2 core + reagent-slim + machines + flows + react@19. It is
# a GENERATED artefact, built at each consumption boundary (test.yml's
# tools-playground job at PR time, docs.yml on deploy) and by `npm run build` in
# docs/tools/playground locally. It was previously committed; every PR touching
# a baked-in surface then had to regenerate the same ~1.7 MB binary, and two such
# PRs always conflicted on it. Ignored by EXACT path — the esbuild bootstrap
# (playground.js / playground.css) in the same directory stays committed.
/docs/cljs/playground-rf2.js
# Python bytecode from mkdocs_hooks.py (rf2-qvlf) and scripts/ (rf2-sefq).
/__pycache__/
**/__pycache__/

# Skills build artefacts
skills/*/node_modules/
skills/*/.shadow-cljs/
skills/*/out/
skills/*/target/

# clj-kondo cache (rf2-mfi1s) — config.edn at /.clj-kondo/ is checked in;
# the cache subdir is regenerated per-machine.
/.clj-kondo/.cache/
/.clj-kondo/.cache-version

# (rf2-2rtt6.78) `/package-lock.json` was ignored here on the premise —
# recorded under rf2-mfi1s — that there is no repo-root package.json, so any
# root lockfile was the residue of a stray `npm` invocation from the wrong cwd.
# That premise no longer holds: the repo root now carries a real, deliberately
# single-purpose `package.json` for the ESLint gate, and its lockfile is
# tracked so CI's `npm ci` resolves the exact same tree every run. The ignore
# is therefore gone rather than negated — a `!`-exception would leave the
# stale rationale above it readable as if it still applied.

# CDP scratch dir from examples/ test runs (rf2-mfi1s) — local Chrome
# user-data-dir, never committed.
/examples/.edge-cdp/

# Local worktrees created by EnterWorktree tool (rf2-mfi1s) — agent
# scratch space, local-only.
/.claude/worktrees/

# clj-kondo writes its analysis cache into whatever directory it is pointed at
# with `--config-dir`, which for the Hicasso lint export (rf2-hic-022) is the
# SHIPPED artefact directory. The cache is generated, per-machine, and must
# never reach the export a consumer copies.
**/clj-kondo.exports/**/.cache/
