    {
      "selector": "[data-test=\"story-evidence-beat\"][data-selected=\"true\"]",
      "padding": 2,
      "colour": "#1976d2",
      "label": "4  The failing beat",
      "labelPos": "left"
    },
    {
      "selector": "[data-test=\"story-evidence-beat\"][data-beat-idx=\"1\"]",
      "padding": 2,
      "colour": "#7e57c2",
      "label": "5  The :login/failure beat and its Xray links",
      "labelPos": "left"
    }
