{
  "name": "rf2-docs-cljs-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Live ClojureScript cells for the re-frame2 docs: CodeMirror 6 editors running plain CLJS on Scittle and re-frame2 code on a bundled SCI engine (sci/).",
  "type": "module",
  "scripts": {
    "build": "npm run build:bootstrap && npm run build:rf2",
    "build:bootstrap": "esbuild src/playground.mjs --bundle --minify --format=iife --outfile=../../cljs/playground.js && node scripts/copy-css.mjs",
    "build:dev": "esbuild src/playground.mjs --bundle --format=iife --outfile=../../cljs/playground.js && node scripts/copy-css.mjs",
    "build:rf2": "cd sci && npm install && npm run build",
    "smoke": "node test/smoke.test.mjs",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@nextjournal/clojure-mode": "0.3.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0"
  }
}
