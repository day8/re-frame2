;; Builds the engine for the docs' ```cljs-rf2 cells: an :advanced browser
;; bundle that installs `window.rf2sci`. `npm run build` copies it to
;; docs/cljs/playground-rf2.js; the bootstrap loads it only on pages with a
;; re-frame2 cell.
;;
;; React 19 has no UMD build, so react and react-dom come from npm
;; (sci/package.json, the versions the implementation pins) and are bundled
;; in. The result is one self-contained <script>.
{:deps {:aliases []}

 :builds
 {:rf2
  ;; Build into out/, then copy the single bundle to docs/cljs/, keeping
  ;; shadow's manifest and runtime files out of the deployed tree.
  {:target     :browser
   :output-dir "out"
   :asset-path "."
   :modules    {:playground-rf2 {:init-fn rf2-playground.sci/init}}
   ;; goog.DEBUG stays true. Cells register handlers and dispatch in the
   ;; same eval, which needs the dev-mode live registrar. With
   ;; goog.DEBUG=false that code is eliminated, each frame's handlers are
   ;; fixed when it is created, and a cell's new handlers never take effect.
   :compiler-options {:optimizations :advanced
                      :infer-externs :auto
                      :closure-defines {goog.DEBUG true}}}}}
