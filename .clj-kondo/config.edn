;; clj-kondo config for re-frame2 — repo-root.
;;
;; Activates project-aware analysis so editor integrations (Calva,
;; CIDER, Cursive) and CI lints share one source of truth.
;;
;; The `re-frame.core` macro shapes (the reg-* family, `defmachine`,
;; `reg-view`, `with-frame` / `with-new-frame`, `with-trace-recorder!`) are
;; not described here: core ships them as a clj-kondo export, imported below.
;;
;; Story's authoring macros (`reg-story` / `reg-variant` / `reg-workspace`
;; / `reg-mode` / `reg-story-panel` / `reg-decorator` / `reg-tag`)
;; follow the core registration shape and get lint-as'd here.
{;; Core and Fresco each ship a clj-kondo export from the artefact, macro
 ;; shapes only:
 ;;   - `implementation/core/resources/clj-kondo.exports/day8/re-frame2/` —
 ;;     the `re-frame.core` reg-* family as `do`, `defmachine` as `def`, and
 ;;     hooks giving `reg-view`, `with-frame`, `with-new-frame` and
 ;;     `re-frame.test-support/with-trace-recorder!` their `defn` / `do` /
 ;;     `let` shapes;
 ;;   - `implementation/fresco/resources/clj-kondo.exports/day8/re-frame2-fresco/`
 ;;     — `defview`, `event` and `defhost` rewritten to their `defn` / `fn` /
 ;;     `def` shapes.
 ;; Pointing `:config-paths` at them makes this repo each export's FIRST
 ;; CONSUMER rather than a second, divergent description of the same macros:
 ;; without core's, every `reg-view` body in the tree reads `dispatch` /
 ;; `subscribe` as unresolved; without Fresco's (the `:lint-as` entries below
 ;; cover only the bench spelling, `re-frame.bench.fresco.arm1.lang/*`), every
 ;; view name and every destructured prop under `implementation/fresco/` does.
 ;; It also means the required `clj-kondo` job is what proves both exports
 ;; load and stay quiet on real code.
 ;; Relative to THIS directory, per clj-kondo's `:config-paths` contract.
 :config-paths
 ["../implementation/core/resources/clj-kondo.exports/day8/re-frame2"
  "../implementation/fresco/resources/clj-kondo.exports/day8/re-frame2-fresco"]

 :linters
 {:unresolved-symbol {:level :warning}
  :unused-binding    {:level :warning}
  :unused-referred-var {:level :warning}
  :unused-namespace  {:level :warning}
  :redefined-var     {:level :warning}
  ;; Disabled — core's exported reg-view hook rewrites `(reg-view sym [args]
  ;; body)` to `(defn sym [args] ...)`. When that call sits inside a
  ;; `(testing ...)` block (idiomatic for the per-test view-registration
  ;; pattern in `reg_view_test.clj`, the adapter view-tests, and the SSR
  ;; streaming tests) the rewritten `defn` reads as `inline-def`. The
  ;; signal/noise on `inline-def` is dominated by the rewrite; turning
  ;; the linter off avoids hand-decorating every test call site.
  :inline-def        {:level :off}
  ;; Disabled — the reg-* registration macros are `:lint-as
  ;; clojure.core/do` so calls inside `(defn install! ...)` don't trip
  ;; `inline-def` (see the rationale on core's export `:lint-as` block).
  ;; That choice yields `redundant do` false positives at every reg-*
  ;; call site (a single-form `do`), so we silence it project-wide.
  ;; There is no production-pattern in re-frame2 codebase where
  ;; `redundant-do` is high signal — the warning's intended target is
  ;; "(do (single-expr))" which is harmless either way.
  :redundant-do      {:level :off}

  ;; `:unresolved-var` exclusions for Story's registration macros, by
  ;; qualified symbol, so editor integrations and CI agree. Core's own
  ;; exclusions ship in its export.
  :unresolved-var
  {:level :warning
   :exclude [re-frame.story/reg-story
             re-frame.story/reg-variant
             re-frame.story/reg-workspace
             re-frame.story/reg-mode
             re-frame.story/reg-story-panel
             re-frame.story/reg-decorator
             re-frame.story/reg-tag]}}

 :lint-as
 {;; Fresco Arm 1's `defview` is
  ;; `(defview sym [doc] [props] body+)` — a `defn`-shaped wrapper that
  ;; introduces a Var holding the React function component the runtime
  ;; minted. `clojure.core/defn` is the right shape: the name resolves as
  ;; a Var, the optional docstring is accepted, and the props vector gets
  ;; ordinary lexical-binding analysis so a destructured key is neither
  ;; unresolved nor unused. It lives in the bench tree (HD-017), so this
  ;; entry belongs to that arm and goes with it.
  re-frame.bench.fresco.arm1.lang/defview clojure.core/defn

  ;; Fresco's one callback form (HD-024). `(hfn [e] body+)`
  ;; expands to `(intent/callback (fn [e] body+))` and nothing else, so
  ;; `clojure.core/fn` is exactly its shape: the argument vector gets
  ;; ordinary lexical-binding analysis, which is what stops every `hfn`
  ;; parameter reading as an unresolved symbol. Goes with the arm, as
  ;; `defview` above does.
  re-frame.bench.fresco.arm1.lang/hfn     clojure.core/fn

  ;; Fresco's interop door (HD-011). `(defhost sym [doc]
  ;; component [opts])` introduces a Var holding the head `mint-host!`
  ;; minted, so `clojure.core/def` is its shape — the name resolves as a
  ;; Var, the optional docstring is accepted, and the component and opts
  ;; expressions are analysed as ordinary body forms. Not `defn`: a host
  ;; declares no parameter vector, since the props it accepts are the
  ;; foreign component's business rather than the declaration's. Goes
  ;; with the arm, as `defview` above does.
  re-frame.bench.fresco.arm1.lang/defhost clojure.core/def

  ;; Story authoring macros — `(reg-foo :id metadata)` is a registration
  ;; call, same shape as the core reg-* family. Same `do`-shape lint-as
  ;; rationale.
  re-frame.story/reg-story         clojure.core/do
  re-frame.story/reg-variant       clojure.core/do
  re-frame.story/reg-workspace     clojure.core/do
  re-frame.story/reg-mode          clojure.core/do
  re-frame.story/reg-story-panel   clojure.core/do
  re-frame.story/reg-decorator     clojure.core/do
  re-frame.story/reg-tag           clojure.core/do


  ;; UIx authoring — `defui` from `uix.core` is also `defn`-shaped.
  uix.core/defui                    clojure.core/defn}

 ;; `tools/template/resources/` ships deps-new template `.cljs` files
 ;; whose `{{placeholder}}` substitutions are not valid Clojure (see
 ;; `tools/deps.edn` → "Why template is NOT in the base :deps map" for
 ;; the matching shadow-cljs exclusion). The CI workflow's `--lint`
 ;; paths skip that directory; this filter is the belt-and-braces for
 ;; editor integrations and ad-hoc local runs that pass the broader
 ;; `tools/` path.
 ;; `tools/xray/design-reference/` holds the authoritative Figma-derived
 ;; L&F reference (a hiccup/reagent mockup, `xray_devtools_reference.cljs`).
 ;; It is a reference artefact — NOT on any shadow-cljs source path, never
 ;; compiled or wired into a build. Exclude it from clj-kondo so the mockup's
 ;; illustrative ns/shape doesn't gate production lint.
 ;; `implementation/fresco/lint-fixtures/` holds the macro-shape smoke fixture
 ;; for the Fresco lint export, linted by the export's own gate
 ;; (`check_lint_export.py`) with the SHIPPED config as `--config-dir` — a
 ;; consumer's view of the export, not this repo's. It carries a deliberate
 ;; sentinel finding, so linting it here would be a second, disagreeing reading
 ;; of one file. The directory sits beside `src/` and `test/` rather than
 ;; inside either, so nothing compiles it; this keeps the linter off it too.
 :output {:exclude-files ["tools/template/resources/"
                          ;; separator-agnostic (matches both / and \ paths)
                          "design-reference"
                          "lint-fixtures"]}}
